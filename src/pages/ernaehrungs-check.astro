// ── Scoring logic ─────────────────────────────────────────────────────────────

function getRisk(score: number): Risk {
  if (score >= 7) return 'hoch';
  if (score >= 4) return 'mittel';
  return 'niedrig';
}

function riskStyle(risk: Risk) {
  if (risk === 'hoch')   return { bar: 'bg-red-400', badge: 'bg-red-100 text-red-800', label: 'Hohes Risiko' };
  if (risk === 'mittel') return { bar: 'bg-amber-400', badge: 'bg-amber-100 text-amber-800', label: 'Mögliche Lücke' };
  return { bar: 'bg-emerald-400', badge: 'bg-emerald-100 text-emerald-700', label: 'Gut versorgt' };
}

function computeScores(answers: Record<string, string>): NutrientResult[] {
  const totals: Record<Nutrient, number> = {
    vitaminD: 5, omega3: 5, magnesium: 5, eisen: 4, zink: 4, b12: 3,
    kreatin: 4, vitaminK2: 6, jod: 5, selen: 5, folat: 4, vitaminB6: 3,
    coq10: 4, cholin: 6, calcium: 4, kupfer: 3, lutein: 5, taurin: 4, glycin: 5,
  };

  for (const [qid, val] of Object.entries(answers)) {
    const qMap = SCORING[qid]?.[val];
    if (!qMap) continue;
    for (const [nutrient, delta] of Object.entries(qMap) as [Nutrient, number][]) {
      totals[nutrient] = Math.min(10, Math.max(0, totals[nutrient] + delta));
    }
  }

  return (Object.entries(totals) as [Nutrient, number][])
    .map(([id, score]) => {
      const def = NUTRIENTS[id];
      const risk = getRisk(score);
      return { id, name: def.name, slug: def.slug, score, risk,
        headline: def.headlines[risk],
        explanation: def.explanations[risk],
        foods: def.foods,
        supplementNote: def.supplementNote,
      };
    })
    .sort((a, b) => b.score - a.score);
}

// ── UI ────────────────────────────────────────────────────────────────────────

const form = document.getElementById('check-form') as HTMLFormElement;
const resultsEl = document.getElementById('results')!;
const ctaHint = document.getElementById('cta-hint')!;
const resultCards = document.getElementById('result-cards')!;
const radarEl = document.getElementById('radar-chart')!;
const progressBar = document.getElementById('progress-bar') as HTMLElement;
const progressLabel = document.getElementById('progress-label')!;
const progressPct = document.getElementById('progress-pct')!;

const TOTAL_QUESTIONS = 15;

function getAnswers(): Record<string, string> {
  const data = new FormData(form);
  const out: Record<string, string> = {};
  for (let i = 1; i <= TOTAL_QUESTIONS; i++) {
    const val = data.get(`q${i}`);
    if (val) out[`q${i}`] = val as string;
  }
  return out;
}

function renderRadar(results: NutrientResult[]) {
  const radarResults = [...results].sort((a, b) => a.name.localeCompare(b.name, 'de'));
  const size = 400;
  const center = size / 2;
  const radius = 130;
  const levels = 5;

  const pointAt = (index: number, value: number) => {
    const angle = (-Math.PI / 2) + (index / radarResults.length) * Math.PI * 2;
    const scaled = (value / 10) * radius;
    return {
      x: center + Math.cos(angle) * scaled,
      y: center + Math.sin(angle) * scaled,
    };
  };

  const polygonPoints = radarResults
    .map((r, i) => {
      const p = pointAt(i, r.score);
      return `${p.x},${p.y}`;
    })
    .join(' ');

  const gridPolygons = Array.from({ length: levels }, (_, idx) => {
    const factor = (idx + 1) / levels;
    const points = radarResults
      .map((_, i) => {
        const p = pointAt(i, factor * 10);
        return `${p.x},${p.y}`;
      })
      .join(' ');
    return `<polygon points="${points}" fill="none" stroke="#cbd5e1" stroke-width="1" />`;
  }).join('');

  const axes = radarResults.map((_, i) => {
    const p = pointAt(i, 10);
    return `<line x1="${center}" y1="${center}" x2="${p.x}" y2="${p.y}" stroke="#cbd5e1" stroke-width="1" />`;
  }).join('');

  const labels = radarResults.map((r, i) => {
    const p = pointAt(i, 13.5);
    const anchor = Math.abs(p.x - center) < 14 ? 'middle' : p.x < center ? 'end' : 'start';
    return `<text x="${p.x}" y="${p.y}" text-anchor="${anchor}" dominant-baseline="middle" fill="#475569" font-size="10" font-weight="500">${r.name}</text>`;
  }).join('');

  const points = radarResults.map((r, i) => {
    const p = pointAt(i, r.score);
    return `<circle cx="${p.x}" cy="${p.y}" r="3.5" fill="#0f766e" stroke="#ffffff" stroke-width="2"><title>${r.name}: ${r.score}/10</title></circle>`;
  }).join('');

  radarEl.innerHTML = `
    <div class="flex justify-center">
      <svg viewBox="0 0 ${size} ${size}" class="w-full max-w-[480px] h-auto overflow-visible" role="img" aria-label="Radar Chart des Risikoprofils">
        ${gridPolygons}
        ${axes}
        <polygon points="${polygonPoints}" fill="rgba(13, 148, 136, 0.18)" stroke="#0f766e" stroke-width="2.5" />
        ${points}
        ${labels}
      </svg>
    </div>
  `;
}

function getReason(id: Nutrient, answers: Record<string, string>): string {
  const q = answers;
  switch (id) {
    case 'vitaminD':
      if (q.q4 === 'kaum') return 'weil kaum Sonnenexposition angegeben wurde';
      if (q.q4 === 'wenig') return 'weil wenig Sonnenexposition angegeben wurde';
      return 'aufgrund deines Lebensstils';
    case 'omega3':
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'weil pflanzliche Ernährung kaum EPA/DHA enthält';
      if (q.q2 === 'nie') return 'weil kein Fisch konsumiert wird';
      if (q.q2 === 'selten') return 'weil Fisch selten konsumiert wird';
      return 'aufgrund deiner Ernährungsweise';
    case 'magnesium':
      if (q.q6 === 'nie' && q.q9 === 'hoch') return 'weil wenig Magnesiumquellen + hoher Sport/Stress';
      if (q.q6 === 'nie') return 'weil wenig Nüsse, Samen oder Hülsenfrüchte gegessen werden';
      if (q.q9 === 'hoch') return 'weil Sport und Stress den Bedarf erhöhen';
      return 'aufgrund deiner Angaben';
    case 'eisen':
      if (q.q7 === 'frau-mens' && (q.q1 === 'vegan' || q.q1 === 'vegetarisch')) return 'weil Menstruation + pflanzliche Ernährung das Risiko stark erhöhen';
      if (q.q7 === 'frau-mens') return 'weil menstruelle Blutverluste den Eisenbedarf erhöhen';
      if (q.q3 === 'nie') return 'weil kein Häm-Eisen aus Fleisch aufgenommen wird';
      return 'aufgrund deiner Angaben';
    case 'zink':
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'weil pflanzliches Zink schlechter aufgenommen wird';
      return 'aufgrund deiner Ernährungsweise';
    case 'b12':
      if (q.q1 === 'vegan') return 'weil vegane Ernährung kein B12 enthält';
      if (q.q1 === 'vegetarisch') return 'weil vegetarische Ernährung wenig B12 liefert';
      if (q.q10 === 'ja') return 'weil Magensäureblocker die B12-Aufnahme hemmen';
      if (q.q8 === 'ue65') return 'weil die Aufnahme im Alter abnimmt';
      return 'aufgrund deiner Angaben';
    case 'kreatin':
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'weil pflanzliche Ernährung kein Kreatin enthält';
      if (q.q3 === 'nie') return 'weil kein rotes Fleisch gegessen wird';
      return 'aufgrund deiner Ernährungsweise';
    case 'vitaminK2':
      if (q.q12 === 'selten' || q.q12 === 'nie') return 'weil wenig fermentierte oder gereifte Produkte gegessen werden';
      return 'aufgrund deiner Ernährungsweise';
    case 'jod':
      if (q.q13 === 'meersalz') return 'weil Meersalz kein Jod enthält';
      return 'aufgrund deiner Salzwahl';
    case 'selen':
      if (q.q1 === 'vegan') return 'weil pflanzliche Ernährung wenig Selen liefert';
      return 'aufgrund deiner Ernährungsweise';
    case 'folat':
      if (q.q5 === 'selten') return 'weil wenig dunkelgrünes Gemüse gegessen wird';
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'aufgrund pflanzlicher Ernährung ohne tierische Folatquellen';
      return 'aufgrund deiner Ernährungsweise';
    case 'vitaminB6':
      if (q.q1 === 'vegan') return 'weil pflanzliche Quellen weniger B6 liefern';
      return 'aufgrund deiner Ernährungsweise';
    case 'coq10':
      if (q.q15 === 'ja') return 'weil Statine CoQ10 im Körper verringern';
      if (q.q8 === 'ue65' || q.q8 === '51-65') return 'weil CoQ10 mit dem Alter abnimmt';
      return 'aufgrund deines Alters oder Medikamente';
    case 'cholin':
      if (q.q11 === 'selten' || q.q11 === 'nie') return 'weil wenig Eier gegessen werden (Hauptquelle für Cholin)';
      if (q.q1 === 'vegan') return 'weil vegane Ernährung sehr wenig Cholin enthält';
      return 'aufgrund deiner Ernährungsweise';
    case 'calcium':
      if (q.q1 === 'vegan') return 'weil tierische Calciumquellen fehlen';
      return 'aufgrund deiner Ernährungsweise';
    case 'kupfer':
      return 'aufgrund deiner Ernährungsweise';
    case 'lutein':
      if (q.q11 === 'selten' || q.q11 === 'nie') return 'weil wenig Eier gegessen werden';
      if (q.q5 === 'selten') return 'weil wenig grünes Gemüse konsumiert wird';
      return 'aufgrund deiner Ernährungsweise';
    case 'taurin':
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'weil Taurin fast nur in Fleisch und Fisch vorkommt';
      return 'aufgrund deiner Ernährungsweise';
    case 'glycin':
      if (q.q14 === 'nie') return 'weil kollagenreiche Lebensmittel selten gegessen werden';
      return 'aufgrund deiner Ernährungsweise';
    default:
      return 'aufgrund deiner Angaben';
  }
}

function renderResults(answers: Record<string, string>) {
  const results = computeScores(answers);
  resultCards.innerHTML = '';
  renderRadar(results);

  const make = (tag: string, className?: string, text?: string) => {
    const el = document.createElement(tag);
    if (className) el.className = className;
    if (text !== undefined) el.textContent = text;
    return el;
  };

  results.forEach((r, idx) => {
    const { bar, badge, label } = riskStyle(r.risk);
    const isTop3 = idx < 3;
    const card = make('div', `bg-white border rounded-xl overflow-hidden ${r.risk === 'hoch' ? 'border-red-200' : r.risk === 'mittel' ? 'border-amber-200' : 'border-slate-200'}`);
    const wrapper = make('div', 'p-5');
    card.appendChild(wrapper);

    const header = make('div', 'flex items-start justify-between gap-3 mb-3');
    const left = make('div');
    const name = make('p', 'font-semibold text-slate-900', r.name);
    const headline = make('p', 'text-sm font-medium text-slate-600 mt-0.5', r.headline.replace(r.name + ' — ', ''));
    left.append(name, headline);

    const badgeEl = make('span', `shrink-0 text-xs font-semibold rounded-full px-2.5 py-1 ${badge}`, label);
    header.append(left, badgeEl);
    wrapper.appendChild(header);

    const barWrap = make('div', 'h-1.5 bg-slate-100 rounded-full mb-4 overflow-hidden');
    const barEl = make('div', `h-full rounded-full ${bar}`);
    barEl.style.width = `${r.score * 10}%`;
    barWrap.appendChild(barEl);
    wrapper.appendChild(barWrap);

    if (r.risk === 'hoch' || r.risk === 'mittel') {
      const reasonEl = make('p', 'text-sm text-slate-400 italic mb-3', `Geschätztes Risiko — ${getReason(r.id, answers)}`);
      wrapper.appendChild(reasonEl);
    }

    wrapper.appendChild(make('p', 'text-sm text-slate-600 mb-4', r.explanation));

    if (isTop3) {
      const details = make('details', 'text-sm mb-4');
      const summary = make('summary', 'cursor-pointer text-slate-600 hover:text-slate-800 list-none flex items-center gap-1');
      summary.append(
        make('span', undefined, 'Lebensmittel & Supplement-Hinweise'),
        make('span', 'text-xs text-slate-400', '↓')
      );
      details.appendChild(summary);

      const detailsBody = make('div', 'mt-3 space-y-3 border-t border-slate-100 pt-3');
      const foodsBlock = make('div');
      foodsBlock.appendChild(make('p', 'text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5', 'Lebensmittel'));

      const foodsList = make('ul', 'space-y-1');
      r.foods.forEach((f) => {
        const li = make('li', 'flex items-start gap-1.5');
        li.append(make('span', 'text-teal-500 mt-0.5', '•'), document.createTextNode(f));
        foodsList.appendChild(li);
      });
      foodsBlock.appendChild(foodsList);

      const supplementBlock = make('div', 'bg-slate-50 rounded-lg p-3');
      supplementBlock.appendChild(make('p', 'text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1', 'Supplement-Hinweis'));
      supplementBlock.appendChild(make('p', 'text-slate-600', r.supplementNote));

      detailsBody.append(foodsBlock, supplementBlock);
      details.appendChild(detailsBody);
      wrapper.appendChild(details);
    }

    if (r.slug) {
      const link = make('a', 'inline-flex items-center gap-1.5 text-sm font-medium text-teal-700 bg-teal-50 hover:bg-teal-100 border border-teal-200 rounded-lg px-3 py-2 no-underline transition-colors', 'Wirkstoff-Dossier lesen →');
      link.setAttribute('href', `/wirkstoffe/${r.slug}`);
      wrapper.appendChild(link);
    }

    resultCards.appendChild(card);
  });

  // GKV section
  const gkvSection = document.getElementById('gkv-section') as HTMLElement;
  const gkvCards = document.getElementById('gkv-cards') as HTMLElement;
  if (gkvSection && gkvCards) {
    const relevantTests = results
      .filter(r => r.score >= 5 && GKV_TESTS[r.id as Nutrient])
      .map(r => ({ ...GKV_TESTS[r.id as Nutrient]!, nutrientName: r.name }));

    if (relevantTests.length > 0) {
      gkvCards.innerHTML = relevantTests.map(t => {
        const statusColor = t.gkvStatus === 'covered'
          ? 'text-emerald-700 bg-emerald-50'
          : t.gkvStatus === 'conditional'
          ? 'text-amber-700 bg-amber-50'
          : 'text-slate-600 bg-slate-50';
        const statusLabel = t.gkvStatus === 'covered'
          ? '✅ Kassenleistung möglich'
          : t.gkvStatus === 'conditional'
          ? '⚡ Situationsabhängig'
          : '💶 IGeL / Selbstzahler';
        return `<div class="px-5 py-4">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div>
              <p class="font-medium text-slate-800 text-sm">${t.testName}</p>
              <p class="text-xs text-slate-500 mt-0.5">für: ${t.nutrientName}</p>
            </div>
            <span class="shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full ${statusColor}">${statusLabel}</span>
          </div>
          <p class="text-sm text-slate-600">${t.gkvNote}</p>
          ${t.igelCost ? `<p class="text-xs text-slate-400 mt-1">Selbstzahler: ca. ${t.igelCost}</p>` : ''}
        </div>`;
      }).join('');
      gkvSection.classList.remove('hidden');
    } else {
      gkvSection.classList.add('hidden');
    }
  }
}

function update() {
  const answers = getAnswers();
  const count = Object.keys(answers).length;

  // Update progress
  const pct = Math.round((count / TOTAL_QUESTIONS) * 100);
  progressBar.style.width = `${pct}%`;
  progressLabel.textContent = `${count} von ${TOTAL_QUESTIONS} beantwortet`;
  progressPct.textContent = `${pct}%`;

  if (count < TOTAL_QUESTIONS) {
    resultsEl.classList.add('hidden');
    ctaHint.classList.remove('hidden');
    document.querySelectorAll('fieldset.question').forEach(fs => {
      const answered = !!(fs as HTMLFieldSetElement).querySelector('input[type=radio]:checked');
      if (answered) {
        fs.classList.remove('border-yellow-400', 'ring-2', 'ring-yellow-200');
      } else {
        fs.classList.add('border-yellow-400', 'ring-2', 'ring-yellow-200');
      }
    });
    return;
  }

  ctaHint.classList.add('hidden');
  document.querySelectorAll('fieldset.question').forEach(fs => {
    fs.classList.remove('border-yellow-400', 'ring-2', 'ring-yellow-200');
  });
  resultsEl.classList.remove('hidden');
  renderResults(answers);

  // Smooth scroll to results
  resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

form.addEventListener('change', update);

document.getElementById("goto-next")?.addEventListener("click", () => {
  const unanswered = Array.from(document.querySelectorAll("fieldset.question")).find(
    fs => !fs.querySelector("input[type=radio]:checked")
  );
  if (unanswered) {
    unanswered.scrollIntoView({ behavior: "smooth", block: "center" });
    (unanswered.querySelector("input[type=radio]") as HTMLInputElement)?.focus();
  }
});
