---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalNotice from '../components/LegalNotice.astro';
---

<BaseLayout
  title="Ernährungs-Check"
  description="Finde heraus welche Mikronährstoffe dir wahrscheinlich fehlen — basierend auf deiner Ernährung und deinem Lebensstil. Kostenlos, evidenzbasiert, in 90 Sekunden."
>
  <div class="max-w-2xl mx-auto px-4 py-12">

    <div class="mb-6">
      <h1 class="text-3xl font-bold text-slate-900 mb-3">Ernährungs-Check</h1>
      <p class="text-slate-600">
        15 Fragen, ca. 90 Sekunden. Wir schätzen, bei welchen Mikronährstoffen
        ein erhöhtes Risiko für eine unzureichende Versorgung bestehen könnte — als Hinweis, keine Diagnose.
      </p>
    </div>

    <div class="mb-10">
      <LegalNotice>
        Der Ernährungs-Check ist ein vereinfachtes Informations-Tool und keine medizinische Diagnostik. Die Ergebnisse sind Näherungen auf Basis deiner Angaben und ersetzen keine Laborwerte, ärztliche Beratung oder individuelle Therapieempfehlung. <strong>Deine Antworten werden nur lokal im Browser verarbeitet, nicht personenbezogen gespeichert und nicht an uns übermittelt.</strong>
      </LegalNotice>
    </div>

    <!-- Privacy Badge -->
    <div class="flex items-center gap-2 text-sm text-slate-500 bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 mb-6">
      <span class="text-base">🔒</span>
      <span>Deine Antworten bleiben <strong>lokal im Browser</strong> und werden nicht an MikroScore übermittelt.</span>
    </div>

    <!-- Questions -->
    <form id="check-form" class="space-y-8">

      <!-- Q1 -->
      <fieldset class="question" data-qid="1">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          1. Wie würdest du deine Ernährung beschreiben?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q1" value="omnivor" class="option-input" /><span>Omnivor — ich esse alles inkl. Fleisch und Fisch</span></label>
          <label class="option-label"><input type="radio" name="q1" value="pescetarisch" class="option-input" /><span>Pescetarisch — kein Fleisch, aber Fisch</span></label>
          <label class="option-label"><input type="radio" name="q1" value="vegetarisch" class="option-input" /><span>Vegetarisch — kein Fleisch, kein Fisch</span></label>
          <label class="option-label"><input type="radio" name="q1" value="vegan" class="option-input" /><span>Vegan — keine tierischen Produkte</span></label>
        </div>
      </fieldset>

      <!-- Q2 -->
      <fieldset class="question" data-qid="2">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          2. Wie oft isst du fetten Fisch? (Lachs, Makrele, Hering, Sardinen)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q2" value="2plus" class="option-input" /><span>2x pro Woche oder mehr</span></label>
          <label class="option-label"><input type="radio" name="q2" value="1pw" class="option-input" /><span>Ca. 1x pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q2" value="selten" class="option-input" /><span>1–3x pro Monat</span></label>
          <label class="option-label"><input type="radio" name="q2" value="nie" class="option-input" /><span>Selten oder nie</span></label>
        </div>
      </fieldset>

      <!-- Q3 -->
      <fieldset class="question" data-qid="3">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          3. Wie oft isst du rotes Fleisch? (Rind, Lamm, Schwein)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q3" value="3plus" class="option-input" /><span>3x pro Woche oder mehr</span></label>
          <label class="option-label"><input type="radio" name="q3" value="1-2pw" class="option-input" /><span>1–2x pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q3" value="selten" class="option-input" /><span>Selten (1–3x pro Monat)</span></label>
          <label class="option-label"><input type="radio" name="q3" value="nie" class="option-input" /><span>Nie</span></label>
        </div>
      </fieldset>

      <!-- Q4 -->
      <fieldset class="question" data-qid="4">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          4. Wie viel Zeit verbringst du täglich draußen mit unbedeckter Haut?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">Gesicht + Arme frei, von April bis September</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q4" value="viel" class="option-input" /><span>Mehr als 30 Minuten täglich</span></label>
          <label class="option-label"><input type="radio" name="q4" value="mittel" class="option-input" /><span>15–30 Minuten täglich</span></label>
          <label class="option-label"><input type="radio" name="q4" value="wenig" class="option-input" /><span>Weniger als 15 Minuten</span></label>
          <label class="option-label"><input type="radio" name="q4" value="kaum" class="option-input" /><span>Kaum — ich bin meist drinnen oder vollständig bedeckt</span></label>
        </div>
      </fieldset>

      <!-- Q5 -->
      <fieldset class="question" data-qid="5">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          5. Wie oft isst du dunkelgrünes Gemüse? (Spinat, Brokkoli, Grünkohl, Mangold)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q5" value="taeglich" class="option-input" /><span>Täglich</span></label>
          <label class="option-label"><input type="radio" name="q5" value="3-4pw" class="option-input" /><span>3–4x pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q5" value="1-2pw" class="option-input" /><span>1–2x pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q5" value="selten" class="option-input" /><span>Selten</span></label>
        </div>
      </fieldset>

      <!-- Q6 -->
      <fieldset class="question" data-qid="6">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          6. Wie oft isst du Nüsse, Samen oder Hülsenfrüchte?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">z.B. Mandeln, Kürbiskerne, Bohnen, Linsen</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q6" value="taeglich" class="option-input" /><span>Täglich</span></label>
          <label class="option-label"><input type="radio" name="q6" value="mehrpw" class="option-input" /><span>Mehrmals pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q6" value="selten" class="option-input" /><span>Selten</span></label>
          <label class="option-label"><input type="radio" name="q6" value="nie" class="option-input" /><span>Nie</span></label>
        </div>
      </fieldset>

      <!-- Q7 -->
      <fieldset class="question" data-qid="7">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          7. Was trifft auf dich zu?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q7" value="mann" class="option-input" /><span>Männlich</span></label>
          <label class="option-label"><input type="radio" name="q7" value="frau-mens" class="option-input" /><span>Weiblich — mit Menstruation</span></label>
          <label class="option-label"><input type="radio" name="q7" value="frau-keine" class="option-input" /><span>Weiblich — ohne Menstruation (Menopause oder andere)</span></label>
        </div>
      </fieldset>

      <!-- Q8 -->
      <fieldset class="question" data-qid="8">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          8. Wie alt bist du?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q8" value="u30" class="option-input" /><span>Unter 30</span></label>
          <label class="option-label"><input type="radio" name="q8" value="30-50" class="option-input" /><span>30–50</span></label>
          <label class="option-label"><input type="radio" name="q8" value="51-65" class="option-input" /><span>51–65</span></label>
          <label class="option-label"><input type="radio" name="q8" value="ue65" class="option-input" /><span>Über 65</span></label>
        </div>
      </fieldset>

      <!-- Q9 -->
      <fieldset class="question" data-qid="9">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          9. Wie würdest du dein Aktivitätsniveau und deinen Stresslevel beschreiben?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q9" value="hoch" class="option-input" /><span>Viel Sport (&gt;4h/Woche) und/oder dauerhaft hoher Stress</span></label>
          <label class="option-label"><input type="radio" name="q9" value="mittel" class="option-input" /><span>Moderate Aktivität, normaler Alltagsstress</span></label>
          <label class="option-label"><input type="radio" name="q9" value="niedrig" class="option-input" /><span>Wenig Bewegung, wenig Stress</span></label>
        </div>
      </fieldset>

      <!-- Q10 -->
      <fieldset class="question" data-qid="10">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          10. Nimmst du regelmäßig Magensäureblocker? (z.B. Omeprazol, Pantoprazol)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q10" value="nein" class="option-input" /><span>Nein</span></label>
          <label class="option-label"><input type="radio" name="q10" value="ja" class="option-input" /><span>Ja, regelmäßig</span></label>
        </div>
      </fieldset>

      <!-- Q11 -->
      <fieldset class="question" data-qid="11">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          11. Isst du regelmäßig Eier?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q11" value="taeglich" class="option-input" /><span>Täglich</span></label>
          <label class="option-label"><input type="radio" name="q11" value="mehrpw" class="option-input" /><span>Mehrmals pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q11" value="selten" class="option-input" /><span>Selten (1–3x pro Monat)</span></label>
          <label class="option-label"><input type="radio" name="q11" value="nie" class="option-input" /><span>Nie</span></label>
        </div>
      </fieldset>

      <!-- Q12 -->
      <fieldset class="question" data-qid="12">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          12. Wie oft isst du fermentierte oder gereifte Lebensmittel?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">z.B. Natto, Hartkäse (Gouda, Emmentaler), Kefir, Kimchi</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q12" value="taeglich" class="option-input" /><span>Täglich (inkl. Käse oder Kefir)</span></label>
          <label class="option-label"><input type="radio" name="q12" value="mehrpw" class="option-input" /><span>Mehrmals pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q12" value="gelegentlich" class="option-input" /><span>Gelegentlich</span></label>
          <label class="option-label"><input type="radio" name="q12" value="selten" class="option-input" /><span>Selten oder nie</span></label>
        </div>
      </fieldset>

      <!-- Q13 -->
      <fieldset class="question" data-qid="13">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          13. Welches Salz verwendest du hauptsächlich?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q13" value="jodiert" class="option-input" /><span>Jodiertes Speisesalz</span></label>
          <label class="option-label"><input type="radio" name="q13" value="meersalz" class="option-input" /><span>Meersalz, Himalayasalz oder anderes nicht-jodiertes Salz</span></label>
          <label class="option-label"><input type="radio" name="q13" value="kein" class="option-input" /><span>Ich verwende kaum Salz</span></label>
        </div>
      </fieldset>

      <!-- Q14 -->
      <fieldset class="question" data-qid="14">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          14. Isst du regelmäßig Innereien oder Knochenbrühe?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">z.B. Leber, Nieren, Herz, selbstgekochte Knochenbrühe</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q14" value="regelmaessig" class="option-input" /><span>Ja, mindestens 1x pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q14" value="selten" class="option-input" /><span>Selten (1–3x pro Monat)</span></label>
          <label class="option-label"><input type="radio" name="q14" value="nie" class="option-input" /><span>Nie</span></label>
        </div>
      </fieldset>

      <!-- Q15 -->
      <fieldset class="question" data-qid="15">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          15. Nimmst du Statine? (Cholesterin-Medikament, z.B. Atorvastatin, Simvastatin)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q15" value="nein" class="option-input" /><span>Nein</span></label>
          <label class="option-label"><input type="radio" name="q15" value="ja" class="option-input" /><span>Ja, regelmäßig</span></label>
        </div>
      </fieldset>

    </form>

    <!-- Progress indicator -->
    <div class="mt-8 mb-4">
      <div class="flex justify-between text-xs text-slate-500 mb-1">
        <span id="progress-label" aria-live="polite">0 von 15 beantwortet</span>
        <span id="progress-pct">0%</span>
      </div>
      <div class="h-1.5 bg-slate-200 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-teal-500 rounded-full transition-all duration-300" style="width:0%"></div>
      </div>
    </div>

    <!-- CTA -->
    <div id="cta-hint" class="hidden">
      <button id="goto-next" type="button" class="w-full text-sm font-medium text-teal-700 bg-teal-50 border border-teal-200 rounded-lg px-4 py-2.5 hover:bg-teal-100 transition-colors">
        Zur nächsten unbeantworteten Frage ↓
      </button>
    </div>

    <!-- Results -->
    <div id="results" class="hidden mt-2">
      <div class="border-t-2 border-teal-200 pt-8">
        <h2 class="text-xl font-semibold text-slate-800 mb-2">Dein Ergebnis</h2>
        <p class="text-sm text-slate-500 mb-6">
          Schätzung auf Basis deiner Angaben — kein Ersatz für einen Bluttest. 🔒 Lokal berechnet, nichts übertragen.
        </p>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 md:p-6 mb-6">
          <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
            <div>
              <p class="text-sm font-semibold text-slate-800">Dein Risikoprofil</p>
              <p class="text-xs text-slate-500 mt-1">Je weiter außen, desto höher das geschätzte Risiko auf Basis deiner Antworten.</p>
            </div>
            <span class="text-xs font-medium text-slate-400">Skala 0–10</span>
          </div>
          <div id="radar-chart" class="mb-4"></div>
          <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-4 text-xs text-slate-600 leading-6">
            Dieser Schnell-Check erfasst 20 häufig unterschätzte Mikronährstoffe und Supplements: von Vitamin D, Omega-3 und Magnesium bis hin zu Kreatin, Cholin, Vitamin K2, Glycin und weiteren. Eine vollständige Ernährungsbewertung umfasst noch viel mehr — etwa Proteinversorgung, essentielle Aminosäuren, Ballaststoffe, Omega-6/3-Verhältnis oder individuelle Unverträglichkeiten. <strong>Betrachte das Ergebnis als ersten Hinweis, nicht als vollständige Analyse.</strong>
          </div>
        </div>

        <div id="result-cards" class="space-y-4"></div>

        <!-- GKV Blood Tests -->
        <div id="gkv-section" class="hidden mt-8">
          <div class="border border-blue-200 rounded-xl overflow-hidden">
            <div class="bg-blue-50 px-5 py-4 border-b border-blue-200">
              <h3 class="font-semibold text-blue-900">🩸 Bluttests — was zahlt die GKV?</h3>
              <p class="text-sm text-blue-700 mt-1">Basierend auf deinem Risikoprofil — mögliche Kassenleistungen für deine Risikonährstoffe.</p>
            </div>
            <div id="gkv-cards" class="divide-y divide-blue-100"></div>
            <div class="bg-blue-50/50 px-5 py-3 text-xs text-blue-600">
              ⚠️ GKV-Erstattung hängt von Diagnose, Kasse und Arzturteil ab. Diese Übersicht ist eine Orientierung — kein Rechtsanspruch. Im Zweifel vorher mit dem Arzt besprechen.
            </div>
          </div>
        </div>

        <!-- Next steps -->
        <div class="mt-8 bg-teal-50 border border-teal-200 rounded-xl p-6">
          <p class="font-semibold text-teal-900 mb-4">Was jetzt?</p>
          <div class="space-y-3">
            <a href="/wirkstoffe" class="flex items-start gap-3 group no-underline">
              <span class="text-lg mt-0.5">🔬</span>
              <div>
                <p class="text-sm font-medium text-teal-800 group-hover:text-teal-900">Wirkstoff-Dossiers lesen</p>
                <p class="text-xs text-teal-600">Evidenz, Sicherheit und EFSA-Status für jeden Wirkstoff — bevor du kaufst.</p>
              </div>
            </a>
            <a href="/produkte" class="flex items-start gap-3 group no-underline">
              <span class="text-lg mt-0.5">💶</span>
              <div>
                <p class="text-sm font-medium text-teal-800 group-hover:text-teal-900">Produkte vergleichen</p>
                <p class="text-xs text-teal-600">Konkrete Supplements nach Preis/Tagesdosis, Reinheit und Zertifizierung bewertet.</p>
              </div>
            </a>
            <div class="flex items-start gap-3">
              <span class="text-lg mt-0.5">🩸</span>
              <div>
                <p class="text-sm font-medium text-teal-800">Bluttest machen lassen</p>
                <p class="text-xs text-teal-600">Dieser Check ist eine Orientierung — kein Ersatz für einen Bluttest beim Arzt. Ferritin, 25-OH-Vitamin D, Holotranscobalamin.</p>
              </div>
            </div>
          </div>
        </div>

        <p class="mt-6 text-xs text-slate-400 leading-relaxed">
          Dieser Check basiert auf typischen Zusammenhängen zwischen Ernährung und Mikronährstoffversorgung.
          Er stellt keine medizinische Diagnose dar. Für eine genaue Bestimmung empfehlen wir eine Blutuntersuchung beim Arzt.
        </p>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .option-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    font-size: 0.875rem;
    color: #374151;
  }
  .option-label:hover {
    border-color: #99f6e4;
    background: #f0fdf4;
  }
  .option-label:has(input:checked) {
    border-color: #0d9488;
    background: #f0fdfa;
    color: #134e4a;
    font-weight: 500;
  }
  .option-input {
    accent-color: #0d9488;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
</style>

<script>
// ── Scoring model ─────────────────────────────────────────────────────────────
// Each nutrient starts at a baseline. Answers add/subtract risk points.
// Final score 0-10. Thresholds: ≥7 high, 4-6 medium, ≤3 low.

type Nutrient =
  | 'vitaminD' | 'omega3' | 'magnesium' | 'eisen' | 'zink' | 'b12'
  | 'kreatin' | 'vitaminK2' | 'jod' | 'selen' | 'folat' | 'vitaminB6'
  | 'coq10' | 'cholin' | 'calcium' | 'kupfer' | 'lutein' | 'taurin' | 'glycin';

type Risk = 'hoch' | 'mittel' | 'niedrig';

interface NutrientResult {
  id: Nutrient;
  name: string;
  slug: string;
  score: number;
  risk: Risk;
  headline: string;
  explanation: string;
  foods: string[];
  supplementNote: string;
}

interface GkvTest {
  testName: string;
  gkvStatus: 'covered' | 'conditional' | 'igel';
  gkvNote: string;
  igelCost: string | null;
  selfPayNote: string | null;
}

const GKV_TESTS: Partial<Record<Nutrient, GkvTest>> = {
  eisen:    { testName: 'Ferritin (Eisenspeicher)', gkvStatus: 'covered', gkvNote: 'Bei Symptomen wie Müdigkeit, Haarausfall oder Blässe — Arzt ansprechen', igelCost: null, selfPayNote: null },
  b12:      { testName: 'Vitamin B12 (Holotranscobalamin)', gkvStatus: 'conditional', gkvNote: 'Bei veganer Ernährung, Magensäureblockern oder Alter >60 meist erstattungsfähig', igelCost: '15–25 €', selfPayNote: 'Als IGeL-Leistung bei vielen Laboren direkt buchbar' },
  vitaminD: { testName: '25-OH-Vitamin D3', gkvStatus: 'igel', gkvNote: 'Standardmäßig keine Kassenleistung — nur bei konkretem Verdacht auf Rachitis/Osteomalazie', igelCost: '20–35 €', selfPayNote: 'Häufigste IGeL-Leistung in Deutschland — lohnt sich bei Risikogruppen' },
  omega3:   { testName: 'Omega-3-Index (EPA+DHA im Vollblut)', gkvStatus: 'igel', gkvNote: 'Keine Kassenleistung', igelCost: '30–50 €', selfPayNote: 'Speziallabore wie Omegametrix oder über Hausarzt buchbar' },
  magnesium:{ testName: 'Magnesium (Serum)', gkvStatus: 'conditional', gkvNote: 'Bei Herzrhythmusstörungen, Muskelkrämpfen oder Nierenproblemen oft erstattungsfähig', igelCost: '10–20 €', selfPayNote: 'Serumwert ist wenig aussagekräftig — Vollblut-Magnesium informativer' },
  zink:     { testName: 'Zink (Serum)', gkvStatus: 'conditional', gkvNote: 'Bei begründetem Verdacht und spezifischen Symptomen möglich', igelCost: '15–25 €', selfPayNote: null },
  selen:    { testName: 'Selen (Vollblut)', gkvStatus: 'conditional', gkvNote: 'Bei Schilddrüsenerkrankungen oder nach Chemotherapie oft erstattungsfähig', igelCost: '20–35 €', selfPayNote: null },
  folat:    { testName: 'Folat (Vitamin B9)', gkvStatus: 'conditional', gkvNote: 'In der Schwangerschaft und bei Kinderwunsch Kassenleistung; sonst IGeL', igelCost: '15–20 €', selfPayNote: null },
