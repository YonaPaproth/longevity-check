---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ernährungs-Check"
  description="Finde heraus welche Mikronährstoffe dir wahrscheinlich fehlen — basierend auf deiner Ernährung und deinem Lebensstil. Kostenlos, evidenzbasiert, in 60 Sekunden."
>
  <div class="max-w-2xl mx-auto px-4 py-12">

    <div class="mb-10">
      <h1 class="text-3xl font-bold text-slate-900 mb-3">Ernährungs-Check</h1>
      <p class="text-slate-600">
        10 Fragen, ca. 60 Sekunden. Wir berechnen auf Basis deiner Antworten,
        bei welchen Mikronährstoffen du wahrscheinlich unterversorgt bist.
      </p>
    </div>

    <!-- Questions -->
    <form id="check-form" class="space-y-8">

      <!-- Q1 -->
      <fieldset class="question" data-qid="1">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          1. Wie würdest du deine Ernährung beschreiben?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q1" value="omnivor" class="option-input" /><span>Omnivor — ich esse alles inkl. Fleisch und Fisch</span></label>
          <label class="option-label"><input type="radio" name="q1" value="pescetarisch" class="option-input" /><span>Pescetarisch — kein Fleisch, aber Fisch</span></label>
          <label class="option-label"><input type="radio" name="q1" value="vegetarisch" class="option-input" /><span>Vegetarisch — kein Fleisch, kein Fisch</span></label>
          <label class="option-label"><input type="radio" name="q1" value="vegan" class="option-input" /><span>Vegan — keine tierischen Produkte</span></label>
        </div>
      </fieldset>

      <!-- Q2 -->
      <fieldset class="question" data-qid="2">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          2. Wie oft isst du fetten Fisch? (Lachs, Makrele, Hering, Sardinen)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q2" value="2plus" class="option-input" /><span>2x pro Woche oder mehr</span></label>
          <label class="option-label"><input type="radio" name="q2" value="1pw" class="option-input" /><span>Ca. 1x pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q2" value="selten" class="option-input" /><span>1–3x pro Monat</span></label>
          <label class="option-label"><input type="radio" name="q2" value="nie" class="option-input" /><span>Selten oder nie</span></label>
        </div>
      </fieldset>

      <!-- Q3 -->
      <fieldset class="question" data-qid="3">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          3. Wie oft isst du rotes Fleisch? (Rind, Lamm, Schwein)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q3" value="3plus" class="option-input" /><span>3x pro Woche oder mehr</span></label>
          <label class="option-label"><input type="radio" name="q3" value="1-2pw" class="option-input" /><span>1–2x pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q3" value="selten" class="option-input" /><span>Selten (1–3x pro Monat)</span></label>
          <label class="option-label"><input type="radio" name="q3" value="nie" class="option-input" /><span>Nie</span></label>
        </div>
      </fieldset>

      <!-- Q4 -->
      <fieldset class="question" data-qid="4">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          4. Wie viel Zeit verbringst du täglich draußen mit unbedeckter Haut?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">Gesicht + Arme frei, von April bis September</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q4" value="viel" class="option-input" /><span>Mehr als 30 Minuten täglich</span></label>
          <label class="option-label"><input type="radio" name="q4" value="mittel" class="option-input" /><span>15–30 Minuten täglich</span></label>
          <label class="option-label"><input type="radio" name="q4" value="wenig" class="option-input" /><span>Weniger als 15 Minuten</span></label>
          <label class="option-label"><input type="radio" name="q4" value="kaum" class="option-input" /><span>Kaum — ich bin meist drinnen oder vollständig bedeckt</span></label>
        </div>
      </fieldset>

      <!-- Q5 -->
      <fieldset class="question" data-qid="5">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          5. Wie oft isst du dunkelgrünes Gemüse? (Spinat, Brokkoli, Grünkohl, Mangold)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q5" value="taeglich" class="option-input" /><span>Täglich</span></label>
          <label class="option-label"><input type="radio" name="q5" value="3-4pw" class="option-input" /><span>3–4x pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q5" value="1-2pw" class="option-input" /><span>1–2x pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q5" value="selten" class="option-input" /><span>Selten</span></label>
        </div>
      </fieldset>

      <!-- Q6 -->
      <fieldset class="question" data-qid="6">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          6. Wie oft isst du Nüsse, Samen oder Hülsenfrüchte?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">z.B. Mandeln, Kürbiskerne, Bohnen, Linsen</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q6" value="taeglich" class="option-input" /><span>Täglich</span></label>
          <label class="option-label"><input type="radio" name="q6" value="mehrpw" class="option-input" /><span>Mehrmals pro Woche</span></label>
          <label class="option-label"><input type="radio" name="q6" value="selten" class="option-input" /><span>Selten</span></label>
          <label class="option-label"><input type="radio" name="q6" value="nie" class="option-input" /><span>Nie</span></label>
        </div>
      </fieldset>

      <!-- Q7 -->
      <fieldset class="question" data-qid="7">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          7. Was trifft auf dich zu?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q7" value="mann" class="option-input" /><span>Männlich</span></label>
          <label class="option-label"><input type="radio" name="q7" value="frau-mens" class="option-input" /><span>Weiblich — mit Menstruation</span></label>
          <label class="option-label"><input type="radio" name="q7" value="frau-keine" class="option-input" /><span>Weiblich — ohne Menstruation (Menopause oder andere)</span></label>
        </div>
      </fieldset>

      <!-- Q8 -->
      <fieldset class="question" data-qid="8">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          8. Wie alt bist du?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q8" value="u30" class="option-input" /><span>Unter 30</span></label>
          <label class="option-label"><input type="radio" name="q8" value="30-50" class="option-input" /><span>30–50</span></label>
          <label class="option-label"><input type="radio" name="q8" value="51-65" class="option-input" /><span>51–65</span></label>
          <label class="option-label"><input type="radio" name="q8" value="ue65" class="option-input" /><span>Über 65</span></label>
        </div>
      </fieldset>

      <!-- Q9 -->
      <fieldset class="question" data-qid="9">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          9. Wie würdest du dein Aktivitätsniveau und deinen Stresslevel beschreiben?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q9" value="hoch" class="option-input" /><span>Viel Sport (&gt;4h/Woche) und/oder dauerhaft hoher Stress</span></label>
          <label class="option-label"><input type="radio" name="q9" value="mittel" class="option-input" /><span>Moderate Aktivität, normaler Alltagsstress</span></label>
          <label class="option-label"><input type="radio" name="q9" value="niedrig" class="option-input" /><span>Wenig Bewegung, wenig Stress</span></label>
        </div>
      </fieldset>

      <!-- Q10 -->
      <fieldset class="question" data-qid="10">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          10. Nimmst du regelmäßig Magensäureblocker? (z.B. Omeprazol, Pantoprazol)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q10" value="nein" class="option-input" /><span>Nein</span></label>
          <label class="option-label"><input type="radio" name="q10" value="ja" class="option-input" /><span>Ja, regelmäßig</span></label>
        </div>
      </fieldset>

    </form>

    <!-- Progress indicator -->
    <div class="mt-8 mb-4">
      <div class="flex justify-between text-xs text-slate-500 mb-1">
        <span id="progress-label">0 von 10 beantwortet</span>
        <span id="progress-pct">0%</span>
      </div>
      <div class="h-1.5 bg-slate-200 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-teal-500 rounded-full transition-all duration-300" style="width:0%"></div>
      </div>
    </div>

    <!-- CTA -->
    <div id="cta-hint" class="text-sm text-slate-400 text-center py-4">
      Beantworte alle 10 Fragen um dein Ergebnis zu sehen.
    </div>

    <!-- Results -->
    <div id="results" class="hidden mt-2">
      <div class="border-t-2 border-teal-200 pt-8">
        <h2 class="text-xl font-semibold text-slate-800 mb-2">Dein Ergebnis</h2>
        <p class="text-sm text-slate-500 mb-6">
          Basierend auf deinen Angaben — kein Ersatz für einen Bluttest.
        </p>
        <div id="result-cards" class="space-y-4"></div>

        <!-- Next steps -->
        <div class="mt-8 bg-teal-50 border border-teal-200 rounded-xl p-6">
          <p class="font-semibold text-teal-900 mb-4">Was jetzt?</p>
          <div class="space-y-3">
            <a href="/wirkstoffe" class="flex items-start gap-3 group no-underline">
              <span class="text-lg mt-0.5">🔬</span>
              <div>
                <p class="text-sm font-medium text-teal-800 group-hover:text-teal-900">Wirkstoff-Dossiers lesen</p>
                <p class="text-xs text-teal-600">Evidenz, Sicherheit und EFSA-Status für jeden Wirkstoff — bevor du kaufst.</p>
              </div>
            </a>
            <a href="/produkte" class="flex items-start gap-3 group no-underline">
              <span class="text-lg mt-0.5">💶</span>
              <div>
                <p class="text-sm font-medium text-teal-800 group-hover:text-teal-900">Produkte vergleichen</p>
                <p class="text-xs text-teal-600">Konkrete Supplements nach Preis/Tagesdosis, Reinheit und Zertifizierung bewertet.</p>
              </div>
            </a>
            <div class="flex items-start gap-3">
              <span class="text-lg mt-0.5">🩸</span>
              <div>
                <p class="text-sm font-medium text-teal-800">Bluttest machen lassen</p>
                <p class="text-xs text-teal-600">Dieser Check ist eine Orientierung — kein Ersatz für einen Bluttest beim Arzt. Ferritin, 25-OH-Vitamin D, Holotranscobalamin.</p>
              </div>
            </div>
          </div>
        </div>

        <p class="mt-6 text-xs text-slate-400 leading-relaxed">
          Dieser Check basiert auf typischen Zusammenhängen zwischen Ernährung und Mikronährstoffversorgung.
          Er stellt keine medizinische Diagnose dar. Für eine genaue Bestimmung empfehlen wir eine Blutuntersuchung beim Arzt.
        </p>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .option-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    font-size: 0.875rem;
    color: #374151;
  }
  .option-label:hover {
    border-color: #99f6e4;
    background: #f0fdf4;
  }
  .option-label:has(input:checked) {
    border-color: #0d9488;
    background: #f0fdfa;
    color: #134e4a;
    font-weight: 500;
  }
  .option-input {
    accent-color: #0d9488;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
</style>

<script>
// ── Scoring model ─────────────────────────────────────────────────────────────
// Each nutrient starts at 0. Answers add risk points (positive = more risk).
// Final score 0-10. Thresholds: ≥7 high, 4-6 medium, ≤3 low.

type Nutrient = 'vitaminD' | 'omega3' | 'magnesium' | 'eisen' | 'zink' | 'b12';
type Risk = 'hoch' | 'mittel' | 'niedrig';

interface NutrientResult {
  id: Nutrient;
  name: string;
  slug: string;
  score: number;
  risk: Risk;
  headline: string;
  explanation: string;
  foods: string[];
  supplementNote: string;
}

const SCORING: Record<string, Record<string, Partial<Record<Nutrient, number>>>> = {
  q1: {
    omnivor:      { b12: -1 },
    pescetarisch: { b12: -1, eisen: +1, zink: +1 },
    vegetarisch:  { omega3: +3, eisen: +2, zink: +2, b12: +3 },
    vegan:        { omega3: +3, eisen: +2, zink: +2, b12: +5, vitaminD: +1 },
  },
  q2: {
    '2plus': { omega3: -4 },
    '1pw':   { omega3: -2 },
    selten:  { omega3: +2 },
    nie:     { omega3: +4 },
  },
  q3: {
    '3plus': { eisen: -3, zink: -2 },
    '1-2pw': { eisen: -2, zink: -1 },
    selten:  { eisen: +1 },
    nie:     { eisen: +3, zink: +2 },
  },
  q4: {
    viel:   { vitaminD: -4 },
    mittel: { vitaminD: -2 },
    wenig:  { vitaminD: +2 },
    kaum:   { vitaminD: +4 },
  },
  q5: {
    taeglich: { eisen: -2, magnesium: -1 },
    '3-4pw':  { eisen: -1 },
    '1-2pw':  {},
    selten:   { eisen: +1, magnesium: +1 },
  },
  q6: {
    taeglich: { magnesium: -3, zink: -1 },
    mehrpw:   { magnesium: -2 },
    selten:   { magnesium: +2 },
    nie:      { magnesium: +3 },
  },
  q7: {
    mann:       {},
    'frau-mens': { eisen: +3 },
    'frau-keine': {},
  },
  q8: {
    u30:    {},
    '30-50': { vitaminD: +1 },
    '51-65': { vitaminD: +2, b12: +1 },
    ue65:   { vitaminD: +3, b12: +2 },
  },
  q9: {
    hoch:   { magnesium: +3 },
    mittel: { magnesium: +1 },
    niedrig: {},
  },
  q10: {
    nein: {},
    ja:   { b12: +2, magnesium: +1 },
  },
};

const NUTRIENTS: Record<Nutrient, {
  name: string; slug: string;
  headlines: Record<Risk, string>;
  explanations: Record<Risk, string>;
  foods: string[];
  supplementNote: string;
}> = {
  vitaminD: {
    name: 'Vitamin D3',
    slug: 'vitamin-d3-k2',
    headlines: {
      hoch:    'Vitamin D — hohes Mangelrisiko',
      mittel:  'Vitamin D — mögliche Unterversorgung',
      niedrig: 'Vitamin D — wahrscheinlich gut versorgt',
    },
    explanations: {
      hoch:    'In Deutschland sind von Oktober bis März die Sonnenstunden zu gering um ausreichend Vitamin D zu produzieren — und deine Angaben deuten auf wenig zusätzliche Zufuhr hin. Vitamin-D-Mangel ist in Deutschland weit verbreitet und betrifft schätzungsweise 40–60 % der Bevölkerung im Winter.',
      mittel:  'Deine Versorgung schwankt wahrscheinlich saisonal. Im Sommer ausreichend, im Winter mögliche Lücken.',
      niedrig: 'Regelmäßige Sonnenexposition und Fettzufuhr aus Fisch decken deinen Bedarf gut ab.',
    },
    foods: ['Fetter Fisch (Lachs, Makrele, Hering)', 'Eigelb', 'Lebertran', 'Angereicherte Produkte (Margarine, manche Pflanzendrinks)'],
    supplementNote: 'Ein 1.000–2.000 IE Vitamin D3-Supplement von Oktober bis März ist für die meisten Deutschen sinnvoll. Kombination mit K2 (MK-7) empfohlen.',
  },
  omega3: {
    name: 'Omega-3 (EPA+DHA)',
    slug: 'omega-3',
    headlines: {
      hoch:    'Omega-3 — hohes Mangelrisiko',
      mittel:  'Omega-3 — mögliche Unterversorgung',
      niedrig: 'Omega-3 — wahrscheinlich gut versorgt',
    },
    explanations: {
      hoch:    'EPA und DHA kommen fast ausschließlich in fettem Fisch und Meeresfrüchten vor. Deine Ernährung liefert wahrscheinlich wenig davon. Pflanzliche Omega-3-Quellen (Leinöl, Walnüsse) enthalten ALA, das der Körper nur schlecht in EPA/DHA umwandeln kann.',
      mittel:  'Du deckst einen Teil deines Bedarfs aus der Nahrung, aber nicht regelmäßig genug für eine optimale Versorgung.',
      niedrig: 'Regelmäßiger Fischkonsum sorgt für eine gute EPA/DHA-Versorgung.',
    },
    foods: ['Lachs (150 g = ca. 2 g EPA+DHA)', 'Makrele', 'Hering', 'Sardinen', 'Austern'],
    supplementNote: 'Fischöl oder Algenöl (vegan) mit mind. 500 mg EPA+DHA pro Tag. Auf TOTOX-Wert <26 achten.',
  },
  magnesium: {
    name: 'Magnesium',
    slug: 'magnesium',
    headlines: {
      hoch:    'Magnesium — hohes Mangelrisiko',
      mittel:  'Magnesium — mögliche Unterversorgung',
      niedrig: 'Magnesium — wahrscheinlich gut versorgt',
    },
    explanations: {
      hoch:    'Deine Ernährung liefert wenig der wichtigsten Magnesiumquellen, und Sport oder Stress erhöhen den Bedarf zusätzlich. Magnesiummangel äußert sich oft in Muskelkrämpfen, schlechtem Schlaf und Erschöpfung.',
      mittel:  'Dein Bedarf ist teilweise gedeckt. Bei hohem Stress oder intensivem Sport kann die Versorgung knapp werden.',
      niedrig: 'Deine Ernährung deckt den Magnesiumbedarf wahrscheinlich gut ab.',
    },
    foods: ['Kürbiskerne (100 g = 540 mg Mg)', 'Sonnenblumenkerne', 'Mandeln', 'Spinat', 'Hülsenfrüchte', 'Quinoa'],
    supplementNote: 'Magnesiumglycinat oder -citrat (200–400 mg/Tag) — nicht Oxid (schlechte Bioverfügbarkeit).',
  },
  eisen: {
    name: 'Eisen',
    slug: '',
    headlines: {
      hoch:    'Eisen — hohes Mangelrisiko',
      mittel:  'Eisen — mögliche Unterversorgung',
      niedrig: 'Eisen — wahrscheinlich gut versorgt',
    },
    explanations: {
      hoch:    'Menstruierende Frauen, Vegetarierinnen und Veganerinnen haben ein deutlich erhöhtes Eisenmangelrisiko. Pflanzliches (Non-Häm-)Eisen wird schlechter aufgenommen als Häm-Eisen aus Fleisch. Eisenmangel ist weltweit der häufigste Nährstoffmangel.',
      mittel:  'Dein Risiko ist erhöht. Besonders auf ausreichende Zufuhr und Aufnahmebedingungen achten.',
      niedrig: 'Deine Ernährung liefert wahrscheinlich ausreichend gut verfügbares Eisen.',
    },
    foods: ['Rotes Fleisch (beste Quelle)', 'Leber', 'Hülsenfrüchte + Vitamin C (verbessert Aufnahme)', 'Tofu', 'Quinoa', 'Kürbiskerne'],
