const form = document.getElementById('check-form') as HTMLFormElement;
const resultsEl = document.getElementById('results')!;
const ctaHint = document.getElementById('cta-hint')!;
const resultCards = document.getElementById('result-cards')!;
const radarEl = document.getElementById('radar-chart')!;
const progressBar = document.getElementById('progress-bar') as HTMLElement;
const progressLabel = document.getElementById('progress-label')!;
const progressPct = document.getElementById('progress-pct')!;

const TOTAL_QUESTIONS = 15;

function getAnswers(): Record<string, string> {
  const data = new FormData(form);
  const out: Record<string, string> = {};
  for (let i = 1; i <= TOTAL_QUESTIONS; i++) {
    const val = data.get(`q${i}`);
    if (val) out[`q${i}`] = val as string;
  }
  return out;
}

function renderRadar(results: NutrientResult[]) {
  const radarResults = [...results].sort((a, b) => a.name.localeCompare(b.name, 'de'));
  const size = 400;
  const center = size / 2;
  const radius = 130;
  const levels = 5;

  const pointAt = (index: number, value: number) => {
    const angle = (-Math.PI / 2) + (index / radarResults.length) * Math.PI * 2;
    const scaled = (value / 10) * radius;
    return {
      x: center + Math.cos(angle) * scaled,
      y: center + Math.sin(angle) * scaled,
    };
  };

  const polygonPoints = radarResults
    .map((r, i) => {
      const p = pointAt(i, r.score);
      return `${p.x},${p.y}`;
    })
    .join(' ');

  const gridPolygons = Array.from({ length: levels }, (_, idx) => {
    const factor = (idx + 1) / levels;
    const points = radarResults
      .map((_, i) => {
        const p = pointAt(i, factor * 10);
        return `${p.x},${p.y}`;
      })
      .join(' ');
    return `<polygon points="${points}" fill="none" stroke="#cbd5e1" stroke-width="1" />`;
  }).join('');

  const axes = radarResults.map((_, i) => {
    const p = pointAt(i, 10);
    return `<line x1="${center}" y1="${center}" x2="${p.x}" y2="${p.y}" stroke="#cbd5e1" stroke-width="1" />`;
  }).join('');

  const labels = radarResults.map((r, i) => {
    const p = pointAt(i, 13.5);
    const anchor = Math.abs(p.x - center) < 14 ? 'middle' : p.x < center ? 'end' : 'start';
    return `<text x="${p.x}" y="${p.y}" text-anchor="${anchor}" dominant-baseline="middle" fill="#475569" font-size="10" font-weight="500">${r.name}</text>`;
  }).join('');

  const points = radarResults.map((r, i) => {
    const p = pointAt(i, r.score);
    return `<circle cx="${p.x}" cy="${p.y}" r="3.5" fill="#0f766e" stroke="#ffffff" stroke-width="2"><title>${r.name}: ${r.score}/10</title></circle>`;
  }).join('');

  radarEl.innerHTML = `
    <div class="flex justify-center">
      <svg viewBox="0 0 ${size} ${size}" class="w-full max-w-[480px] h-auto overflow-visible" role="img" aria-label="Radar Chart des Risikoprofils">
        ${gridPolygons}
        ${axes}
        <polygon points="${polygonPoints}" fill="rgba(13, 148, 136, 0.18)" stroke="#0f766e" stroke-width="2.5" />
        ${points}
        ${labels}
      </svg>
    </div>
  `;
}

function getReason(id: Nutrient, answers: Record<string, string>): string {
  const q = answers;
  switch (id) {
    case 'vitaminD':
      if (q.q4 === 'kaum') return 'due to minimal sun exposure';
      if (q.q4 === 'wenig') return 'due to limited sun exposure';
      return 'based on your lifestyle';
    case 'omega3':
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'because plant-based diets contain almost no EPA/DHA';
      if (q.q2 === 'nie') return 'because no fish is consumed';
      if (q.q2 === 'selten') return 'because fish is rarely consumed';
      return 'based on your dietary pattern';
    case 'magnesium':
      if (q.q6 === 'nie' && q.q9 === 'hoch') return 'due to few magnesium sources + high exercise/stress';
      if (q.q6 === 'nie') return 'because few nuts, seeds, or legumes are consumed';
      if (q.q9 === 'hoch') return 'because exercise and stress increase requirements';
      return 'based on your responses';
    case 'eisen':
      if (q.q7 === 'frau-mens' && (q.q1 === 'vegan' || q.q1 === 'vegetarisch')) return 'because menstruation + plant-based diet greatly increase risk';
      if (q.q7 === 'frau-mens') return 'because menstrual blood loss increases iron needs';
      if (q.q3 === 'nie') return 'because no heme iron from meat is consumed';
      return 'based on your responses';
    case 'zink':
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'because plant-based zinc has lower bioavailability';
      return 'based on your dietary pattern';
    case 'b12':
      if (q.q1 === 'vegan') return 'because vegan diets contain no B12';
      if (q.q1 === 'vegetarisch') return 'because vegetarian diets provide little B12';
      if (q.q10 === 'ja') return 'because acid blockers impair B12 absorption';
      if (q.q8 === 'ue65') return 'because absorption decreases with age';
      return 'based on your responses';
    case 'kreatin':
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'because plant-based diets contain no creatine';
      if (q.q3 === 'nie') return 'because no red meat is consumed';
      return 'based on your dietary pattern';
    case 'vitaminK2':
      if (q.q12 === 'selten' || q.q12 === 'gelegentlich') return 'because few fermented or aged products are consumed';
      return 'based on your dietary pattern';
    case 'jod':
      if (q.q13 === 'meersalz') return 'because sea salt contains no iodine';
      return 'based on your salt choice';
    case 'selen':
      if (q.q1 === 'vegan') return 'because plant-based diets provide little selenium';
      return 'based on your dietary pattern';
    case 'folat':
      if (q.q5 === 'selten') return 'because little dark green vegetables are consumed';
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'due to plant-based diet without animal folate sources';
      return 'based on your dietary pattern';
    case 'vitaminB6':
      if (q.q1 === 'vegan') return 'because plant sources provide less B6';
      return 'based on your dietary pattern';
    case 'coq10':
      if (q.q15 === 'ja') return 'because statins reduce CoQ10 in the body';
      if (q.q8 === 'ue65' || q.q8 === '51-65') return 'because CoQ10 declines with age';
      return 'based on your age or medication';
    case 'cholin':
      if (q.q11 === 'selten' || q.q11 === 'nie') return 'because few eggs are consumed (main choline source)';
      if (q.q1 === 'vegan') return 'because vegan diets contain very little choline';
      return 'based on your dietary pattern';
    case 'calcium':
      if (q.q1 === 'vegan') return 'because animal calcium sources are missing';
      return 'based on your dietary pattern';
    case 'kupfer':
      return 'based on your dietary pattern';
    case 'lutein':
      if (q.q11 === 'selten' || q.q11 === 'nie') return 'because few eggs are consumed';
      if (q.q5 === 'selten') return 'because little green vegetables are consumed';
      return 'based on your dietary pattern';
    case 'taurin':
      if (q.q1 === 'vegan' || q.q1 === 'vegetarisch') return 'because taurine is found almost only in meat and fish';
      return 'based on your dietary pattern';
    case 'glycin':
      if (q.q14 === 'nie') return 'because collagen-rich foods are rarely consumed';
      return 'based on your dietary pattern';
    case 'vitaminA':
      if (q.q1 === 'vegan') return 'because vegan diets contain no preformed retinol';
      if (q.q1 === 'vegetarisch') return 'because vegetarian diets provide little retinol';
      if (q.q14 === 'nie') return 'because almost no preformed retinol from liver or organ meats is consumed';
      return 'based on your dietary pattern';
    default:
      return 'based on your responses';
  }
}

function renderResults(answers: Record<string, string>) {
  const results = computeScores(answers);
  resultCards.innerHTML = '';
  renderRadar(results);

  const make = (tag: string, className?: string, text?: string) => {
    const el = document.createElement(tag);
    if (className) el.className = className;
    if (text !== undefined) el.textContent = text;
    return el;
  };

  results.forEach((r, idx) => {
    const { bar, badge, label } = riskStyle(r.risk);
    const isTop3 = idx < 3;
    const card = make('div', `bg-white border rounded-xl overflow-hidden ${r.risk === 'hoch' ? 'border-red-200' : r.risk === 'mittel' ? 'border-amber-200' : 'border-slate-200'}`);
    const wrapper = make('div', 'p-5');
    card.appendChild(wrapper);

    const header = make('div', 'flex items-start justify-between gap-3 mb-3');
    const left = make('div');
    const name = make('p', 'font-semibold text-slate-900', r.name);
    const headline = make('p', 'text-sm font-medium text-slate-600 mt-0.5', r.headline.replace(r.name + ' — ', ''));
    left.append(name, headline);

    const badgeEl = make('span', `shrink-0 text-xs font-semibold rounded-full px-2.5 py-1 ${badge}`, label);
    header.append(left, badgeEl);
    wrapper.appendChild(header);

    const barWrap = make('div', 'h-1.5 bg-slate-100 rounded-full mb-4 overflow-hidden');
    const barEl = make('div', `h-full rounded-full ${bar}`);
    barEl.style.width = `${r.score * 10}%`;
    barWrap.appendChild(barEl);
    wrapper.appendChild(barWrap);

    const details = make('details', 'text-sm');
    const summary = make('summary', 'cursor-pointer text-slate-600 hover:text-slate-800 list-none flex items-center gap-2 font-medium');
    summary.append(
      make('span', undefined, 'Show details'),
      make('span', 'text-xs text-slate-400', '↓')
    );
    details.appendChild(summary);

    const detailsBody = make('div', 'mt-4 space-y-4 border-t border-slate-100 pt-4');

    if (r.risk === 'hoch' || r.risk === 'mittel') {
      const reasonEl = make('p', 'text-sm text-slate-400 italic', `Estimated risk — ${getReason(r.id, answers)}`);
      detailsBody.appendChild(reasonEl);
    }

    detailsBody.appendChild(make('p', 'text-sm text-slate-600', r.explanation));

    if (isTop3) {
      const top3Block = make('div', 'space-y-3');
      const foodsBlock = make('div');
      foodsBlock.appendChild(make('p', 'text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5', 'Food Sources'));

      const foodsList = make('ul', 'space-y-1');
      r.foods.forEach((f) => {
        const li = make('li', 'flex items-start gap-1.5');
        li.append(make('span', 'text-teal-500 mt-0.5', '•'), document.createTextNode(f));
        foodsList.appendChild(li);
      });
      foodsBlock.appendChild(foodsList);

      const supplementBlock = make('div', 'bg-slate-50 rounded-lg p-3');
      supplementBlock.appendChild(make('p', 'text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1', 'Supplement Note'));
      supplementBlock.appendChild(make('p', 'text-slate-600', r.supplementNote));

      top3Block.append(foodsBlock, supplementBlock);
      detailsBody.appendChild(top3Block);
    }

    if (r.risk === 'hoch' || r.risk === 'mittel') {
      const foodBlock = make('div');
      foodBlock.appendChild(make('p', 'text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5', 'Food Sources'));
      const foodTags = make('div', 'flex flex-wrap gap-1.5');
      r.foods.forEach(f => {
        foodTags.appendChild(make('span', 'text-xs bg-slate-100 text-slate-600 rounded-md px-2 py-1', f));
      });
      foodBlock.appendChild(foodTags);

      const veganNutrients: Nutrient[] = ['omega3', 'eisen', 'b12', 'kreatin', 'taurin', 'glycin', 'cholin'];
      if (answers.q1 === 'vegan' && veganNutrients.includes(r.id)) {
        foodBlock.appendChild(make('p', 'text-xs text-slate-400 mt-1', 'Plant-based diet: animal sources unavailable — consider supplementation.'));
      }
      detailsBody.appendChild(foodBlock);
    }

    const nextStep = NUTRIENTS[r.id].nextSteps[r.risk];
    const borderColor = r.risk === 'hoch' ? 'border-red-300' : r.risk === 'mittel' ? 'border-amber-300' : 'border-emerald-300';
    const nextStepEl = make('div', `text-sm text-slate-700 bg-slate-50 rounded-lg px-3 py-2.5 border-l-2 ${borderColor}`);
    const nextStepLabel = make('span', 'font-medium', 'Next step: ');
    nextStepEl.append(nextStepLabel, document.createTextNode(nextStep));
    detailsBody.appendChild(nextStepEl);

    if (r.slug) {
      const link = make('a', 'inline-flex items-center gap-1.5 text-sm font-medium text-teal-700 bg-teal-50 hover:bg-teal-100 border border-teal-200 rounded-lg px-3 py-2 no-underline transition-colors', 'Read Ingredient Dossier →');
      link.setAttribute('href', `/en/ingredients/${r.slug}`);
      detailsBody.appendChild(link);
    }

    details.appendChild(detailsBody);
    wrapper.appendChild(details);

    resultCards.appendChild(card);
  });

  // GKV section
  const gkvSection = document.getElementById('gkv-section') as HTMLElement;
  const gkvCards = document.getElementById('gkv-cards') as HTMLElement;
  if (gkvSection && gkvCards) {
    const relevantTests = results
      .filter(r => r.score >= 5 && GKV_TESTS[r.id as Nutrient])
      .map(r => ({ ...GKV_TESTS[r.id as Nutrient]!, nutrientName: r.name }));

    if (relevantTests.length > 0) {
      gkvCards.innerHTML = relevantTests.map(t => {
        const statusColor = t.gkvStatus === 'covered'
          ? 'text-emerald-700 bg-emerald-50'
          : t.gkvStatus === 'conditional'
          ? 'text-amber-700 bg-amber-50'
          : 'text-slate-600 bg-slate-50';
        const statusLabel = t.gkvStatus === 'covered'
          ? '✅ Insurance Coverage Possible'
          : t.gkvStatus === 'conditional'
          ? '⚡ Situational'
          : '💶 Self-Pay';
        return `<div class="px-5 py-4">
          <div class="flex items-start justify-between gap-3 mb-2">
            <div>
              <p class="font-medium text-slate-800 text-sm">${t.testName}</p>
              <p class="text-xs text-slate-500 mt-0.5">for: ${t.nutrientName}</p>
            </div>
            <span class="shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full ${statusColor}">${statusLabel}</span>
          </div>
          <p class="text-sm text-slate-600">${t.gkvNote}</p>
          ${t.igelCost ? `<p class="text-xs text-slate-400 mt-1">Self-pay: about ${t.igelCost}</p>` : ''}
        </div>`;
      }).join('');
      gkvSection.classList.remove('hidden');
    } else {
      gkvSection.classList.add('hidden');
    }
  }
}

function update() {
  const answers = getAnswers();
  const count = Object.keys(answers).length;

  // Update progress
  const pct = Math.round((count / TOTAL_QUESTIONS) * 100);
  progressBar.style.width = `${pct}%`;
  progressLabel.textContent = `${count} of ${TOTAL_QUESTIONS} answered`;
  progressPct.textContent = `${pct}%`;

  if (count < TOTAL_QUESTIONS) {
    resultsEl.classList.add('hidden');
    ctaHint.classList.remove('hidden');
    document.querySelectorAll('fieldset.question').forEach(fs => {
      const answered = !!(fs as HTMLFieldSetElement).querySelector('input[type=radio]:checked');
      if (answered) {
        fs.classList.remove('border-yellow-400', 'ring-2', 'ring-yellow-200');
      } else {
        fs.classList.add('border-yellow-400', 'ring-2', 'ring-yellow-200');
      }
    });
    return;
  }

  ctaHint.classList.add('hidden');
  document.querySelectorAll('fieldset.question').forEach(fs => {
    fs.classList.remove('border-yellow-400', 'ring-2', 'ring-yellow-200');
  });
  resultsEl.classList.remove('hidden');
  document.getElementById('export-buttons')?.classList.remove('hidden');
  renderResults(answers);

  // Smooth scroll to results
  resultsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

form.addEventListener('change', update);

document.getElementById("goto-next")?.addEventListener("click", () => {
  const unanswered = Array.from(document.querySelectorAll("fieldset.question")).find(
    fs => !fs.querySelector("input[type=radio]:checked")
  );
  if (unanswered) {
    unanswered.scrollIntoView({ behavior: "smooth", block: "center" });
    (unanswered.querySelector("input[type=radio]") as HTMLInputElement)?.focus();
  }
});

document.getElementById("btn-copy")?.addEventListener("click", () => {
  const lines: string[] = [];
  lines.push("MikroScore Nutrient Check — " + new Date().toLocaleDateString("en-GB"));
  lines.push("Note: Estimate, not a diagnosis. Calculated locally.");
  lines.push("");

  document.querySelectorAll("#result-cards > div").forEach(card => {
    const name = card.querySelector("p.font-semibold")?.textContent?.trim() || "";
    const badge = card.querySelector("span[class*=rounded-full]")?.textContent?.trim() || "";
    const reason = card.querySelector("p.italic")?.textContent?.trim() || "";
    const nextStep = card.querySelector("div[class*=border-l-2] span + span, div[class*=border-l-2]")?.textContent?.replace("Next step:", "").trim() || "";
    if (name) {
      lines.push(`${name} — ${badge}`);
      if (reason) lines.push(`  → ${reason}`);
      if (nextStep) lines.push(`  Next step: ${nextStep}`);
      lines.push("");
    }
  });

  lines.push("---");
  lines.push("Source: mikroscore.com/en/nutrient-check");

  navigator.clipboard.writeText(lines.join("\n")).then(() => {
    const btn = document.getElementById("btn-copy");
    if (btn) { btn.textContent = "✅ Copied!"; setTimeout(() => { btn.innerHTML = "📋 Copy Results"; }, 2000); }
  }).catch(() => {
    alert("Could not copy — please select manually.");
  });
});

document.getElementById("btn-print")?.addEventListener("click", () => {
  window.print();
});
</script>
