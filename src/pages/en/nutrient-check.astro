---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalNotice from '../../components/LegalNotice.astro';
import NutrientAssessmentIllustration from '../../components/illustrations/NutrientAssessmentIllustration.astro';
---

<BaseLayout
  locale="en"
  hreflang={{ de: '/ernaehrungs-check', en: '/en/nutrient-check' }}
  title="Nutrient Check"
  description="Discover which micronutrients you may lack — based on your diet and lifestyle. Free, evidence-based, in 90 seconds."
>
  <div class="max-w-2xl mx-auto px-4 py-12">

    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-sm text-slate-600 mb-8">
      <a href="/en/" class="hover:text-slate-900 transition-colors">Home</a>
      <span class="text-slate-400">/</span>
      <span class="text-slate-900 font-medium">Nutrient Check</span>
    </nav>

    <!-- Illustration banner -->
    <div class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-teal-50/40 shadow-sm mb-6">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.07),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(15,23,42,0.04),transparent_28%)]"></div>
      <div class="relative p-5">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-2">Personal Micronutrient Risk Assessment</div>
        <NutrientAssessmentIllustration />
      </div>
    </div>

    <div class="mb-6">
      <h1 class="text-3xl font-bold text-slate-900 mb-3">Nutrient Check</h1>
      <p class="text-slate-600">
        15 questions, about 90 seconds. We estimate which micronutrients
        may have an elevated risk of insufficient supply — as guidance, not a diagnosis.
      </p>
    </div>

    <div class="mb-10">
      <LegalNotice>
        The Nutrient Check is a simplified informational tool and not medical diagnostics. Results are estimates based on your responses and do not replace lab tests, medical consultation, or individual treatment recommendations. <strong>Your answers are processed only locally in your browser, are not stored with personal information, and are not transmitted to us.</strong>
      </LegalNotice>
    </div>

    <!-- Privacy Badge -->
    <div class="flex items-center gap-2 text-sm text-slate-500 bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 mb-6">
      <span class="text-base">🔒</span>
      <span>Your answers remain <strong>local to your browser</strong> and are not transmitted to MikroScore.</span>
    </div>

    <!-- Questions -->
    <form id="check-form" class="space-y-8">

      <!-- Section: Diet -->
      <div class="flex items-center gap-3 mt-2 mb-1">
        <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">🥦 Diet</span>
        <div class="flex-1 h-px bg-slate-200"></div>
      </div>

      <!-- Q1 -->
      <fieldset class="question" data-qid="1">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          1. How would you describe your diet?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q1" value="omnivor" class="option-input" /><span>Omnivore — I eat everything including meat and fish</span></label>
          <label class="option-label"><input type="radio" name="q1" value="pescetarisch" class="option-input" /><span>Pescatarian — no meat, but fish</span></label>
          <label class="option-label"><input type="radio" name="q1" value="vegetarisch" class="option-input" /><span>Vegetarian — no meat, no fish</span></label>
          <label class="option-label"><input type="radio" name="q1" value="vegan" class="option-input" /><span>Vegan — no animal products</span></label>
        </div>
      </fieldset>

      <!-- Q2 -->
      <fieldset class="question" data-qid="2">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          2. How often do you eat fatty fish? (Salmon, mackerel, herring, sardines)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q2" value="2plus" class="option-input" /><span>2x per week or more</span></label>
          <label class="option-label"><input type="radio" name="q2" value="1pw" class="option-input" /><span>About 1x per week</span></label>
          <label class="option-label"><input type="radio" name="q2" value="selten" class="option-input" /><span>1–3x per month</span></label>
          <label class="option-label"><input type="radio" name="q2" value="nie" class="option-input" /><span>Rarely or never</span></label>
        </div>
      </fieldset>

      <!-- Q3 -->
      <fieldset class="question" data-qid="3">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          3. How often do you eat red meat? (Beef, lamb, pork)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q3" value="3plus" class="option-input" /><span>3x per week or more</span></label>
          <label class="option-label"><input type="radio" name="q3" value="1-2pw" class="option-input" /><span>1–2x per week</span></label>
          <label class="option-label"><input type="radio" name="q3" value="selten" class="option-input" /><span>Rarely (1–3x per month)</span></label>
          <label class="option-label"><input type="radio" name="q3" value="nie" class="option-input" /><span>Never</span></label>
        </div>
      </fieldset>

      <!-- Section: Lifestyle -->
      <div class="flex items-center gap-3 mt-6 mb-1">
        <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">☀️ Lifestyle</span>
        <div class="flex-1 h-px bg-slate-200"></div>
      </div>

      <!-- Q4 -->
      <fieldset class="question" data-qid="4">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          4. How much time do you spend daily outdoors with exposed skin?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">Face + arms exposed, from April to September</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q4" value="viel" class="option-input" /><span>More than 30 minutes daily</span></label>
          <label class="option-label"><input type="radio" name="q4" value="mittel" class="option-input" /><span>15–30 minutes daily</span></label>
          <label class="option-label"><input type="radio" name="q4" value="wenig" class="option-input" /><span>Less than 15 minutes</span></label>
          <label class="option-label"><input type="radio" name="q4" value="kaum" class="option-input" /><span>Rarely — I'm mostly indoors or fully covered</span></label>
        </div>
      </fieldset>

      <!-- Q5 -->
      <fieldset class="question" data-qid="5">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          5. How often do you eat dark green vegetables? (Spinach, broccoli, kale, chard)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q5" value="taeglich" class="option-input" /><span>Daily</span></label>
          <label class="option-label"><input type="radio" name="q5" value="3-4pw" class="option-input" /><span>3–4x per week</span></label>
          <label class="option-label"><input type="radio" name="q5" value="1-2pw" class="option-input" /><span>1–2x per week</span></label>
          <label class="option-label"><input type="radio" name="q5" value="selten" class="option-input" /><span>Rarely</span></label>
        </div>
      </fieldset>

      <!-- Q6 -->
      <fieldset class="question" data-qid="6">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          6. How often do you eat nuts, seeds, or legumes?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">E.g., almonds, pumpkin seeds, beans, lentils</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q6" value="taeglich" class="option-input" /><span>Daily</span></label>
          <label class="option-label"><input type="radio" name="q6" value="mehrpw" class="option-input" /><span>Multiple times per week</span></label>
          <label class="option-label"><input type="radio" name="q6" value="selten" class="option-input" /><span>Rarely</span></label>
          <label class="option-label"><input type="radio" name="q6" value="nie" class="option-input" /><span>Never</span></label>
        </div>
      </fieldset>

      <!-- Section: Personal & Life Stage -->
      <div class="flex items-center gap-3 mt-6 mb-1">
        <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">👤 Personal & Life Stage</span>
        <div class="flex-1 h-px bg-slate-200"></div>
      </div>

      <!-- Q7 -->
      <fieldset class="question" data-qid="7">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          7. Which applies to you?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q7" value="mann" class="option-input" /><span>Male</span></label>
          <label class="option-label"><input type="radio" name="q7" value="frau-mens" class="option-input" /><span>Female — menstruating</span></label>
          <label class="option-label"><input type="radio" name="q7" value="frau-keine" class="option-input" /><span>Female — non-menstruating (menopause or other)</span></label>
        </div>
      </fieldset>

      <!-- Q8 -->
      <fieldset class="question" data-qid="8">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          8. How old are you?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q8" value="u30" class="option-input" /><span>Under 30</span></label>
          <label class="option-label"><input type="radio" name="q8" value="30-50" class="option-input" /><span>30–50</span></label>
          <label class="option-label"><input type="radio" name="q8" value="51-65" class="option-input" /><span>51–65</span></label>
          <label class="option-label"><input type="radio" name="q8" value="ue65" class="option-input" /><span>Over 65</span></label>
        </div>
      </fieldset>

      <!-- Q9 -->
      <fieldset class="question" data-qid="9">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          9. How would you describe your activity level and stress level?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q9" value="hoch" class="option-input" /><span>High activity (&gt;4 hrs/week) and/or sustained high stress</span></label>
          <label class="option-label"><input type="radio" name="q9" value="mittel" class="option-input" /><span>Moderate activity, normal daily stress</span></label>
          <label class="option-label"><input type="radio" name="q9" value="niedrig" class="option-input" /><span>Low activity, low stress</span></label>
        </div>
      </fieldset>

      <!-- Section: Medication & Supplementation -->
      <div class="flex items-center gap-3 mt-6 mb-1">
        <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">💊 Medication & Supplementation</span>
        <div class="flex-1 h-px bg-slate-200"></div>
      </div>

      <!-- Q10 -->
      <fieldset class="question" data-qid="10">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          10. Do you regularly take acid-reducing medication? (e.g., omeprazole, pantoprazole)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q10" value="nein" class="option-input" /><span>No</span></label>
          <label class="option-label"><input type="radio" name="q10" value="ja" class="option-input" /><span>Yes, regularly</span></label>
        </div>
      </fieldset>

      <!-- Q11 -->
      <fieldset class="question" data-qid="11">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          11. Do you regularly eat eggs?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q11" value="taeglich" class="option-input" /><span>Daily</span></label>
          <label class="option-label"><input type="radio" name="q11" value="mehrpw" class="option-input" /><span>Multiple times per week</span></label>
          <label class="option-label"><input type="radio" name="q11" value="selten" class="option-input" /><span>Rarely (1–3x per month)</span></label>
          <label class="option-label"><input type="radio" name="q11" value="nie" class="option-input" /><span>Never</span></label>
        </div>
      </fieldset>

      <!-- Q12 -->
      <fieldset class="question" data-qid="12">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          12. How often do you eat fermented or aged foods?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">E.g., natto, aged cheese (Gouda, Emmental), kefir, kimchi</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q12" value="taeglich" class="option-input" /><span>Daily (including cheese or kefir)</span></label>
          <label class="option-label"><input type="radio" name="q12" value="mehrpw" class="option-input" /><span>Multiple times per week</span></label>
          <label class="option-label"><input type="radio" name="q12" value="gelegentlich" class="option-input" /><span>Occasionally</span></label>
          <label class="option-label"><input type="radio" name="q12" value="selten" class="option-input" /><span>Rarely or never</span></label>
        </div>
      </fieldset>

      <!-- Q13 -->
      <fieldset class="question" data-qid="13">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          13. Which type of salt do you mainly use?
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q13" value="jodiert" class="option-input" /><span>Iodized table salt</span></label>
          <label class="option-label"><input type="radio" name="q13" value="meersalz" class="option-input" /><span>Sea salt, Himalayan salt, or other non-iodized salt</span></label>
          <label class="option-label"><input type="radio" name="q13" value="kein" class="option-input" /><span>I rarely use salt</span></label>
        </div>
      </fieldset>

      <!-- Q14 -->
      <fieldset class="question" data-qid="14">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          14. Do you regularly eat organ meats or bone broth?
          <span class="block text-xs font-normal text-slate-500 mt-0.5">E.g., liver, kidney, heart, homemade bone broth</span>
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q14" value="regelmaessig" class="option-input" /><span>Yes, at least 1x per week</span></label>
          <label class="option-label"><input type="radio" name="q14" value="selten" class="option-input" /><span>Rarely (1–3x per month)</span></label>
          <label class="option-label"><input type="radio" name="q14" value="nie" class="option-input" /><span>Never</span></label>
        </div>
      </fieldset>

      <!-- Q15 -->
      <fieldset class="question" data-qid="15">
        <legend class="text-base font-semibold text-slate-800 mb-3">
          15. Do you take statins? (Cholesterol medication, e.g., atorvastatin, simvastatin)
        </legend>
        <div class="space-y-2">
          <label class="option-label"><input type="radio" name="q15" value="nein" class="option-input" /><span>No</span></label>
          <label class="option-label"><input type="radio" name="q15" value="ja" class="option-input" /><span>Yes, regularly</span></label>
        </div>
      </fieldset>

    </form>

    <!-- Progress indicator -->
    <div class="mt-8 mb-4">
      <div class="flex justify-between text-xs text-slate-500 mb-1">
        <span id="progress-label" aria-live="polite">0 of 15 answered</span>
        <span id="progress-pct">0%</span>
      </div>
      <div class="h-1.5 bg-slate-200 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full bg-teal-500 rounded-full transition-all duration-300" style="width:0%"></div>
      </div>
    </div>

    <!-- CTA -->
    <div id="cta-hint" class="hidden">
      <button id="goto-next" type="button" class="w-full text-sm font-medium text-teal-700 bg-teal-50 border border-teal-200 rounded-lg px-4 py-2.5 hover:bg-teal-100 transition-colors">
        Go to next unanswered question ↓
      </button>
    </div>

    <!-- Results -->
    <div id="results" class="hidden mt-2">
      <div class="border-t-2 border-teal-200 pt-8">
        <h2 class="text-xl font-semibold text-slate-800 mb-2">Your Results</h2>
        <p class="text-sm text-slate-500 mb-6">
          Estimate based on your answers — not a replacement for a blood test. 🔒 Calculated locally, nothing transmitted.
        </p>

        <div class="bg-white border border-slate-200 rounded-2xl p-5 md:p-6 mb-6">
          <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
            <div>
              <p class="text-sm font-semibold text-slate-800">Your Risk Profile</p>
              <p class="text-xs text-slate-500 mt-1">The further out the points, the higher the estimated risk based on your answers.</p>
            </div>
            <span class="text-xs font-medium text-slate-400">Scale 0–10</span>
          </div>
          <div id="radar-chart" class="mb-4"></div>
          <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-4 text-xs text-slate-600 leading-6">
            This quick check covers 20 often-underestimated micronutrients and supplements: from vitamin D, omega-3, and magnesium to creatine, choline, vitamin K2, glycine, and more. A complete nutritional assessment covers much more — such as protein intake, essential amino acids, fiber, omega-6/3 ratio, or individual food sensitivities. <strong>View this result as initial guidance, not a complete analysis.</strong>
          </div>
        </div>

        <div id="result-cards" class="space-y-4"></div>

        <div id="export-buttons" class="hidden mt-6 flex gap-3 flex-wrap">
          <button id="btn-copy" type="button"
            class="flex items-center gap-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-lg px-4 py-2 hover:bg-slate-50 transition-colors">
            📋 Copy Results
          </button>
          <button id="btn-print" type="button"
            class="flex items-center gap-2 text-sm font-medium text-slate-700 bg-white border border-slate-200 rounded-lg px-4 py-2 hover:bg-slate-50 transition-colors">
            🖨️ Save as PDF
          </button>
        </div>

        <!-- Blood Tests — Insurance Coverage -->
        <div id="gkv-section" class="hidden mt-8">
          <div class="border border-blue-200 rounded-xl overflow-hidden">
            <div class="bg-blue-50 px-5 py-4 border-b border-blue-200">
              <h3 class="font-semibold text-blue-900">🩸 Blood Tests — Insurance Coverage</h3>
              <p class="text-sm text-blue-700 mt-1">Based on your risk profile — possible insurance-covered tests for your nutrients at risk.</p>
            </div>
            <div id="gkv-cards" class="divide-y divide-blue-100"></div>
            <div class="bg-blue-50/50 px-5 py-3 text-xs text-blue-600">
              ⚠️ Insurance coverage depends on diagnosis, insurance plan, and physician judgment. This overview is for guidance only — not a legal entitlement. When in doubt, discuss with your doctor.
            </div>
          </div>
        </div>

        <!-- Next steps -->
        <div class="mt-8 bg-teal-50 border border-teal-200 rounded-xl p-6">
          <p class="font-semibold text-teal-900 mb-4">What Next?</p>
          <div class="space-y-3">
            <a href="/en/ingredients" class="flex items-start gap-3 group no-underline">
              <span class="text-lg mt-0.5">🔬</span>
              <div>
                <p class="text-sm font-medium text-teal-800 group-hover:text-teal-900">Read Ingredient Dossiers</p>
                <p class="text-xs text-teal-600">Evidence, safety, and regulatory status for every ingredient — before you buy.</p>
              </div>
            </a>
            <a href="/en/products" class="flex items-start gap-3 group no-underline">
              <span class="text-lg mt-0.5">💶</span>
              <div>
                <p class="text-sm font-medium text-teal-800 group-hover:text-teal-900">Compare Products</p>
                <p class="text-xs text-teal-600">Concrete supplements rated by price/serving, purity, and certification.</p>
              </div>
            </a>
            <div class="flex items-start gap-3">
              <span class="text-lg mt-0.5">🩸</span>
              <div>
                <p class="text-sm font-medium text-teal-800">Get a Blood Test</p>
                <p class="text-xs text-teal-600">This check is guidance — not a replacement for blood work with your doctor. Ferritin, 25-OH vitamin D, holotranscobalamin.</p>
              </div>
            </div>
          </div>
        </div>

        <p class="mt-6 text-xs text-slate-400 leading-relaxed">
          This check is based on typical relationships between diet and micronutrient status.
          It is not medical diagnosis. For accurate determination, we recommend a blood test with your doctor.
        </p>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .option-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    font-size: 0.875rem;
    color: #374151;
  }
  .option-label:hover {
    border-color: #99f6e4;
    background: #f0fdf4;
  }
  .option-label:has(input:checked) {
    border-color: #0d9488;
    background: #f0fdfa;
    color: #134e4a;
    font-weight: 500;
  }
  .option-input {
    accent-color: #0d9488;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  @media print {
    /* Hide everything except results */
    .max-w-2xl > *:not(#results) { display: none !important; }
    #results { display: block !important; }
    #export-buttons, #gkv-section, #goto-next { display: none !important; }

    /* Page setup */
    @page { margin: 1.5cm; size: A4; }
    body { font-size: 11px; }

    /* Header */
    #results::before {
      content: "MikroScore — Nutrient Check";
      display: block;
      font-size: 14px;
      font-weight: bold;
      margin-bottom: 4px;
    }
    #results::after {
      content: "Estimate, not a diagnosis · mikroscore.com/en/nutrient-check";
      display: block;
      font-size: 9px;
      color: #94a3b8;
      margin-bottom: 12px;
      border-bottom: 1px solid #e2e8f0;
      padding-bottom: 8px;
    }

    /* Hide low-risk cards entirely */
    #result-cards > div:has(span.bg-emerald-100) { display: none !important; }

    /* Compact cards */
    #result-cards > div { 
      border: 1px solid #e2e8f0 !important;
      border-radius: 6px !important;
      margin-bottom: 6px !important;
      page-break-inside: avoid;
    }
    #result-cards > div > div { padding: 8px 10px !important; }

    /* Hide food tags, details, dossier links — keep name, badge, reason, next step */
    .flex.flex-wrap.gap-1\.5 { display: none !important; }
    details { display: none !important; }
    a[class*="teal"] { display: none !important; }

    /* Smaller risk bar */
    .h-1\.5 { height: 3px !important; margin-bottom: 6px !important; }

    /* Compact text */
    p.text-sm { font-size: 10px !important; margin-bottom: 4px !important; }
    p.text-xs { font-size: 9px !important; }
    p.font-semibold { font-size: 11px !important; }
  }
</style>

<script>
// ── Scoring model ─────────────────────────────────────────────────────────────
// Each nutrient starts at a baseline. Answers add/subtract risk points.
// Final score 0-10. Thresholds: ≥7 high, 4-6 medium, ≤3 low.

type Nutrient =
  | 'vitaminD' | 'omega3' | 'magnesium' | 'eisen' | 'zink' | 'b12'
