---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const ingredients = await getCollection('enIngredients');
const deIngredients = await getCollection('ingredients');
const products = await getCollection('products');

// Build ingredient list with display names
const ingredientList = [...deIngredients].map(i => {
  const en = ingredients.find(e => e.data.slug === i.data.slug);
  return { slug: i.data.slug, name: en?.data.title ?? i.data.title };
}).sort((a, b) => a.name.localeCompare(b.name));

// Build products JSON for client-side
const productsData = products.map(p => ({
  slug: p.data.slug,
  title: p.data.title,
  vendor: p.data.vendor,
  ingredient: p.data.ingredient,
  ci: (p.data as any).containedIngredients?.map((c: any) => c.slug) ?? [p.data.ingredient],
  ppd: p.data.pricePerDayEur,
  form: p.data.form,
  r: {
    e: p.data.ratings.evidenceForIngredient.score,
    v: p.data.ratings.valueForMoney.score,
    q: p.data.ratings.productQuality.score,
  },
  summary: p.data.summary,
}));
---

<BaseLayout
  title="Supplement Stack Builder — Find the Best Product Combinations | MikroScore"
  description="Build your optimal supplement stack: select your desired ingredients and instantly find the fewest products that cover them all. Compare 230+ products by price, evidence, and quality — free, no signup."
  locale="en"
>
  <div class="max-w-4xl mx-auto px-4 py-10">
    <nav class="text-xs text-slate-400 mb-6">
      <a href="/en" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">Stack Builder</span>
    </nav>

    <div class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-teal-50/40 shadow-sm mb-8">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.07),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(15,23,42,0.04),transparent_28%)]"></div>
      <div class="relative p-6">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-3">Supplement Optimizer</div>
        <h1 class="text-3xl font-bold text-slate-900 mb-2">Stack Builder</h1>
        <p class="text-slate-600">
          Select the ingredients you want. We'll find products that cover multiple — so you take fewer pills and spend less.
        </p>
      </div>
    </div>

    <!-- SEO content -->
    <article class="prose prose-slate max-w-none mb-10">
      <h2 class="text-lg font-semibold text-slate-800">How the Stack Builder works</h2>
      <p>
        Most supplement users take multiple products — one for magnesium, one for omega-3, another for vitamin D. But many supplements contain more than one active ingredient. A quality B-complex might already cover your folate, B12, and B6 needs in a single capsule. A longevity formula could bundle NMN, resveratrol, and TMG together.
      </p>
      <p>
        The MikroScore Stack Builder helps you find these overlaps. Select the ingredients you care about, and our algorithm instantly identifies which products cover multiple ingredients at once — so you can take fewer capsules, spend less, and avoid unnecessary overlap.
      </p>

      <h3 class="text-base font-semibold text-slate-700">What makes this different</h3>
      <p>
        Unlike simple product finders, the Stack Builder uses a <strong>set cover optimization algorithm</strong>. Instead of just listing products that contain your ingredients, it calculates the <em>minimum number of products</em> needed to cover your entire list. Each product is scored by evidence quality (based on RCTs and meta-analyses), price per day, and manufacturing quality — so the recommendations aren't just convenient, they're evidence-informed.
      </p>

      <h3 class="text-base font-semibold text-slate-700">What's in the database</h3>
      <p>
        We currently track <strong>{productsData.length} supplement products</strong> from brands like Life Extension, Thorne, Pure Encapsulations, NOW Foods, Sunday Natural, Jarrow, BIOGENA, and more. Each product has been reviewed for ingredient content, dosage, form, certifications, and value for money. Products with multiple active ingredients are tagged with all contained compounds — making the Stack Builder aware of every overlap.
      </p>

      <h3 class="text-base font-semibold text-slate-700">How to use it</h3>
      <ol>
        <li><strong>Select your ingredients</strong> — click the tags below or use the search box. Pick everything you want in your daily stack.</li>
        <li><strong>Review the optimized stack</strong> — the algorithm suggests the fewest products covering all your selections, with total daily cost.</li>
        <li><strong>Explore alternatives</strong> — below the optimized stack, you'll find all matching products sorted by overlap count, evidence rating, and price.</li>
      </ol>
      <p>
        Everything runs in your browser — no data is sent to any server, no signup required. The tool is free and always will be.
      </p>
    </article>

    <!-- Step 1: Ingredient Selection -->
    <div id="step-select" class="mb-8">
      <h2 class="text-lg font-semibold text-slate-800 mb-3">1. Select your ingredients</h2>
      <div class="mb-3">
        <input
          type="text"
          id="ingredient-search"
          placeholder="Search ingredients…"
          class="w-full max-w-sm border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400"
        />
      </div>
      <div id="ingredient-grid" class="flex flex-wrap gap-2">
        {ingredientList.map(i => (
          <button
            class="ingredient-btn rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-600 hover:border-teal-400 hover:text-teal-700 transition-all cursor-pointer select-none"
            data-slug={i.slug}
          >
            {i.name}
          </button>
        ))}
      </div>
      <div class="mt-3 text-xs text-slate-400">
        Selected: <span id="selected-count" class="font-semibold text-slate-600">0</span>
        <button id="clear-btn" class="ml-3 text-teal-600 hover:text-teal-800 hidden">Clear all</button>
      </div>
    </div>

    <!-- Step 2: Results -->
    <div id="step-results" class="hidden">
      <h2 class="text-lg font-semibold text-slate-800 mb-3">2. Best matches</h2>

      <!-- Optimal stack -->
      <div id="optimal-stack" class="mb-6"></div>

      <!-- All matching products -->
      <h3 class="text-sm font-semibold text-slate-600 mb-2 uppercase tracking-wider">All matching products</h3>
      <div id="all-matches" class="space-y-3"></div>
    </div>
  </div>

  <script define:vars={{ productsData, ingredientList }}>
    const selected = new Set();
    const buttons = document.querySelectorAll('.ingredient-btn');
    const searchInput = document.getElementById('ingredient-search');
    const countSpan = document.getElementById('selected-count');
    const clearBtn = document.getElementById('clear-btn');
    const resultsDiv = document.getElementById('step-results');
    const optimalDiv = document.getElementById('optimal-stack');
    const allMatchesDiv = document.getElementById('all-matches');

    // Toggle ingredient selection
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.slug;
        if (selected.has(slug)) {
          selected.delete(slug);
          btn.classList.remove('bg-teal-100', 'border-teal-400', 'text-teal-800');
          btn.classList.add('bg-white', 'border-slate-200', 'text-slate-600');
        } else {
          selected.add(slug);
          btn.classList.add('bg-teal-100', 'border-teal-400', 'text-teal-800');
          btn.classList.remove('bg-white', 'border-slate-200', 'text-slate-600');
        }
        updateResults();
      });
    });

    // Search filter
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase();
      buttons.forEach(btn => {
        const name = btn.textContent.toLowerCase();
        const slug = btn.dataset.slug;
        btn.style.display = (name.includes(q) || slug.includes(q)) ? '' : 'none';
      });
    });

    // Clear all
    clearBtn.addEventListener('click', () => {
      selected.clear();
      buttons.forEach(btn => {
        btn.classList.remove('bg-teal-100', 'border-teal-400', 'text-teal-800');
        btn.classList.add('bg-white', 'border-slate-200', 'text-slate-600');
      });
      updateResults();
    });

    function updateResults() {
      countSpan.textContent = selected.size;
      clearBtn.classList.toggle('hidden', selected.size === 0);

      if (selected.size === 0) {
        resultsDiv.classList.add('hidden');
        return;
      }

      resultsDiv.classList.remove('hidden');
      const wanted = [...selected];

      // Score products by overlap
      const scored = productsData
        .map(p => {
          const overlap = p.ci.filter(s => wanted.includes(s));
          return { ...p, overlap, overlapCount: overlap.length };
        })
        .filter(p => p.overlapCount > 0)
        .sort((a, b) => {
          // Sort by overlap count desc, then evidence desc, then price asc
          if (b.overlapCount !== a.overlapCount) return b.overlapCount - a.overlapCount;
          if (b.r.e !== a.r.e) return b.r.e - a.r.e;
          return a.ppd - b.ppd;
        });

      // Greedy set cover for optimal stack
      const stack = [];
      const uncovered = new Set(wanted);
      const usedProducts = new Set();

      while (uncovered.size > 0) {
        let best = null;
        let bestCover = 0;

        for (const p of scored) {
          if (usedProducts.has(p.slug)) continue;
          const covers = p.ci.filter(s => uncovered.has(s)).length;
          if (covers > bestCover || (covers === bestCover && best && p.r.e > best.r.e)) {
            best = p;
            bestCover = covers;
          }
        }

        if (!best || bestCover === 0) break;

        stack.push({ ...best, covers: best.ci.filter(s => uncovered.has(s)) });
        usedProducts.add(best.slug);
        best.ci.filter(s => uncovered.has(s)).forEach(s => uncovered.delete(s));
      }

      // Render optimal stack
      const totalPpd = stack.reduce((sum, p) => sum + p.ppd, 0);
      const coveredSlugs = new Set(stack.flatMap(p => p.covers));
      const missingIngredients = wanted.filter(s => !coveredSlugs.has(s));

      const getName = slug => ingredientList.find(i => i.slug === slug)?.name ?? slug;

      optimalDiv.innerHTML = `
        <div class="rounded-2xl border border-teal-200 bg-teal-50/50 p-5 mb-4">
          <div class="flex items-center justify-between mb-3">
            <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700">Optimized Stack</div>
            <div class="text-sm font-semibold text-slate-800">
              ${stack.length} product${stack.length !== 1 ? 's' : ''} · €${totalPpd.toFixed(2)}/day
            </div>
          </div>
          ${stack.map(p => `
            <div class="bg-white rounded-xl border border-slate-200 px-4 py-3 mb-2">
              <div class="flex items-center justify-between">
                <div>
                  <a href="/en/products/${p.slug}" class="text-sm font-medium text-slate-800 hover:text-teal-700 no-underline">${p.title}</a>
                  <span class="text-xs text-slate-400 ml-2">${p.vendor}</span>
                </div>
                <div class="text-xs text-slate-500">€${p.ppd.toFixed(2)}/day</div>
              </div>
              <div class="flex flex-wrap gap-1 mt-2">
                ${p.covers.map(s => `<span class="rounded-full bg-teal-100 text-teal-800 px-2 py-0.5 text-[10px] font-medium">${getName(s)}</span>`).join('')}
                ${p.ci.filter(s => !wanted.includes(s)).map(s => `<span class="rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-[10px]">+ ${getName(s)}</span>`).join('')}
              </div>
            </div>
          `).join('')}
          ${missingIngredients.length > 0 ? `
            <div class="mt-3 text-xs text-amber-700 bg-amber-50 rounded-lg px-3 py-2 border border-amber-200">
              ⚠️ No matching products found for: ${missingIngredients.map(getName).join(', ')}
              — you may need separate single-ingredient products.
            </div>
          ` : `
            <div class="mt-3 text-xs text-teal-700 bg-teal-50 rounded-lg px-3 py-2 border border-teal-200">
              ✅ All ${wanted.length} ingredients covered!
            </div>
          `}
        </div>
      `;

      // Render all matching products (multi-ingredient first)
      const multiMatches = scored.filter(p => p.overlapCount >= 2);
      const singleMatches = scored.filter(p => p.overlapCount === 1).slice(0, 20);

      allMatchesDiv.innerHTML = `
        ${multiMatches.length > 0 ? `
          <div class="text-xs font-semibold text-slate-500 mb-2">Multi-ingredient matches (${multiMatches.length})</div>
          ${multiMatches.map(p => renderProduct(p, wanted)).join('')}
        ` : ''}
        <div class="text-xs font-semibold text-slate-500 mb-2 mt-4">Single-ingredient matches (top ${singleMatches.length})</div>
        ${singleMatches.map(p => renderProduct(p, wanted)).join('')}
      `;
    }

    function renderProduct(p, wanted) {
      const getName = slug => ingredientList.find(i => i.slug === slug)?.name ?? slug;
      const stars = (n) => '★'.repeat(Math.round(n / 2)) + '☆'.repeat(5 - Math.round(n / 2));
      return `
        <div class="bg-white rounded-xl border border-slate-200 px-4 py-3 hover:border-teal-300 transition-all">
          <div class="flex items-center justify-between">
            <div>
              <a href="/en/products/${p.slug}" class="text-sm font-medium text-slate-800 hover:text-teal-700 no-underline">${p.title}</a>
              <span class="text-xs text-slate-400 ml-2">${p.vendor}</span>
            </div>
            <div class="text-right">
              <div class="text-xs font-medium text-slate-700">€${p.ppd.toFixed(2)}/day</div>
              <div class="text-[10px] text-amber-500" title="Evidence: ${p.r.e}/10">${stars(p.r.e)}</div>
            </div>
          </div>
          <div class="flex flex-wrap gap-1 mt-2">
            ${p.overlap.map(s => `<span class="rounded-full bg-teal-100 text-teal-800 px-2 py-0.5 text-[10px] font-medium">${getName(s)}</span>`).join('')}
            ${p.ci.filter(s => !wanted.includes(s)).map(s => `<span class="rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-[10px]">+ ${getName(s)}</span>`).join('')}
          </div>
        </div>
      `;
    }
  </script>
</BaseLayout>
