---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VerdictBadge from '../../../components/VerdictBadge.astro';
import ClaimContextModule from '../../../components/ClaimContextModule.astro';
import ClaimCheckIllustration from '../../../components/illustrations/ClaimCheckIllustration.astro';
import { getCollection, render } from 'astro:content';
import { getEntityById, getStudyExternalUrl } from '../../../lib/graph/index.ts';

export async function getStaticPaths() {
  const claims = await getCollection('enClaims');
  return claims.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

function normalizeUrl(url: string) {
  return url.replace(/\/$/, '');
}

const studyUrls = new Set(
  (d.studyIds ?? [])
    .map((id) => getEntityById(id))
    .map((entity) => entity ? getStudyExternalUrl(entity) : undefined)
    .filter((url): url is string => Boolean(url))
    .map(normalizeUrl)
);

const nonStudySources = d.sources.filter((source) => !studyUrls.has(normalizeUrl(source.url)));
---

<BaseLayout
  title={`Claims Check: "${d.title}"`}
  description={d.summary}
  locale="en"
  hreflang={{ en: `/en/claims/${d.slug}` }}
>
  <div class="max-w-3xl mx-auto px-4 py-10">

    <nav class="text-xs text-slate-400 mb-6">
      <a href="/en" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/en/claims" class="hover:text-teal-600">Claims Check</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">{d.title}</span>
    </nav>

    <!-- Illustration banner -->
    <div class="rounded-2xl overflow-hidden border border-slate-100 bg-gradient-to-br from-slate-50 via-white to-teal-50/40 mb-6 px-4 py-3">
      <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-1.5">Marketing claims, evidence checked</div>
      <ClaimCheckIllustration />
    </div>

    <p class="text-sm text-slate-500 mb-2">Claims Check</p>
    <h1 class="text-2xl font-bold text-slate-900 mb-4">"{d.title}"</h1>

    <div class="flex items-center gap-3 mb-6">
      <VerdictBadge verdict={d.verdict} note={d.verdictNote} />
    </div>

    <ClaimContextModule claimSlug={d.slug} ingredientSlug={d.ingredient} claimContext={d.claimContext} studyIds={d.studyIds} locale="en" />

    <article class="prose max-w-none mb-10">
      <Content />
    </article>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-8 text-xs text-amber-800 leading-5">
      <strong>Editorial notice:</strong> This page provides an editorial assessment of a widely circulated claim. It does not constitute an approved health claim under Regulation (EC) No 1924/2006 and is not a substitute for medical advice. Statements about studies, biomarkers, or mechanisms are to be understood as evidence appraisal — not as recommendations to treat, alleviate, or prevent any disease.
    </div>

    <!-- Sources -->
    {nonStudySources.length > 0 && (
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
        <p class="text-sm font-semibold text-slate-700 mb-3">Sources</p>
        <ul class="space-y-2">
          {nonStudySources.map(source => (
            <li class="text-sm">
              <a href={source.url} target="_blank" rel="noopener noreferrer"
                 class="text-teal-600 hover:underline">
                {source.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mt-8 text-xs text-amber-800 leading-5">
      <strong>Legal context:</strong> Even where individual studies show positive effects, this does not automatically permit health-related advertising claims. What is relevant for foods and food supplements are the health claims approved in the EU and their conditions of use.
    </div>

  </div>
</BaseLayout>
