---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VerdictBadge from '../../../components/VerdictBadge.astro';
import ClaimCheckIllustration from '../../../components/illustrations/ClaimCheckIllustration.astro';
import { getCollection } from 'astro:content';

const claims = await getCollection('enClaims');
const sorted = [...claims].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout
  title="Claims Check | MikroScore"
  description="Supplement marketing claims checked against studies, EFSA regulation, and sound evidence."
  locale="en"
  hreflang={{ de: '/claims', en: '/en/claims' }}
>
  <div class="max-w-5xl mx-auto px-4 py-10">

    <nav class="text-xs text-slate-400 mb-6">
      <a href="/en" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">Claims Check</span>
    </nav>

    <!-- Illustration banner -->
    <div class="rounded-2xl overflow-hidden border border-slate-100 bg-gradient-to-br from-slate-50 via-white to-teal-50/40 mb-8 px-4 py-3">
      <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-1.5">Marketing claims, evidence checked</div>
      <ClaimCheckIllustration />
    </div>

    <div class="mb-6">
      <h1 class="text-3xl font-bold text-slate-900 mb-3">Claims Check</h1>
      <p class="text-slate-600 max-w-2xl mb-4">
        Supplement brands make bold claims — "boosts energy", "extends lifespan", "reduces biological age". We take these claims at face value and check what the evidence actually supports: studies, EFSA assessments, and regulatory reality.
      </p>
      <p class="text-sm text-slate-500">
        {sorted.length} claim{sorted.length !== 1 ? 's' : ''} reviewed.
      </p>
    </div>

    <!-- Verdict legend -->
    <div class="flex flex-wrap gap-2 mb-8">
      {[
        { label: 'Supported', color: 'bg-emerald-100 text-emerald-700 border-emerald-200' },
        { label: 'Exaggerated', color: 'bg-yellow-100 text-yellow-700 border-yellow-200' },
        { label: 'False', color: 'bg-red-100 text-red-700 border-red-200' },
        { label: 'Too early to say', color: 'bg-slate-100 text-slate-600 border-slate-200' },
      ].map(({ label, color }) => (
        <span class:list={['text-xs font-medium px-2.5 py-1 rounded-full border', color]}>{label}</span>
      ))}
      <a href="/en/methodology#claims-check-verdicts" class="text-xs text-slate-400 hover:text-teal-600 self-center ml-1 no-underline">How we assess →</a>
    </div>

    {sorted.length === 0 ? (
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
        <p class="text-slate-500 mb-2">English claims checks are being added.</p>
        <p class="text-xs text-slate-400 mb-4">German claims checks are available in the meantime.</p>
        <a href="/claims" class="inline-block text-sm text-teal-600 hover:underline">Browse German claims →</a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {sorted.map(claim => (
          <a
            href={`/en/claims/${claim.data.slug}`}
            class="rounded-xl border border-slate-200 bg-white p-5 no-underline hover:border-teal-300 hover:shadow-sm transition-all"
          >
            <div class="mb-3">
              <VerdictBadge verdict={claim.data.verdict} hideNote={true} />
            </div>
            <h2 class="font-semibold text-slate-800 text-sm leading-6 mb-2">"{claim.data.title}"</h2>
            <p class="text-xs text-slate-500 leading-relaxed">{claim.data.summary}</p>
          </a>
        ))}
      </div>
    )}

  </div>
</BaseLayout>
