---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RatingBar from '../../../components/RatingBar.astro';
import VerdictBadge from '../../../components/VerdictBadge.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import LegalNotice from '../../../components/LegalNotice.astro';
import ProductTransparencyIllustration from '../../../components/illustrations/ProductTransparencyIllustration.astro';
import { getCollection, render } from 'astro:content';
import { compositeScore } from '../../../utils/scoring';

export async function getStaticPaths() {
  const products = await getCollection('enProducts');
  return products.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const score = compositeScore(d.ratings);

const allProducts = await getCollection('enProducts');
const ingredients = await getCollection('enIngredients');
const ingredient = ingredients.find(i => i.data.slug === d.ingredient);
const siblingProducts = allProducts
  .filter(p => p.data.ingredient === d.ingredient && p.data.slug !== d.slug)
  .sort((a, b) => compositeScore(b.data.ratings) - compositeScore(a.data.ratings));

const formLabel: Record<string, string> = {
  capsule: 'Capsule', powder: 'Powder', liquid: 'Liquid',
  gummy: 'Gummy', softgel: 'Softgel', tablet: 'Tablet',
};

const verdictGradient: Record<string, string> = {
  'empfehlenswert':       'from-teal-400 to-emerald-500',
  'akzeptabel':           'from-amber-400 to-orange-400',
  'nicht-empfehlenswert': 'from-red-400 to-rose-500',
};

const verdictScoreColor: Record<string, string> = {
  'empfehlenswert':       'text-teal-600',
  'akzeptabel':           'text-amber-600',
  'nicht-empfehlenswert': 'text-red-600',
};

const certLabel: Record<string, string> = {
  'informed-sport':     'Informed Sport',
  'informed-choice':    'Informed Choice',
  'nsf':                'NSF Certified',
  'usp':                'USP Verified',
  'labdoor-verified':   'Labdoor Verified',
  'oekotest':           'Öko-Test',
  'stiftung-warentest': 'Stiftung Warentest',
};

const descriptionBase = `${d.title} review: ${d.summary} From €${d.pricePerDayEur.toFixed(2)}/day.`;
const pageDescription = descriptionBase.length > 155
  ? `${descriptionBase.slice(0, 152)}…`
  : descriptionBase;

const ratingLabels: Record<string, string> = {
  evidenceForIngredient: 'Evidence for ingredient',
  valueForMoney:         'Value for money',
  productQuality:        'Product quality',
  labelHonesty:          'Label honesty',
  thirdPartyTesting:     'Third-party testing',
};
---

<BaseLayout
  title={d.title}
  description={pageDescription}
  locale="en"
  hreflang={{ de: `/produkte/${d.slug}`, en: `/en/products/${d.slug}` }}
>
  <div class="max-w-3xl mx-auto px-4 py-10">

    <!-- Breadcrumb -->
    <nav class="text-xs text-slate-400 mb-6">
      <a href="/en" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/en/products" class="hover:text-teal-600">Products</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">{d.title}</span>
    </nav>

    <!-- Illustration banner -->
    <div class="rounded-2xl overflow-hidden border border-slate-100 bg-gradient-to-br from-slate-50 via-white to-teal-50/40 mb-6 px-4 py-3">
      <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-1.5">Transparent product review</div>
      <ProductTransparencyIllustration />
    </div>

    <!-- Hero -->
    <div class="mb-8">
      <p class="text-sm text-slate-500 mb-1">Product Review</p>
      <h1 class="text-2xl font-bold text-slate-900 mb-2">{d.title}</h1>
      <p class="text-sm text-slate-500">{d.vendor} · {formLabel[d.form] ?? d.form} · {d.doseMg} mg</p>
    </div>

    <!-- Specs grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
      <div class="bg-slate-50 rounded-xl p-4 text-center">
        <p class="text-xs text-slate-400 mb-1">Price/day</p>
        <p class="text-lg font-bold text-slate-900">€{d.pricePerDayEur.toFixed(2)}</p>
      </div>
      <div class="bg-slate-50 rounded-xl p-4 text-center">
        <p class="text-xs text-slate-400 mb-1">Dose</p>
        <p class="text-lg font-bold text-slate-900">{d.doseMg} mg</p>
      </div>
      <div class="bg-slate-50 rounded-xl p-4 text-center">
        <p class="text-xs text-slate-400 mb-1">Servings/pack</p>
        <p class="text-lg font-bold text-slate-900">{d.servingsPerPack}</p>
      </div>
      <div class="bg-slate-50 rounded-xl p-4 text-center">
        <p class="text-xs text-slate-400 mb-1">Pack price</p>
        <p class="text-lg font-bold text-slate-900">€{d.priceEur.toFixed(2)}</p>
      </div>
    </div>

    <!-- Certifications -->
    {d.certifications.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6">
        {d.certifications.map(cert => (
          <span class="text-xs bg-teal-50 border border-teal-200 text-teal-700 rounded-full px-3 py-1">
            {certLabel[cert] ?? cert}
          </span>
        ))}
      </div>
    )}

    <!-- Score + Verdict -->
    <div class:list={[
      'rounded-xl p-5 mb-8 text-white bg-gradient-to-br',
      verdictGradient[d.verdict] ?? 'from-slate-400 to-slate-500',
    ]}>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest opacity-75 mb-1">Transparency Index</p>
          <p class="text-4xl font-bold">{score.toFixed(1)}<span class="text-lg font-normal opacity-75">/10</span></p>
        </div>
        <VerdictBadge verdict={d.verdict} note={d.verdictNote} />
      </div>
    </div>

    <!-- Rating breakdown -->
    <div class="bg-white border border-slate-200 rounded-xl p-5 mb-8">
      <h2 class="text-sm font-semibold text-slate-700 mb-4">Rating breakdown</h2>
      <div class="space-y-4">
        {(Object.entries(d.ratings) as [string, { score: number; explanation: string }][]).map(([key, val]) => (
          <RatingBar
            label={ratingLabels[key] ?? key}
            score={val.score}
            explanation={val.explanation}
          />
        ))}
      </div>
    </div>

    <!-- Article content -->
    <article class="prose max-w-none mb-10">
      <Content />
    </article>

    <!-- FAQ -->
    {d.faq && d.faq.length > 0 && (
      <div class="mb-8">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">FAQ</h2>
        <div class="space-y-4">
          {d.faq.map(item => (
            <div class="bg-slate-50 rounded-xl p-5">
              <p class="font-semibold text-slate-800 mb-2">{item.question}</p>
              <p class="text-sm text-slate-600">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Sibling products -->
    {siblingProducts.length > 0 && (
      <div class="mb-8">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Other {ingredient?.data.title ?? d.ingredient} products</h2>
        <div class="space-y-3">
          {siblingProducts.map(p => {
            const s = compositeScore(p.data.ratings);
            return (
              <a href={`/en/products/${p.data.slug}`}
                 class="flex items-center justify-between bg-white border border-slate-200 rounded-xl px-5 py-4 hover:border-teal-400 transition-all no-underline group gap-4">
                <p class="font-medium text-slate-800 group-hover:text-teal-700 text-sm">{p.data.title}</p>
                <div class="flex items-center gap-3 shrink-0">
                  <span class="text-sm font-semibold text-slate-700">{s.toFixed(1)}<span class="text-xs font-normal text-slate-400">/10</span></span>
                  <VerdictBadge verdict={p.data.verdict} />
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

    <!-- Linked ingredient dossier -->
    {ingredient && (
      <div class="bg-teal-50 border border-teal-200 rounded-xl p-5 mb-6">
        <p class="text-sm font-semibold text-teal-900 mb-1">Ingredient dossier</p>
        <p class="text-sm text-teal-700 mb-3">{ingredient.data.summary}</p>
        <a href={`/en/ingredients/${ingredient.data.slug}`} class="text-sm font-medium text-teal-600 hover:text-teal-800 no-underline">
          Read full dossier: {ingredient.data.title} →
        </a>
      </div>
    )}

    <!-- Legal notice -->
    <LegalNotice />

  </div>
</BaseLayout>
