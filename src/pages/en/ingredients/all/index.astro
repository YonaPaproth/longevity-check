---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../../../components/EvidenceBadge.astro';
import EvidenceResearchIllustration from '../../../../components/illustrations/EvidenceResearchIllustration.astro';
import { getCollection } from 'astro:content';

const ingredients = await getCollection('enIngredients');

const categoryLabels: Record<string, string> = {
  'nad-precursors': 'NAD Precursors',
  'senolytics':     'Senolytics',
  'antioxidants':   'Antioxidants',
  'adaptogens':     'Adaptogens',
  'metabolic':      'Metabolic',
  'other':          'Other',
};

const evidenceLabels: Record<string, string> = {
  '1': 'Strong Evidence',
  '2': 'Moderate Evidence',
  '3': 'Weak Evidence',
  '4': 'Animal Studies Only',
  '5': 'No Studies',
};

const safetyLabels: Record<string, string> = {
  'safe': 'Well studied',
  'likely-safe': 'Likely safe',
  'caution': 'Use with caution',
  'insufficient-data': 'Insufficient data',
};

const categories = [...new Set(ingredients.map(i => i.data.category))].sort();
const evidenceLevels = [...new Set(ingredients.map(i => i.data.evidenceLevel))].sort();
---

<BaseLayout
  title="All Ingredient Dossiers | MikroScore"
  description="All supplements at a glance: NMN, Omega-3, Ashwagandha, Curcumin & 110+ ingredients — evidence-based ratings."
  locale="en"
  hreflang={{ de: '/wirkstoffe/alle', en: '/en/ingredients/all' }}
>
  <div class="max-w-5xl mx-auto px-4 py-12">

    <!-- Header with illustration -->
    <div class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-teal-50/40 shadow-sm mb-8">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.07),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(15,23,42,0.04),transparent_28%)]"></div>
      <div class="relative p-6 md:p-8">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-3">Evidence-Based Ingredient Research</div>
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div>
            <div class="flex items-baseline gap-3 mb-2">
              <h1 class="text-3xl font-bold text-slate-900">Ingredient Dossiers</h1>
              <span class="text-sm text-slate-400">{ingredients.length} ingredients</span>
            </div>
            <p class="text-slate-600 max-w-xl">What do the studies really say? Each dossier with evidence level, safety rating, and EU regulatory status.</p>
          </div>
          <div class="w-full md:w-72 shrink-0">
            <EvidenceResearchIllustration />
          </div>
        </div>
      </div>
    </div>

    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-400 mb-4">
      <a href="/en/ingredients" class="hover:text-teal-600">Ingredients</a>
      <span class="mx-2">›</span>
      <span class="text-slate-600">All Ingredients</span>
    </nav>

    <!-- Filter bar -->
    <div class="bg-white border border-slate-200 rounded-xl p-4 mb-6 space-y-3">

      <input
        id="search"
        type="search"
        placeholder="Search ingredient…"
        class="w-full text-sm border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-teal-400"
      />

      <div class="flex flex-wrap gap-2">
        <button data-filter="category" data-value="all"
          class="filter-chip active text-xs rounded-full px-3 py-1 border font-medium transition-colors border-teal-500 bg-teal-500 text-white">
          All Categories
        </button>
        {categories.map(cat => (
          <button data-filter="category" data-value={cat}
            class="filter-chip text-xs rounded-full px-3 py-1 border font-medium transition-colors border-slate-300 bg-white text-slate-600 hover:border-teal-400 hover:text-teal-700">
            {categoryLabels[cat] ?? cat}
          </button>
        ))}
      </div>

      <div class="flex flex-wrap gap-2">
        <button data-filter="evidence" data-value="all"
          class="filter-chip active text-xs rounded-full px-3 py-1 border font-medium transition-colors border-teal-500 bg-teal-500 text-white">
          All Evidence Levels
        </button>
        {evidenceLevels.map(lvl => (
          <button data-filter="evidence" data-value={lvl}
            class="filter-chip text-xs rounded-full px-3 py-1 border font-medium transition-colors border-slate-300 bg-white text-slate-600 hover:border-teal-400 hover:text-teal-700">
            {evidenceLabels[lvl] ?? lvl}
          </button>
        ))}
      </div>

    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-4 text-xs text-amber-800 leading-5">
      <strong>Editorial note:</strong> The summaries on this overview page condense study evidence and regulatory context. They are not health claims under EU Regulation No 1924/2006 and not recommendations for the treatment, alleviation, or prevention of disease.
    </div>

    <p id="results-count" class="text-xs text-slate-400 mb-4">{ingredients.length} entries</p>

    <div id="grid" class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {ingredients.map(ing => (
        <a
          href={`/en/ingredients/${ing.data.slug}`}
          data-category={ing.data.category}
          data-evidence={ing.data.evidenceLevel}
          data-title={ing.data.title.toLowerCase()}
          data-aliases={(ing.data.aliases ?? []).join(' ').toLowerCase()}
          class="ingredient-card bg-white rounded-xl border border-slate-200 p-6 hover:border-teal-400 hover:shadow-sm transition-all no-underline group"
        >
          <div class="flex justify-between items-start mb-3">
            <h2 class="font-semibold text-slate-800 group-hover:text-teal-700 pr-2">{ing.data.title}</h2>
            <EvidenceBadge locale="en" level={ing.data.evidenceLevel} />
          </div>
          <p class="text-sm text-slate-500 mb-4 leading-relaxed">{ing.data.summary}</p>
          <div class="flex gap-2 text-xs flex-wrap">
            <span class="rounded-full px-2 py-0.5 font-medium bg-slate-100 text-slate-600">
              {categoryLabels[ing.data.category] ?? ing.data.category}
            </span>
            <span class:list={[
              'rounded-full px-2 py-0.5 font-medium',
              ing.data.efsa_health_claims_allowed
                ? 'bg-emerald-100 text-emerald-700'
                : 'bg-slate-100 text-slate-500'
            ]}>
              EFSA: {ing.data.efsa_health_claims_allowed ? 'approved' : 'no claims'}
            </span>
            <span class:list={[
              'rounded-full px-2 py-0.5 font-medium',
              ing.data.safety_rating === 'safe' ? 'bg-emerald-100 text-emerald-700' :
              ing.data.safety_rating === 'likely-safe' ? 'bg-amber-100 text-amber-700' :
              ing.data.safety_rating === 'caution' ? 'bg-orange-100 text-orange-700' :
              'bg-slate-100 text-slate-500'
            ]}>
              {safetyLabels[ing.data.safety_rating] ?? ing.data.safety_rating}
            </span>
          </div>
        </a>
      ))}
    </div>

    <p id="empty-state" class="hidden text-center text-slate-400 py-16 text-sm">
      No ingredient found. Try a different filter.
    </p>

  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search') as HTMLInputElement;
  const grid = document.getElementById('grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.ingredient-card'));
  const countEl = document.getElementById('results-count')!;
  const emptyEl = document.getElementById('empty-state')!;

  let activeCategory = 'all';
  let activeEvidence = 'all';

  function applyFilters() {
    const q = searchInput.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach(card => {
      const matchCat = activeCategory === 'all' || card.dataset.category === activeCategory;
      const matchEv  = activeEvidence === 'all' || card.dataset.evidence === activeEvidence;
      const matchQ   = !q || card.dataset.title!.includes(q) || card.dataset.aliases!.includes(q);
      const show = matchCat && matchEv && matchQ;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });

    countEl.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
    emptyEl.classList.toggle('hidden', visible > 0);
  }

  document.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      const filterGroup = btn.dataset.filter!;
      const value = btn.dataset.value!;

      document.querySelectorAll<HTMLButtonElement>(`.filter-chip[data-filter="${filterGroup}"]`).forEach(b => {
        b.classList.remove('active', 'border-teal-500', 'bg-teal-500', 'text-white');
        b.classList.add('border-slate-300', 'bg-white', 'text-slate-600');
      });

      btn.classList.add('active', 'border-teal-500', 'bg-teal-500', 'text-white');
      btn.classList.remove('border-slate-300', 'bg-white', 'text-slate-600');

      if (filterGroup === 'category') activeCategory = value;
      if (filterGroup === 'evidence') activeEvidence = value;

      applyFilters();
    });
  });

  searchInput.addEventListener('input', applyFilters);
</script>
