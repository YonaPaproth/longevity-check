---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../../../components/EvidenceBadge.astro';
import { getCollection } from 'astro:content';
import { readFileSync } from 'fs';

export async function getStaticPaths() {
  const indexData = JSON.parse(readFileSync('data/index.json', 'utf-8'));
  return (indexData.symptoms as string[]).map(id => ({ params: { id } }));
}

const { id } = Astro.params;
const symptomEntity = JSON.parse(readFileSync(`data/entities/symptoms/${id}.json`, 'utf-8'));
const rels = JSON.parse(readFileSync(`data/relations/by-entity/${id}.json`, 'utf-8'));
const enLabels = JSON.parse(readFileSync('data/i18n/kg-entities.en.json', 'utf-8'));

const ingredientIds = rels.relations
  .filter((r: any) => r.relation === 'wird_eingesetzt_fuer' && r.direction === 'incoming')
  .map((r: any) => r.target);

const allIngredients = await getCollection('enIngredients');
const ingredientMap = new Map(allIngredients.map(i => [i.data.slug, i.data]));

const matched = ingredientIds
  .map((slug: string) => ingredientMap.get(slug))
  .filter(Boolean)
  .sort((a: any, b: any) => parseInt(a.evidenceLevel) - parseInt(b.evidenceLevel));

const label = enLabels[id!] || symptomEntity.name;

const safetyLabel: Record<string, string> = {
  'safe': 'Safe', 'likely-safe': 'Likely safe',
  'caution': 'Caution', 'insufficient-data': 'Insufficient data',
};
const safetyStyle: Record<string, string> = {
  'safe': 'bg-emerald-100 text-emerald-800', 'likely-safe': 'bg-yellow-100 text-yellow-800',
  'caution': 'bg-orange-100 text-orange-800', 'insufficient-data': 'bg-slate-100 text-slate-700',
};
---

<BaseLayout
  title={`Research Area: ${label} — Studied Ingredients`}
  description={`${matched.length} ingredients studied for effects on ${label} — sorted by evidence strength.`}
  locale="en"
  hreflang={{ de: `/wirkstoffe/nach-wirkung/${id}`, en: `/en/ingredients/by-effect/${id}` }}
>
  <div class="max-w-4xl mx-auto px-4 py-12">

    <nav class="text-sm text-slate-400 mb-6">
      <a href="/en/ingredients" class="hover:text-teal-600">Ingredients</a>
      <span class="mx-2">›</span>
      <a href="/en/ingredients/by-effect" class="hover:text-teal-600">By Research Area</a>
      <span class="mx-2">›</span>
      <span class="text-slate-600">{label}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-2">Research Area: {label}</h1>
      <p class="text-slate-600">{matched.length} ingredients studied for effects on {label} — sorted by evidence strength.</p>
    </div>

    <div class="space-y-3">
      {matched.map((ing: any) => (
        <a href={`/en/ingredients/${ing.slug}`} class="group flex items-center justify-between bg-white border border-slate-200 rounded-xl px-5 py-4 hover:border-teal-300 hover:shadow-sm transition-all">
          <div class="flex items-center gap-4">
            <EvidenceBadge locale="en" level={ing.evidenceLevel} />
            <div>
              <h2 class="font-semibold text-slate-900 group-hover:text-teal-700 transition-colors">{ing.title}</h2>
              <p class="text-sm text-slate-500 line-clamp-1">{ing.summary}</p>
            </div>
          </div>
          <div class="flex items-center gap-3 shrink-0 ml-4">
            <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${safetyStyle[ing.safety_rating] || 'bg-slate-100 text-slate-700'}`}>
              {safetyLabel[ing.safety_rating] || ing.safety_rating}
            </span>
            {ing.efsa_health_claims_allowed && (
              <span class="text-xs font-medium bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">EFSA ✓</span>
            )}
          </div>
        </a>
      ))}
    </div>

    {matched.length === 0 && (
      <div class="text-center py-12 text-slate-400">No ingredients found for this research area.</div>
    )}

  </div>
</BaseLayout>
