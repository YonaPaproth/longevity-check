---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import { getCollection } from 'astro:content';

const ingredients = await getCollection('enIngredients');
const sorted = [...ingredients].sort((a, b) =>
  Number(a.data.evidenceLevel) - Number(b.data.evidenceLevel) ||
  a.data.title.localeCompare(b.data.title, 'en')
);
---

<BaseLayout
  title="Ingredient Dossiers"
  description="Evidence-based dossiers for longevity supplements — rated by study quality, EFSA status, and safety."
  locale="en"
  hreflang={{ de: '/wirkstoffe', en: '/en/ingredients' }}
>
  <div class="max-w-5xl mx-auto px-4 py-10">

    <nav class="text-xs text-slate-400 mb-6">
      <a href="/en" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">Ingredients</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-3">Ingredient Dossiers</h1>
      <p class="text-slate-600 max-w-2xl">
        {sorted.length} ingredient{sorted.length !== 1 ? 's' : ''} rated by study quality, EFSA health claim status, and safety. Evidence level 1 = strongest (multiple consistent RCTs in humans).
      </p>
    </div>

    {sorted.length === 0 ? (
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
        <p class="text-slate-500">English ingredient dossiers are being added. Check back soon.</p>
        <a href="/wirkstoffe" class="inline-block mt-4 text-sm text-teal-600 hover:underline">Read German dossiers →</a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {sorted.map(ing => (
          <a
            href={`/en/ingredients/${ing.data.slug}`}
            class="bg-white rounded-xl border border-slate-200 p-5 hover:border-teal-400 hover:shadow-sm transition-all no-underline group"
          >
            <div class="flex justify-between items-start mb-3">
              <h2 class="font-semibold text-slate-800 group-hover:text-teal-700 text-sm pr-2">{ing.data.title}</h2>
              <EvidenceBadge level={ing.data.evidenceLevel} showLabel={false} />
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">{ing.data.summary}</p>
          </a>
        ))}
      </div>
    )}

  </div>
</BaseLayout>
