---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import EvidenceResearchIllustration from '../../../components/illustrations/EvidenceResearchIllustration.astro';
import { getCollection } from 'astro:content';

const ingredients = await getCollection('enIngredients');
const sorted = [...ingredients].sort((a, b) =>
  Number(a.data.evidenceLevel) - Number(b.data.evidenceLevel) ||
  a.data.title.localeCompare(b.data.title, 'en')
);
---

<BaseLayout
  title="Ingredient Dossiers | MikroScore"
  description="Evidence-based dossiers for longevity supplement ingredients — rated by study quality, EFSA status, and safety profile."
  locale="en"
  hreflang={{ de: '/wirkstoffe', en: '/en/ingredients' }}
>
  <div class="max-w-5xl mx-auto px-4 py-10">

    <nav class="text-xs text-slate-400 mb-6">
      <a href="/en" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">Ingredients</span>
    </nav>

    <!-- Illustration banner -->
    <div class="rounded-2xl overflow-hidden border border-slate-100 bg-gradient-to-br from-slate-50 via-white to-teal-50/40 mb-8 px-4 py-3">
      <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-1.5">Evidence-based ingredient research</div>
      <EvidenceResearchIllustration />
    </div>

    <div class="mb-6">
      <h1 class="text-3xl font-bold text-slate-900 mb-3">Ingredient Dossiers</h1>
      <p class="text-slate-600 max-w-2xl">
        {sorted.length} ingredient{sorted.length !== 1 ? 's' : ''} rated by study quality, EFSA health claim status, and safety profile. Sorted by evidence strength — level 1 means multiple consistent human RCTs, level 5 means no credible human evidence.
      </p>
    </div>

    <!-- Evidence level legend -->
    <div class="flex flex-wrap gap-2 mb-8">
      {[
        { level: '1', label: 'Strong', color: 'bg-emerald-100 text-emerald-700 border-emerald-200' },
        { level: '2', label: 'Moderate', color: 'bg-lime-100 text-lime-700 border-lime-200' },
        { level: '3', label: 'Limited', color: 'bg-yellow-100 text-yellow-700 border-yellow-200' },
        { level: '4', label: 'Weak', color: 'bg-orange-100 text-orange-700 border-orange-200' },
        { level: '5', label: 'None', color: 'bg-red-100 text-red-700 border-red-200' },
      ].map(({ level, label, color }) => (
        <span class:list={['text-xs font-medium px-2.5 py-1 rounded-full border', color]}>
          {level} — {label}
        </span>
      ))}
      <a href="/en/methodology" class="text-xs text-slate-400 hover:text-teal-600 self-center ml-1 no-underline">What do these mean? →</a>
    </div>

    {sorted.length === 0 ? (
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 text-center">
        <p class="text-slate-500 mb-2">English ingredient dossiers are being added.</p>
        <p class="text-xs text-slate-400 mb-4">German dossiers are available in the meantime.</p>
        <a href="/wirkstoffe" class="inline-block text-sm text-teal-600 hover:underline">Browse German dossiers →</a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {sorted.map(ing => (
          <a
            href={`/en/ingredients/${ing.data.slug}`}
            class="bg-white rounded-xl border border-slate-200 p-5 hover:border-teal-400 hover:shadow-sm transition-all no-underline group"
          >
            <div class="flex justify-between items-start mb-3">
              <h2 class="font-semibold text-slate-800 group-hover:text-teal-700 text-sm pr-2">{ing.data.title}</h2>
              <EvidenceBadge locale="en" level={ing.data.evidenceLevel} showLabel={false} />
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">{ing.data.summary}</p>
          </a>
        ))}
      </div>
    )}

  </div>
</BaseLayout>
