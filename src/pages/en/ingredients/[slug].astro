---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import VerdictBadge from '../../../components/VerdictBadge.astro';
import EvidenceResearchIllustration from '../../../components/illustrations/EvidenceResearchIllustration.astro';
import { getCollection, render } from 'astro:content';
import { compositeScore } from '../../../utils/scoring';

export async function getStaticPaths() {
  const ingredients = await getCollection('enIngredients');
  return ingredients.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const allProducts = await getCollection('enProducts');
const linkedProducts = allProducts.filter(p => p.data.ingredient === d.slug);

const checkSlugs = new Set(['vitamin-d3-k2', 'omega-3', 'magnesium', 'zinc', 'vitamin-b12']);

const safetyLabel: Record<string, string> = {
  'safe':               'Safe',
  'likely-safe':        'Likely safe',
  'caution':            'Use with caution',
  'insufficient-data':  'Insufficient data',
};

const safetyStyle: Record<string, string> = {
  'safe':               'bg-emerald-100 text-emerald-800',
  'likely-safe':        'bg-yellow-100 text-yellow-800',
  'caution':            'bg-orange-100 text-orange-800',
  'insufficient-data':  'bg-slate-100 text-slate-700',
};

const descriptionBase = `${d.title} review & evidence: ${d.summary} Evidence-based assessment for the EU market.`;
const pageDescription = descriptionBase.length > 155
  ? `${descriptionBase.slice(0, 152)}…`
  : descriptionBase;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${d.title} – Effects, Studies & Rating`,
  description: d.summary,
  datePublished: d.publishedAt,
  inLanguage: 'en',
  author: { '@type': 'Organization', name: 'MikroScore' },
  publisher: { '@type': 'Organization', name: 'MikroScore', url: 'https://mikroscore.com' },
};

const medicalWebPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: `${d.title} – Effects, Studies & Rating`,
  url: `https://mikroscore.com/en/ingredients/${d.slug}`,
  description: d.summary,
  dateModified: d.updatedAt ?? d.publishedAt,
  inLanguage: 'en',
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'evidenceLevel', value: d.evidenceLevel },
    { '@type': 'PropertyValue', name: 'efsaClaimStatus', value: d.efsa_health_claims_allowed ? 'allowed' : 'not-allowed' },
    { '@type': 'PropertyValue', name: 'safetyRating', value: d.safety_rating },
    { '@type': 'PropertyValue', name: 'category', value: d.category },
  ],
  ...(d.key_studies.length > 0 && {
    citation: d.key_studies.map(study => ({
      '@type': 'ScholarlyArticle',
      name: study.title,
      author: study.authors,
      datePublished: study.year.toString(),
      ...(study.pmid ? { identifier: `PMID:${study.pmid}` } : {}),
      ...(study.url ? { url: study.url } : {}),
    })),
  }),
};

const evidenceSentences = d.evidenceSummary.split(/\.\s+/);
const evidenceSupports = evidenceSentences.slice(0, 2).join('. ').trimEnd().replace(/\.?$/, '.');
const notSupported = parseInt(d.evidenceLevel) >= 3
  ? 'Clinical human trials are absent or very weak. Long-term safety in humans is largely unexplored.'
  : 'Long-term safety and rare adverse effects in humans remain insufficiently studied.';
const efsaSnippet = d.efsa_notes
  ? (d.efsa_notes.length > 100 ? d.efsa_notes.slice(0, 97) + '…' : d.efsa_notes)
  : 'No approved EU health claims.';
const efsaStatus = d.efsa_health_claims_allowed
  ? `Approved. ${efsaSnippet}`
  : `Not approved. ${efsaSnippet}`;
---

<BaseLayout
  title={d.title}
  description={pageDescription}
  locale="en"
  hreflang={{ de: `/wirkstoffe/${d.slug}`, en: `/en/ingredients/${d.slug}` }}
>
  <Fragment slot="head">
    <meta name="keywords" content={`${d.title} supplement, ${d.title} evidence, ${d.title} review`} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(medicalWebPageSchema)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-4 py-10">

    <!-- Breadcrumb -->
    <nav class="text-xs text-slate-400 mb-6">
      <a href="/en" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/en/ingredients" class="hover:text-teal-600">Ingredients</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">{d.title}</span>
    </nav>

    <!-- Illustration banner -->
    <div class="rounded-2xl overflow-hidden border border-slate-100 bg-gradient-to-br from-slate-50 via-white to-teal-50/40 mb-6 px-4 py-3">
      <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-1.5">Science-backed ingredient evidence</div>
      <div class="mx-auto w-full max-w-[240px] sm:max-w-[320px] md:max-w-[420px]">
        <EvidenceResearchIllustration />
      </div>
    </div>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex flex-wrap gap-2 mb-3">
        <EvidenceBadge level={d.evidenceLevel} />
        <span class:list={['rounded-full px-2.5 py-1 text-xs font-medium', safetyStyle[d.safety_rating]]}>
          Safety: {safetyLabel[d.safety_rating]}
        </span>
        {d.typical_dose_mg && (
          <span class="rounded-full px-2.5 py-1 text-xs font-medium bg-slate-100 text-slate-700">
            Study dose: {d.typical_dose_mg} mg/day
          </span>
        )}
      </div>
      <h1 class="text-3xl font-bold text-slate-900 mb-3">{d.title}</h1>
      {d.aliases.length > 0 && (
        <p class="text-sm text-slate-500">Also known as: {d.aliases.join(', ')}</p>
      )}
    </div>

    <!-- Summary (TL;DR) -->
    <div class="bg-white border border-slate-200 rounded-xl p-5 mb-6 shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wide text-slate-400">Summary</span>
        <EvidenceBadge level={d.evidenceLevel} />
      </div>
      <p class="text-base font-medium text-slate-800 leading-relaxed">{d.summary}</p>
    </div>

    <!-- Evidence summary box -->
    <div class="bg-teal-50 border border-teal-200 rounded-xl p-5 mb-8">
      <p class="text-sm font-semibold text-teal-800 mb-1">Evidence at a glance</p>
      <p class="text-sm text-teal-700">{d.evidenceSummary}</p>
    </div>

    <!-- EFSA status -->
    <div class:list={[
      'rounded-xl border p-5 mb-8',
      d.efsa_health_claims_allowed
        ? 'bg-emerald-50 border-emerald-200'
        : 'bg-red-50 border-red-200'
    ]}>
      <p class:list={[
        'text-sm font-semibold mb-1',
        d.efsa_health_claims_allowed ? 'text-emerald-800' : 'text-red-800'
      ]}>
        EU Health Claims: {d.efsa_health_claims_allowed ? 'Approved' : 'No approved claims'}
      </p>
      {d.efsa_notes && (
        <p class:list={[
          'text-sm',
          d.efsa_health_claims_allowed ? 'text-emerald-700' : 'text-red-700'
        ]}>{d.efsa_notes}</p>
      )}
    </div>

    <!-- AI Summary -->
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-8 font-[system-ui]">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-lg" aria-hidden="true">🤖</span>
        <span class="text-xs font-mono font-semibold uppercase tracking-widest text-slate-400">AI Summary</span>
      </div>
      <div class="space-y-4 text-sm text-slate-700">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Quick verdict</p>
          <p class="leading-relaxed">{d.summary}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">What the evidence supports</p>
          <p class="leading-relaxed">{evidenceSupports}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">What is NOT supported</p>
          <p class="leading-relaxed">{notSupported}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">EU/EFSA status</p>
          <p class="leading-relaxed">{efsaStatus}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Safety</p>
          <p class="leading-relaxed">{safetyLabel[d.safety_rating]}</p>
        </div>
      </div>
      <p class="text-xs text-slate-400 mt-4 pt-3 border-t border-slate-200">
        This AI summary is generated from the structured data on this page.
      </p>
    </div>

    <!-- Article content -->
    <article class="prose max-w-none mb-10">
      <Content />
    </article>

    <!-- Key Studies -->
    {d.key_studies.length > 0 && (
      <div class="mb-8">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Key Studies</h2>
        <div class="space-y-3">
          {d.key_studies.map(study => (
            <div class="bg-white border border-slate-200 rounded-lg p-4">
              <p class="text-sm font-medium text-slate-800 mb-0.5">{study.title}</p>
              <p class="text-xs text-slate-500 mb-2">{study.authors} ({study.year})</p>
              <p class="text-sm text-slate-600 mb-2">{study.finding}</p>
              {study.url && (
                <a href={study.url} target="_blank" rel="noopener noreferrer"
                   class="text-xs text-teal-600 hover:underline">
                  PubMed {study.pmid ? `PMID ${study.pmid}` : '→'}
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Nutrient Check teaser -->
    {checkSlugs.has(d.slug) && (
      <div class="bg-teal-50 border border-teal-200 rounded-xl p-5 mb-6">
        <div class="flex items-start gap-3">
          <span class="text-2xl">🥦</span>
          <div>
            <p class="font-semibold text-teal-900 mb-1">How well do you get {d.title}?</p>
            <p class="text-sm text-teal-700 mb-3">The Nutrient Check estimates your personal supply risk in 60 seconds — based on diet and lifestyle.</p>
            <a href="/en/nutrient-check" class="inline-block text-sm font-medium bg-teal-600 text-white hover:bg-teal-700 rounded-lg px-4 py-2 no-underline transition-colors">
              Start Nutrient Check →
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Products for this ingredient -->
    {linkedProducts.length > 0 ? (
      <div class="mb-6" id="products">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-slate-800">Reviewed products with {d.title}</h2>
          <span class="text-sm text-slate-400">{linkedProducts.length} {linkedProducts.length === 1 ? 'product' : 'products'}</span>
        </div>
        <div class="space-y-3">
          {[...linkedProducts]
            .sort((a, b) => compositeScore(b.data.ratings) - compositeScore(a.data.ratings))
            .map((p, i) => {
              const score = compositeScore(p.data.ratings);
              return (
                <a href={`/en/products/${p.data.slug}`}
                   class="flex items-center justify-between bg-white border border-slate-200 rounded-xl px-5 py-4 hover:border-teal-400 transition-all no-underline group gap-4">
                  <div class="flex items-center gap-3 min-w-0">
                    {linkedProducts.length > 1 && (
                      <span class="text-xs font-bold text-slate-300 w-4 shrink-0">#{i + 1}</span>
                    )}
                    <div class="min-w-0">
                      <p class="font-medium text-slate-800 group-hover:text-teal-700 text-sm truncate">{p.data.title}</p>
                      <p class="text-xs text-slate-500">
                        {p.data.vendor}
                        <span class="mx-1 text-slate-300">·</span>
                        {p.data.doseMg} mg
                        <span class="mx-1 text-slate-300">·</span>
                        €{p.data.pricePerDayEur.toFixed(2)}/day
                        <span class="mx-1 text-slate-300">·</span>
                        {p.data.servingsPerPack} servings/pack
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    <span class="text-sm font-semibold text-slate-700">{score.toFixed(1)}<span class="text-xs font-normal text-slate-400">/10</span></span>
                    <VerdictBadge verdict={p.data.verdict} />
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    ) : (
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-6">
        <p class="font-semibold text-slate-700 mb-1">Products with {d.title}</p>
        <p class="text-sm text-slate-500 mb-3">No reviewed products yet — we're working on it.</p>
        <a href="/en/products" class="text-sm text-teal-600 hover:text-teal-800 font-medium no-underline">
          See all reviewed products →
        </a>
      </div>
    )}

    <!-- Editorial disclaimer -->
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mt-10 text-xs text-amber-800 leading-5">
      <strong>Editorial notice:</strong> For most ingredients described here, no health claims are approved in the EU (Regulation (EC) 1924/2006). Evidence levels are editorial assessments of research quality — not health promises. This content is not a substitute for medical advice and does not constitute a recommendation to treat, alleviate, or prevent any disease.
    </div>

  </div>
</BaseLayout>
