---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { getCollection } from 'astro:content';

const ingredients = await getCollection('ingredients');
const products = await getCollection('products');
const claims = await getCollection('claims');

// For the preview grid: show top 6 by evidenceLevel ascending (best evidence first)
const previewIngredients = [...ingredients]
  .sort((a, b) => Number(a.data.evidenceLevel) - Number(b.data.evidenceLevel))
  .slice(0, 6);

const previewClaims = [...claims]
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<BaseLayout title="Supplements & Nahrungsergänzung, wissenschaftlich eingeordnet">

  <!-- Hero -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 py-16">
      <h1 class="text-4xl font-bold text-slate-900 mb-4 max-w-2xl leading-tight">
        Supplements &amp; Nahrungsergänzung,<br />wissenschaftlich eingeordnet.
      </h1>
      <p class="text-lg text-slate-600 max-w-xl mb-5">
        NMN, Ashwagandha, Curcumin &amp; Co. bewertet nach Studienlage und EU-Regulatorik. Unsere Bewertungen beurteilen Produktqualität, Forschungsstand und Transparenz aber keine gesundheitlichen Wirkungen, da für die meisten Wirkstoffe in der EU keine Health Claims zugelassen sind.
      </p>
      <div class="flex gap-3 flex-wrap">
        <a href="/wirkstoffe" class="bg-teal-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-teal-700 no-underline transition-colors">
          Alle {ingredients.length} Wirkstoffe →
        </a>
        <a href="/produkte" class="bg-teal-50 border border-teal-300 text-teal-700 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-teal-100 no-underline transition-colors">
          {products.length} Produkte vergleichen →
        </a>
        <a href="/ernaehrungs-check" class="bg-white border border-slate-300 text-slate-700 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-50 no-underline transition-colors">
          Ernährungs-Check →
        </a>
        <a href="/claims" class="bg-white border border-slate-300 text-slate-700 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-50 no-underline transition-colors">
          Claims-Check →
        </a>
        <a href="/methodik" class="border border-slate-300 text-slate-700 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-50 no-underline transition-colors">
          Wie wir bewerten
        </a>
      </div>

      <!-- Stats bar -->
      <div class="flex flex-wrap gap-6 mt-10 text-sm text-slate-500">
        <div>
          <span class="text-2xl font-bold text-slate-900">{ingredients.length}</span>
          <span class="ml-1.5">Wirkstoff-Dossiers</span>
        </div>
        <div>
          <span class="text-2xl font-bold text-slate-900">{products.length}</span>
          <span class="ml-1.5">Produkte bewertet</span>
        </div>
        <div>
          <span class="text-2xl font-bold text-slate-900">{claims.length}</span>
          <span class="ml-1.5">Claims geprüft</span>
        </div>
        <div>
          <span class="text-2xl font-bold text-slate-900">0€</span>
          <span class="ml-1.5">Paywall</span>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works (3 pillars) -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">So funktioniert MikroScore</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-teal-50 rounded-2xl border border-teal-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="aspect-video bg-gradient-to-br from-teal-50 via-white to-slate-50 border-b border-teal-100 p-4">
          <svg viewBox="0 0 320 180" class="w-full h-full" fill="none" aria-hidden="true">
            <rect x="18" y="20" width="118" height="78" rx="14" stroke="#0f766e" stroke-width="1.5" opacity="0.18"/>
            <rect x="32" y="36" width="42" height="10" rx="5" fill="#0f766e" opacity="0.12"/>
            <rect x="32" y="56" width="62" height="8" rx="4" fill="#1e293b" opacity="0.08"/>
            <rect x="32" y="72" width="48" height="8" rx="4" fill="#1e293b" opacity="0.08"/>
            <circle cx="240" cy="88" r="46" stroke="#0f766e" stroke-width="1.5" opacity="0.18"/>
            <circle cx="240" cy="88" r="30" stroke="#0f766e" stroke-width="1.2" opacity="0.12"/>
            <path d="M240 42V134M194 88H286M208 56L272 120M272 56L208 120" stroke="#1e293b" stroke-width="1" opacity="0.08"/>
            <path d="M240 88L267 70" stroke="#0f766e" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M240 88L223 118" stroke="#14b8a6" stroke-width="2.5" stroke-linecap="round"/>
            <ellipse cx="110" cy="132" rx="16" ry="10" fill="#0f766e" opacity="0.12"/>
            <path d="M110 124C114 114 124 110 130 104" stroke="#0f766e" stroke-width="2" stroke-linecap="round" opacity="0.25"/>
            <ellipse cx="72" cy="134" rx="12" ry="8" fill="#1e293b" opacity="0.08"/>
            <path d="M72 128C67 118 58 112 52 106" stroke="#1e293b" stroke-width="1.8" stroke-linecap="round" opacity="0.18"/>
          </svg>
        </div>
        <div class="p-6">
          <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-2">Persönliche Nährstoff-Risikoeinschätzung</div>
          <h3 class="font-semibold text-slate-900 mb-2">Ernährungs-Check</h3>
          <p class="text-sm text-slate-600 mb-3">15 Fragen — wir schätzen, bei welchen Nährstoffen ein erhöhtes Versorgungsrisiko bestehen könnte.</p>
          <a href="/ernaehrungs-check" class="text-sm font-medium text-teal-700 hover:text-teal-900 no-underline">Jetzt checken →</a>
        </div>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="aspect-video bg-gradient-to-br from-slate-50 via-white to-teal-50 border-b border-slate-100 p-4">
          <svg viewBox="0 0 320 180" class="w-full h-full" fill="none" aria-hidden="true">
            <rect x="24" y="26" width="74" height="94" rx="10" stroke="#1e293b" stroke-width="1.5" opacity="0.14"/>
            <line x1="38" y1="48" x2="84" y2="48" stroke="#0f766e" stroke-width="2" opacity="0.18"/>
            <line x1="38" y1="62" x2="84" y2="62" stroke="#1e293b" stroke-width="1.4" opacity="0.1"/>
            <line x1="38" y1="76" x2="76" y2="76" stroke="#1e293b" stroke-width="1.4" opacity="0.1"/>
            <circle cx="210" cy="74" r="24" stroke="#0f766e" stroke-width="1.5" opacity="0.18"/>
            <circle cx="210" cy="74" r="8" fill="#0f766e" opacity="0.12"/>
            <path d="M186 74H170M250 74H234M210 50V34M210 114V98" stroke="#0f766e" stroke-width="1.4" opacity="0.18"/>
            <path d="M170 124h48M194 124c0-17 14-31 31-31s31 14 31 31M256 124h-8" stroke="#1e293b" stroke-width="1.5" opacity="0.18" stroke-linecap="round"/>
            <rect x="150" y="30" width="18" height="6" rx="3" fill="#14b8a6" opacity="0.16"/>
            <rect x="174" y="30" width="18" height="6" rx="3" fill="#1e293b" opacity="0.08"/>
            <rect x="198" y="30" width="18" height="6" rx="3" fill="#14b8a6" opacity="0.16"/>
            <rect x="222" y="30" width="18" height="6" rx="3" fill="#1e293b" opacity="0.08"/>
            <rect x="246" y="30" width="18" height="6" rx="3" fill="#14b8a6" opacity="0.16"/>
            <path d="M108 132h48M108 144h72M108 156h58" stroke="#0f766e" stroke-width="2" opacity="0.12" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="p-6">
          <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-2">Evidenzbasierte Wirkstoff-Recherche</div>
          <h3 class="font-semibold text-slate-900 mb-2">Wirkstoff-Dossiers</h3>
          <p class="text-sm text-slate-600 mb-3">RCTs, Metaanalysen, EFSA- und BfR-Bewertungen — klar getrennt nach Evidenzstärke.</p>
          <a href="/wirkstoffe" class="text-sm font-medium text-teal-700 hover:text-teal-900 no-underline">Alle {ingredients.length} Wirkstoffe →</a>
        </div>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition-shadow">
        <div class="aspect-video bg-gradient-to-br from-slate-50 via-white to-teal-50 border-b border-slate-100 p-4">
          <svg viewBox="0 0 320 180" class="w-full h-full" fill="none" aria-hidden="true">
            <rect x="24" y="34" width="82" height="76" rx="12" stroke="#1e293b" stroke-width="1.4" opacity="0.14"/>
            <rect x="214" y="34" width="82" height="76" rx="12" stroke="#1e293b" stroke-width="1.4" opacity="0.14"/>
            <rect x="38" y="50" width="26" height="8" rx="4" fill="#14b8a6" opacity="0.16"/>
            <rect x="228" y="50" width="26" height="8" rx="4" fill="#14b8a6" opacity="0.16"/>
            <rect x="38" y="66" width="42" height="6" rx="3" fill="#1e293b" opacity="0.08"/>
            <rect x="228" y="66" width="42" height="6" rx="3" fill="#1e293b" opacity="0.08"/>
            <rect x="38" y="78" width="34" height="6" rx="3" fill="#1e293b" opacity="0.08"/>
            <rect x="228" y="78" width="34" height="6" rx="3" fill="#1e293b" opacity="0.08"/>
            <path d="M124 132H286" stroke="#1e293b" stroke-width="1.2" opacity="0.1"/>
            <path d="M146 132V92" stroke="#14b8a6" stroke-width="7" stroke-linecap="round" opacity="0.28"/>
            <path d="M178 132V74" stroke="#0f766e" stroke-width="7" stroke-linecap="round" opacity="0.34"/>
            <path d="M210 132V102" stroke="#1e293b" stroke-width="7" stroke-linecap="round" opacity="0.16"/>
            <circle cx="138" cy="44" r="12" stroke="#0f766e" stroke-width="1.4" opacity="0.16"/>
            <path d="M133 44l3 3 6-7" stroke="#0f766e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" opacity="0.35"/>
            <circle cx="172" cy="44" r="12" stroke="#0f766e" stroke-width="1.4" opacity="0.16"/>
            <path d="M167 44l3 3 6-7" stroke="#0f766e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" opacity="0.35"/>
          </svg>
        </div>
        <div class="p-6">
          <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-2">Transparenter Produktvergleich</div>
          <h3 class="font-semibold text-slate-900 mb-2">Produktvergleich</h3>
          <p class="text-sm text-slate-600 mb-3">Konkrete Produkte nach Preis/Tagesdosis, Reinheit, Zertifizierung und Label-Ehrlichkeit.</p>
          <a href="/produkte" class="text-sm font-medium text-teal-700 hover:text-teal-900 no-underline">Alle {products.length} Produkte vergleichen →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Claims teaser -->
  <section class="max-w-5xl mx-auto px-4 py-8">
    <div class="rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm">
      <div class="aspect-[16/6] md:aspect-[16/4] bg-gradient-to-br from-slate-50 via-white to-teal-50 border-b border-slate-100 p-4 md:p-5">
        <svg viewBox="0 0 640 180" class="w-full h-full" fill="none" aria-hidden="true">
          <rect x="28" y="36" width="144" height="92" rx="14" stroke="#1e293b" stroke-width="1.4" opacity="0.14"/>
          <rect x="48" y="54" width="72" height="8" rx="4" fill="#0f766e" opacity="0.14"/>
          <rect x="48" y="72" width="96" height="6" rx="3" fill="#1e293b" opacity="0.08"/>
          <rect x="48" y="86" width="82" height="6" rx="3" fill="#1e293b" opacity="0.08"/>
          <path d="M220 54H388" stroke="#1e293b" stroke-width="1.2" opacity="0.08"/>
          <path d="M220 90H388" stroke="#1e293b" stroke-width="1.2" opacity="0.08"/>
          <path d="M220 126H388" stroke="#1e293b" stroke-width="1.2" opacity="0.08"/>
          <rect x="246" y="43" width="82" height="22" rx="11" fill="#dcfce7" stroke="#16a34a" stroke-width="1" opacity="0.7"/>
          <text x="287" y="57" text-anchor="middle" font-size="10" fill="#166534" font-family="ui-sans-serif, system-ui">belegt</text>
          <rect x="264" y="79" width="92" height="22" rx="11" fill="#fef3c7" stroke="#d97706" stroke-width="1" opacity="0.8"/>
          <text x="310" y="93" text-anchor="middle" font-size="10" fill="#9a3412" font-family="ui-sans-serif, system-ui">teilweise</text>
          <rect x="290" y="115" width="78" height="22" rx="11" fill="#fee2e2" stroke="#dc2626" stroke-width="1" opacity="0.8"/>
          <text x="329" y="129" text-anchor="middle" font-size="10" fill="#991b1b" font-family="ui-sans-serif, system-ui">nicht belegt</text>
          <circle cx="494" cy="86" r="38" stroke="#0f766e" stroke-width="1.5" opacity="0.16"/>
          <path d="M478 86l10 10 18-24" stroke="#0f766e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" opacity="0.32"/>
          <rect x="540" y="56" width="64" height="10" rx="5" fill="#14b8a6" opacity="0.14"/>
          <rect x="540" y="76" width="42" height="8" rx="4" fill="#1e293b" opacity="0.08"/>
          <rect x="540" y="92" width="52" height="8" rx="4" fill="#1e293b" opacity="0.08"/>
          <rect x="540" y="108" width="34" height="8" rx="4" fill="#1e293b" opacity="0.08"/>
        </svg>
      </div>
      <div class="p-6 md:p-7">
        <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-2">Marketing-Versprechen im Faktencheck</p>
            <h2 class="text-xl font-semibold text-slate-800">Claims-Check</h2>
            <p class="text-sm text-slate-600 mt-2 max-w-2xl">
              Wir nehmen Marketing-Aussagen von Supplement-Marken wörtlich und prüfen, was davon durch Studien, EFSA-Logik oder saubere Evidenz wirklich gedeckt ist.
            </p>
          </div>
          <a href="/claims" class="text-sm text-teal-600 hover:text-teal-800 no-underline font-medium whitespace-nowrap">Alle {claims.length} Claims ansehen →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {previewClaims.map(claim => (
            <a
              href={`/claims/${claim.data.slug}`}
              class="rounded-xl border border-slate-200 bg-slate-50/70 p-5 no-underline hover:border-teal-300 hover:bg-white transition-all"
            >
              <div class="mb-3">
                <VerdictBadge verdict={claim.data.verdict} hideNote={true} />
              </div>
              <h3 class="font-semibold text-slate-800 text-sm leading-6 mb-2">„{claim.data.title}“</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{claim.data.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Wirkstoffe preview grid -->
  <section class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex justify-between items-baseline mb-6">
      <h2 class="text-xl font-semibold text-slate-800">Zuletzt aktualisierte Dossiers</h2>
      <a href="/wirkstoffe" class="text-sm text-teal-600 hover:text-teal-800 no-underline">Alle anzeigen →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {previewIngredients.map(ing => (
        <a
          href={`/wirkstoffe/${ing.data.slug}`}
          class="bg-white rounded-xl border border-slate-200 p-5 hover:border-teal-400 hover:shadow-sm transition-all no-underline group"
        >
          <div class="flex justify-between items-start mb-3">
            <h3 class="font-semibold text-slate-800 group-hover:text-teal-700 text-sm pr-2">{ing.data.title}</h3>
            <EvidenceBadge level={ing.data.evidenceLevel} showLabel={false} />
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">{ing.data.summary}</p>
        </a>
      ))}
    </div>
    <div class="mt-4 text-center">
      <a href="/wirkstoffe" class="inline-block text-sm border border-slate-300 text-slate-600 px-5 py-2 rounded-lg hover:bg-slate-50 no-underline transition-colors">
        Alle {ingredients.length} Wirkstoffe mit Filter anzeigen →
      </a>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="max-w-5xl mx-auto px-4 py-8">
    <div class="bg-teal-50 border border-teal-200 rounded-xl p-6">
      <h2 class="font-semibold text-teal-900 mb-2">Unsere Quellen</h2>
      <p class="text-sm text-teal-800 mb-4">Wir beziehen uns ausschließlich auf öffentlich zugängliche, zitierfähige Quellen:</p>
      <div class="flex flex-wrap gap-3 text-xs">
        {['PubMed / PMC', 'NIH ODS Fact Sheets', 'EFSA Health Claims Register', 'BfR Deutschland'].map(source => (
          <span class="bg-white border border-teal-300 text-teal-700 rounded-full px-3 py-1">{source}</span>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
