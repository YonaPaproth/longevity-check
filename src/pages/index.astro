---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { getCollection } from 'astro:content';

const ingredients = await getCollection('ingredients');
const products = await getCollection('products');
const claims = await getCollection('claims');

// For the preview grid: show top 6 by evidenceLevel ascending (best evidence first)
const previewIngredients = [...ingredients]
  .sort((a, b) => Number(a.data.evidenceLevel) - Number(b.data.evidenceLevel))
  .slice(0, 6);

const previewClaims = [...claims]
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<BaseLayout title="Evidenzbasierte Longevity-Supplement-Bewertungen">

  <!-- Hero -->
  <section class="bg-white border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 py-16">
      <h1 class="text-4xl font-bold text-slate-900 mb-4 max-w-2xl leading-tight">
        Supplements ehrlich bewertet,<br />bevor du kaufst.
      </h1>
      <p class="text-lg text-slate-600 max-w-xl mb-8">
        NMN, Ashwagandha, Curcumin &amp; Co. — bewertet nach EU-Regulatorik und Studienlage.
        Kein Hype, keine Interessenkonflikte.
      </p>
      <div class="flex gap-3 flex-wrap">
        <a href="/wirkstoffe" class="bg-teal-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-teal-700 no-underline transition-colors">
          Alle {ingredients.length} Wirkstoffe →
        </a>
        <a href="/ernaehrungs-check" class="bg-teal-50 border border-teal-300 text-teal-700 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-teal-100 no-underline transition-colors">
          Ernährungs-Check →
        </a>
        <a href="/claims" class="bg-white border border-slate-300 text-slate-700 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-50 no-underline transition-colors">
          Claims-Check →
        </a>
        <a href="/methodik" class="border border-slate-300 text-slate-700 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-slate-50 no-underline transition-colors">
          Wie wir bewerten
        </a>
      </div>

      <!-- Stats bar -->
      <div class="flex flex-wrap gap-6 mt-10 text-sm text-slate-500">
        <div>
          <span class="text-2xl font-bold text-slate-900">{ingredients.length}</span>
          <span class="ml-1.5">Wirkstoff-Dossiers</span>
        </div>
        <div>
          <span class="text-2xl font-bold text-slate-900">{products.length}</span>
          <span class="ml-1.5">Produkte bewertet</span>
        </div>
        <div>
          <span class="text-2xl font-bold text-slate-900">{claims.length}</span>
          <span class="ml-1.5">Claims geprüft</span>
        </div>
        <div>
          <span class="text-2xl font-bold text-slate-900">0€</span>
          <span class="ml-1.5">Paywall</span>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works (3 pillars) -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-xl font-semibold text-slate-800 mb-6">So funktioniert MikroScore</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-teal-50 rounded-xl border border-teal-200 p-6">
        <div class="text-2xl mb-3">🥦</div>
        <h3 class="font-semibold mb-2">Ernährungs-Check</h3>
        <p class="text-sm text-slate-600 mb-3">10 Fragen — wir zeigen dir welche Nährstoffe du wahrscheinlich nicht deckst und was das bedeutet.</p>
        <a href="/ernaehrungs-check" class="text-sm font-medium text-teal-700 hover:text-teal-900 no-underline">Jetzt checken →</a>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-2xl mb-3">🔬</div>
        <h3 class="font-semibold mb-2">Wirkstoff-Dossiers</h3>
        <p class="text-sm text-slate-600 mb-3">RCTs, Metaanalysen, EFSA- und BfR-Bewertungen — klar getrennt nach Evidenzstärke. Kein Marketing.</p>
        <a href="/wirkstoffe" class="text-sm font-medium text-teal-700 hover:text-teal-900 no-underline">Alle {ingredients.length} Wirkstoffe →</a>
      </div>
      <div class="bg-white rounded-xl border border-slate-200 p-6">
        <div class="text-2xl mb-3">💶</div>
        <div class="flex items-center gap-2 mb-2">
          <h3 class="font-semibold">Produktvergleich</h3>
          <span class="text-xs bg-amber-100 text-amber-700 rounded-full px-2 py-0.5 font-medium">im Aufbau</span>
        </div>
        <p class="text-sm text-slate-600">Konkrete Produkte nach Preis/Tagesdosis, Reinheit, Zertifizierung und Label-Ehrlichkeit.</p>
      </div>
    </div>
  </section>

  <!-- Claims teaser -->
  <section class="max-w-5xl mx-auto px-4 py-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 md:p-7 shadow-sm">
      <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
        <div>
          <p class="text-sm font-medium text-teal-700 mb-1">Neu auf MikroScore</p>
          <h2 class="text-xl font-semibold text-slate-800">Claims-Check</h2>
          <p class="text-sm text-slate-600 mt-2 max-w-2xl">
            Wir nehmen Marketing-Aussagen von Supplement-Marken wörtlich und prüfen, was davon durch Studien, EFSA-Logik oder saubere Evidenz wirklich gedeckt ist.
          </p>
        </div>
        <a href="/claims" class="text-sm text-teal-600 hover:text-teal-800 no-underline font-medium whitespace-nowrap">Alle {claims.length} Claims ansehen →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {previewClaims.map(claim => (
          <a
            href={`/claims/${claim.data.slug}`}
            class="rounded-xl border border-slate-200 bg-slate-50/70 p-5 no-underline hover:border-teal-300 hover:bg-white transition-all"
          >
            <div class="mb-3">
              <VerdictBadge verdict={claim.data.verdict} hideNote={true} />
            </div>
            <h3 class="font-semibold text-slate-800 text-sm leading-6 mb-2">„{claim.data.title}“</h3>
            <p class="text-xs text-slate-500 leading-relaxed">{claim.data.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Wirkstoffe preview grid -->
  <section class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex justify-between items-baseline mb-6">
      <h2 class="text-xl font-semibold text-slate-800">Zuletzt aktualisierte Dossiers</h2>
      <a href="/wirkstoffe" class="text-sm text-teal-600 hover:text-teal-800 no-underline">Alle anzeigen →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {previewIngredients.map(ing => (
        <a
          href={`/wirkstoffe/${ing.data.slug}`}
          class="bg-white rounded-xl border border-slate-200 p-5 hover:border-teal-400 hover:shadow-sm transition-all no-underline group"
        >
          <div class="flex justify-between items-start mb-3">
            <h3 class="font-semibold text-slate-800 group-hover:text-teal-700 text-sm pr-2">{ing.data.title}</h3>
            <EvidenceBadge level={ing.data.evidenceLevel} showLabel={false} />
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">{ing.data.summary}</p>
        </a>
      ))}
    </div>
    <div class="mt-4 text-center">
      <a href="/wirkstoffe" class="inline-block text-sm border border-slate-300 text-slate-600 px-5 py-2 rounded-lg hover:bg-slate-50 no-underline transition-colors">
        Alle {ingredients.length} Wirkstoffe mit Filter anzeigen →
      </a>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="max-w-5xl mx-auto px-4 py-8">
    <div class="bg-teal-50 border border-teal-200 rounded-xl p-6">
      <h2 class="font-semibold text-teal-900 mb-2">Unsere Quellen</h2>
      <p class="text-sm text-teal-800 mb-4">Wir beziehen uns ausschließlich auf öffentlich zugängliche, zitierfähige Quellen:</p>
      <div class="flex flex-wrap gap-3 text-xs">
        {['PubMed / PMC', 'NIH ODS Fact Sheets', 'Cochrane Reviews', 'EFSA Health Claims Register', 'BfR Deutschland', 'Labdoor', 'Informed-Sport'].map(source => (
          <span class="bg-white border border-teal-300 text-teal-700 rounded-full px-3 py-1">{source}</span>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
