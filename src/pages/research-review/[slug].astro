---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('researchReview');
  return posts.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<BaseLayout
  title={d.title}
  description={d.summary}
>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <nav class="text-xs text-slate-400 mb-6">
      <a href="/" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/research-review" class="hover:text-teal-600">Research Review</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">{d.title}</span>
    </nav>

    <div class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-teal-50/40 shadow-sm mb-8">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.07),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(15,23,42,0.04),transparent_28%)]"></div>
      <div class="relative p-6">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-3">Neue Papers, kuratiert eingeordnet</div>
        <h1 class="text-3xl font-bold text-slate-900 mb-2">{d.title}</h1>
        <p class="text-slate-600 mb-4">{d.summary}</p>
        <div class="flex flex-wrap gap-2 text-xs">
          <span class="rounded-full bg-white/80 border border-slate-200 px-3 py-1 text-slate-600">
            Veröffentlicht: {d.publishedAt.toLocaleDateString('de-DE')}
          </span>
          {d.status === 'experimental' && (
            <span class="rounded-full bg-amber-50 border border-amber-200 px-3 py-1 text-amber-700">
              Experimentelles Format
            </span>
          )}
          {d.tags.slice(0, 6).map(tag => (
            <span class="rounded-full bg-white/80 border border-slate-200 px-3 py-1 text-slate-500">{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <article class="prose max-w-none">
      <Content />
    </article>
  </div>
</BaseLayout>
