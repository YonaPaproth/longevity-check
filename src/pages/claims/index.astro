---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import { getCollection } from 'astro:content';

const claims = await getCollection('claims');
const sorted = claims.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title="Claims-Check" description="Marketing-Aussagen von Longevity-Supplement-Herstellern überprüft gegen die Studienlage.">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Claims-Check</h1>
    <p class="text-slate-600 mb-8">
      Wir nehmen Marketing-Aussagen wörtlich und prüfen sie gegen EFSA-Register und aktuelle Studien.
    </p>

    <div class="space-y-3">
      {sorted.map(claim => (
        <a
          href={`/claims/${claim.data.slug}`}
          class="flex flex-wrap items-center justify-between gap-3 bg-white rounded-xl border border-slate-200 px-5 py-4 hover:border-teal-400 transition-all no-underline group"
        >
          <div>
            <p class="text-sm font-medium text-slate-700 group-hover:text-teal-700 mb-0.5">
              „{claim.data.title}"
            </p>
            <p class="text-xs text-slate-400">{claim.data.summary}</p>
          </div>
          <VerdictBadge verdict={claim.data.verdict} />
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
