---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import ClaimCheckIllustration from '../../components/illustrations/ClaimCheckIllustration.astro';
import { getCollection } from 'astro:content';

const claims = await getCollection('claims');
const sorted = claims.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title="Claims-Check" description="Marketing-Aussagen von Longevity-Supplement-Herstellern überprüft gegen die Studienlage.">
  <div class="max-w-3xl mx-auto px-4 py-12">

    <!-- Hero with illustration -->
    <div class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-teal-50/40 shadow-sm mb-8">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.07),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(15,23,42,0.04),transparent_28%)]"></div>
      <div class="relative p-6">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-3">Marketing-Versprechen im Faktencheck</div>
        <h1 class="text-3xl font-bold text-slate-900 mb-2">Claims-Check</h1>
        <p class="text-slate-600 mb-4">
          Wir nehmen Marketing-Aussagen wörtlich und prüfen sie gegen EFSA-Register und aktuelle Studien.
        </p>
        <ClaimCheckIllustration />
      </div>
    </div>

    <div class="space-y-3">
      {sorted.map(claim => (
        <a
          href={`/claims/${claim.data.slug}`}
          class="flex flex-wrap items-center justify-between gap-3 bg-white rounded-xl border border-slate-200 px-5 py-4 hover:border-teal-400 transition-all no-underline group"
        >
          <div>
            <p class="text-sm font-medium text-slate-700 group-hover:text-teal-700 mb-0.5">
              „{claim.data.title}"
            </p>
            <p class="text-xs text-slate-400">{claim.data.summary}</p>
          </div>
          <VerdictBadge verdict={claim.data.verdict} />
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
