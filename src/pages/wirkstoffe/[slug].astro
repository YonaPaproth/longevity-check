---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import EvidenceResearchIllustration from '../../components/illustrations/EvidenceResearchIllustration.astro';
import { getCollection, render } from 'astro:content';
import { compositeScore } from '../../utils/scoring';

export async function getStaticPaths() {
  const ingredients = await getCollection('ingredients');
  return ingredients.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Products for this ingredient
const allProducts = await getCollection('products');
const linkedProducts = allProducts.filter(p => p.data.ingredient === d.slug);

// Slugs covered by the Ernährungs-Check
const checkSlugs = new Set(['vitamin-d3-k2', 'omega-3', 'magnesium', 'zink', 'vitamin-b12']);

const safetyLabel = {
  'safe': 'Sicher',
  'likely-safe': 'Wahrscheinlich sicher',
  'caution': 'Mit Vorsicht',
  'insufficient-data': 'Datenlage unklar',
} as const;

const safetyStyle = {
  'safe': 'bg-emerald-100 text-emerald-800',
  'likely-safe': 'bg-yellow-100 text-yellow-800',
  'caution': 'bg-orange-100 text-orange-800',
  'insufficient-data': 'bg-slate-100 text-slate-700',
} as const;

const ingredientDescriptionBase = `${d.title} Test & Erfahrungen: ${d.summary} ✓ Evidenzbasiert bewertet für Deutschland.`;
const ingredientDescription = ingredientDescriptionBase.length > 155
  ? `${ingredientDescriptionBase.slice(0, 152)}…`
  : ingredientDescriptionBase;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${d.title} – Wirkung, Studien & Bewertung`,
  description: d.summary,
  datePublished: d.publishedAt,
  author: {
    '@type': 'Organization',
    name: 'MikroScore',
  },
  publisher: {
    '@type': 'Organization',
    name: 'MikroScore',
    url: 'https://mikroscore.com',
  },
};

const medicalWebPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: `${d.title} – Wirkung, Studien & Bewertung`,
  url: `https://mikroscore.com/wirkstoffe/${d.slug}`,
  description: d.summary,
  dateModified: d.updatedAt ?? d.publishedAt,
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'evidenceLevel', value: d.evidenceLevel },
    { '@type': 'PropertyValue', name: 'efsaClaimStatus', value: d.efsa_health_claims_allowed ? 'allowed' : 'not-allowed' },
    { '@type': 'PropertyValue', name: 'safetyRating', value: d.safety_rating },
    { '@type': 'PropertyValue', name: 'category', value: d.category },
  ],
  ...(d.key_studies.length > 0 && {
    citation: d.key_studies.map(study => ({
      '@type': 'ScholarlyArticle',
      name: study.title,
      author: study.authors,
      datePublished: study.year.toString(),
      ...(study.pmid ? { identifier: `PMID:${study.pmid}` } : {}),
      ...(study.url ? { url: study.url } : {}),
    })),
  }),
};

// AI summary helpers
const evidenceSentences = d.evidenceSummary.split(/\.\s+/);
const evidenceSupports = evidenceSentences.slice(0, 2).join('. ').trimEnd().replace(/\.?$/, '.');
const notBelegt = parseInt(d.evidenceLevel) >= 3
  ? 'Klinische Humanstudien fehlen oder sind sehr schwach. Langzeit-Sicherheit beim Menschen weitgehend unerforscht.'
  : 'Langzeit-Sicherheit und seltene Nebenwirkungen beim Menschen sind noch unzureichend untersucht.';
const efsaSnippet = d.efsa_notes
  ? (d.efsa_notes.length > 100 ? d.efsa_notes.slice(0, 97) + '…' : d.efsa_notes)
  : 'Keine zugelassenen EU-Health-Claims.';
const efsaStatus = d.efsa_health_claims_allowed
  ? `Zugelassen. ${efsaSnippet}`
  : `Nicht zugelassen. ${efsaSnippet}`;
---

<BaseLayout title={d.title} description={ingredientDescription}>
  <Fragment slot="head">
    <meta name="keywords" content={`${d.title} kaufen, ${d.title} Wirkung`} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(medicalWebPageSchema)} />
  </Fragment>

  <div class="max-w-3xl mx-auto px-4 py-10">

    <!-- Breadcrumb -->
    <nav class="text-xs text-slate-400 mb-6">
      <a href="/" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/wirkstoffe" class="hover:text-teal-600">Wirkstoffe</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">{d.title}</span>
    </nav>

    <!-- Illustration banner -->
    <div class="rounded-2xl overflow-hidden border border-slate-100 bg-gradient-to-br from-slate-50 via-white to-teal-50/40 mb-6 px-4 py-3">
      <div class="text-[10px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-1.5">Science-backed ingredient evidence</div>
      <div class="mx-auto w-full max-w-[240px] sm:max-w-[320px] md:max-w-[420px]">
        <EvidenceResearchIllustration />
      </div>
    </div>

    <!-- Header -->
    <div class="mb-8">
      <div class="flex flex-wrap gap-2 mb-3">
        <EvidenceBadge level={d.evidenceLevel} />
        <span class:list={['rounded-full px-2.5 py-1 text-xs font-medium', safetyStyle[d.safety_rating]]}>
          Sicherheit: {safetyLabel[d.safety_rating]}
        </span>
        {d.typical_dose_mg && (
          <span class="rounded-full px-2.5 py-1 text-xs font-medium bg-slate-100 text-slate-700">
            Studiendosis: {d.typical_dose_mg} mg/Tag
          </span>
        )}
      </div>
      <h1 class="text-3xl font-bold text-slate-900 mb-3">{d.title}</h1>
      {d.aliases.length > 0 && (
        <p class="text-sm text-slate-500">Auch bekannt als: {d.aliases.join(', ')}</p>
      )}
    </div>

    <!-- Kurzurteil (TL;DR) -->
    <div class="bg-white border border-slate-200 rounded-xl p-5 mb-6 shadow-sm">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-semibold uppercase tracking-wide text-slate-400">Kurzurteil</span>
        <EvidenceBadge level={d.evidenceLevel} />
      </div>
      <p class="text-base font-medium text-slate-800 leading-relaxed">{d.summary}</p>
    </div>

    <!-- EFSA status -->
    <div class:list={[
      'rounded-xl border p-5 mb-8',
      d.efsa_health_claims_allowed
        ? 'bg-emerald-50 border-emerald-200'
        : 'bg-red-50 border-red-200'
    ]}>
      <p class:list={[
        'text-sm font-semibold mb-1',
        d.efsa_health_claims_allowed ? 'text-emerald-800' : 'text-red-800'
      ]}>
        EU Health Claims: {d.efsa_health_claims_allowed ? 'Zugelassen' : 'Keine zugelassenen Claims'}
      </p>
      {d.efsa_notes && (
        <p class:list={[
          'text-sm',
          d.efsa_health_claims_allowed ? 'text-emerald-700' : 'text-red-700'
        ]}>{d.efsa_notes}</p>
      )}
    </div>

    <!-- KI-Zusammenfassung -->
    <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-8 font-[system-ui]">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-lg" aria-hidden="true">🤖</span>
        <span class="text-xs font-mono font-semibold uppercase tracking-widest text-slate-400">KI-Zusammenfassung</span>
      </div>
      <div class="space-y-4 text-sm text-slate-700">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Kurz-Fazit</p>
          <p class="leading-relaxed">{d.summary}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Was die Evidenz stützt</p>
          <p class="leading-relaxed">{evidenceSupports}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Was NICHT belegt ist</p>
          <p class="leading-relaxed">{notBelegt}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">EU/EFSA-Status</p>
          <p class="leading-relaxed">{efsaStatus}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">Sicherheit</p>
          <p class="leading-relaxed">{safetyLabel[d.safety_rating]}</p>
        </div>
      </div>
      <p class="text-xs text-slate-400 mt-4 pt-3 border-t border-slate-200">
        Diese KI-Zusammenfassung basiert auf den strukturierten Daten dieser Seite.
      </p>
    </div>

    <!-- Article content -->
    <article class="prose max-w-none mb-10">
      <Content />
    </article>

    <!-- Key Studies -->
    {d.key_studies.length > 0 && (
      <div class="mb-8">
        <h2 class="text-lg font-semibold text-slate-800 mb-4">Wichtigste Studien</h2>
        <div class="space-y-3">
          {d.key_studies.map(study => (
            <div class="bg-white border border-slate-200 rounded-lg p-4">
              <p class="text-sm font-medium text-slate-800 mb-0.5">{study.title}</p>
              <p class="text-xs text-slate-500 mb-2">{study.authors} ({study.year})</p>
              <p class="text-sm text-slate-600 mb-2">{study.finding}</p>
              {study.url && (
                <a href={study.url} target="_blank" rel="noopener noreferrer"
                   class="text-xs text-teal-600 hover:underline">
                  PubMed {study.pmid ? `PMID ${study.pmid}` : '→'}
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Ernährungs-Check teaser (only for nutrients covered by the check) -->
    {checkSlugs.has(d.slug) && (
      <div class="bg-teal-50 border border-teal-200 rounded-xl p-5 mb-6">
        <div class="flex items-start gap-3">
          <span class="text-2xl">🥦</span>
          <div>
            <p class="font-semibold text-teal-900 mb-1">Wie gut bist du mit {d.title} versorgt?</p>
            <p class="text-sm text-teal-700 mb-3">Der Ernährungs-Check bewertet deine persönliche Versorgungslage in 60 Sekunden — basierend auf Ernährung und Lebensstil.</p>
            <a href="/ernaehrungs-check" class="inline-block text-sm font-medium bg-teal-600 text-white hover:bg-teal-700 rounded-lg px-4 py-2 no-underline transition-colors">
              Ernährungs-Check starten →
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Products for this ingredient -->
    {linkedProducts.length > 0 ? (
      <div class="mb-6" id="produkte">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-slate-800">Bewertete Produkte mit {d.title}</h2>
          <span class="text-sm text-slate-400">{linkedProducts.length} {linkedProducts.length === 1 ? 'Produkt' : 'Produkte'}</span>
        </div>
        <div class="space-y-3">
          {[...linkedProducts]
            .sort((a, b) => compositeScore(b.data.ratings) - compositeScore(a.data.ratings))
            .map((p, i) => {
              const score = compositeScore(p.data.ratings);
              return (
                <a href={`/produkte/${p.data.slug}`}
                   class="flex items-center justify-between bg-white border border-slate-200 rounded-xl px-5 py-4 hover:border-teal-400 transition-all no-underline group gap-4">
                  <div class="flex items-center gap-3 min-w-0">
                    {linkedProducts.length > 1 && (
                      <span class="text-xs font-bold text-slate-300 w-4 shrink-0">#{i + 1}</span>
                    )}
                    <div class="min-w-0">
                      <p class="font-medium text-slate-800 group-hover:text-teal-700 text-sm truncate">{p.data.title}</p>
                      <p class="text-xs text-slate-500">
                        {p.data.vendor}
                        <span class="mx-1 text-slate-300">·</span>
                        {p.data.doseMg} mg
                        <span class="mx-1 text-slate-300">·</span>
                        {p.data.pricePerDayEur.toFixed(2)} €/Tag
                        <span class="mx-1 text-slate-300">·</span>
                        {p.data.servingsPerPack} Tage/Packung
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    <span class="text-sm font-semibold text-slate-700">{score.toFixed(1)}<span class="text-xs font-normal text-slate-400">/10</span></span>
                    <VerdictBadge verdict={p.data.verdict} />
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    ) : (
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-6">
        <p class="font-semibold text-slate-700 mb-1">Produkte mit {d.title}</p>
        <p class="text-sm text-slate-500 mb-3">Noch keine bewerteten Produkte — wir arbeiten daran.</p>
        <a href="/produkte" class="text-sm text-teal-600 hover:text-teal-800 font-medium no-underline">
          Alle bewerteten Produkte ansehen →
        </a>
      </div>
    )}


    <!-- Editorial disclaimer -->
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mt-10 text-xs text-amber-800 leading-5">
      <strong>Redaktioneller Hinweis:</strong> Für die meisten hier beschriebenen Wirkstoffe existieren in der EU keine zugelassenen gesundheitsbezogenen Angaben (Health Claims gemäß VO (EG) 1924/2006). Die Evidenzstufen sind redaktionelle Einschätzungen der Forschungsqualität — keine Heilsversprechen. Dieser Inhalt ist kein Ersatz für medizinischen Rat und stellt keine Empfehlung zur Behandlung, Linderung oder Vorbeugung von Krankheiten dar.
    </div>

  </div>
</BaseLayout>
