---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import { getCollection } from 'astro:content';
import { readFileSync } from 'fs';

export async function getStaticPaths() {
  const indexData = JSON.parse(readFileSync('data/index.json', 'utf-8'));
  return (indexData.symptoms as string[])
    .filter((id: string) => !id.startsWith('kontra-') && !id.startsWith('nw-'))
    .map(id => ({ params: { id } }));
}

const { id } = Astro.params;
const symptomEntity = JSON.parse(readFileSync(`data/entities/symptoms/${id}.json`, 'utf-8'));
const rels = JSON.parse(readFileSync(`data/relations/by-entity/${id}.json`, 'utf-8'));

const ingredientIds = rels.relations
  .filter((r: any) => r.relation === 'wird_eingesetzt_fuer' && r.direction === 'incoming')
  .map((r: any) => r.target);

const allIngredients = await getCollection('ingredients');
const ingredientMap = new Map(allIngredients.map(i => [i.data.slug, i.data]));

// Look up per-symptom confidence AND symptom-specific evidence from study targets
const confidenceMap = new Map<string, number>();
const evidenceTierMap = new Map<string, string>();
const studyCountMap = new Map<string, number>();
const EV_TIER_RANK: Record<string, number> = { meta_analysis: 4, human_rct: 3, human_observational: 2, expert_review: 1 };

// Load study registry for study_type lookups
const studyTypeMap = new Map<string, string>();
try {
  const studyIndex = JSON.parse(readFileSync('data/study-index.json', 'utf-8'));
  for (const s of studyIndex.studies || []) {
    if (s.study_type) studyTypeMap.set(s.id, s.study_type);
  }
} catch {}

const STUDY_TYPE_TO_TIER: Record<string, string> = {
  'Meta-Analysis': 'meta_analysis', 'Systematic Review': 'meta_analysis',
  'RCT': 'human_rct', 'Controlled Clinical Trial': 'human_rct',
  'Clinical Trial': 'human_rct', 'Multicenter Study': 'human_rct',
  'Observational Study': 'human_observational', 'Comparative Study': 'human_observational',
  'Case Report': 'human_observational', 'Journal Article': 'expert_review',
  'Review': 'expert_review', 'Preprint': 'expert_review',
};

// Build symptom-specific evidence from study relations (untersucht)
import { readdirSync } from 'fs';

const targetMap = new Map<string, Map<string, { count: number; bestTier: string; bestRank: number }>>();
try {
  const studyFiles = readdirSync('data/relations/by-entity').filter(f => f.startsWith('studie-'));
  for (const fname of studyFiles) {
    const studyData = JSON.parse(readFileSync(`data/relations/by-entity/${fname}`, 'utf-8'));
    const studyId = studyData.entity;
    const studyType = studyTypeMap.get(studyId.replace('studie-', 'pmid-')) || '';
    const tier = STUDY_TYPE_TO_TIER[studyType] || 'expert_review';
    const rank = EV_TIER_RANK[tier] ?? 0;

    for (const rel of (studyData.relations || [])) {
      if (rel.relation !== 'untersucht') continue;
      const symptom = rel.target;
      if (!targetMap.has(studyId)) targetMap.set(studyId, new Map());
      const symMap = targetMap.get(studyId)!;
      if (!symMap.has(symptom)) {
        symMap.set(symptom, { count: 0, bestTier: tier, bestRank: rank });
      }
      const entry = symMap.get(symptom)!;
      entry.count++;
      if (rank > entry.bestRank) {
        entry.bestRank = rank;
        entry.bestTier = tier;
      }
    }
  }
} catch {}

for (const slug of ingredientIds) {
  try {
    const ingRels = JSON.parse(readFileSync(`data/relations/by-entity/${slug}.json`, 'utf-8'));
    const rel = ingRels.relations.find((r: any) => r.relation === 'wird_eingesetzt_fuer' && r.target === id);
    if (rel?.confidence) confidenceMap.set(slug, rel.confidence);

    // Symptom-specific evidence: check linked studies for untersucht targeting this symptom
    let bestTier = '';
    let bestRank = 0;
    let studyCount = 0;
    for (const r of ingRels.relations) {
      if (r.relation !== 'basiert_auf_studie' || !r.target) continue;
      const studySymMap = targetMap.get(r.target);
      if (studySymMap?.has(id!)) {
        const entry = studySymMap.get(id!)!;
        studyCount++;
        if (entry.bestRank > bestRank) {
          bestRank = entry.bestRank;
          bestTier = entry.bestTier;
        }
      }
    }
    if (bestTier) {
      evidenceTierMap.set(slug, bestTier);
      studyCountMap.set(slug, studyCount);
    }
  } catch {}
}

const matched = ingredientIds
  .map((slug: string) => ingredientMap.get(slug))
  .filter(Boolean)
  .sort((a: any, b: any) => (confidenceMap.get(b.slug) ?? 0) - (confidenceMap.get(a.slug) ?? 0));

const symptomLabels: Record<string, string> = {
  'schlaf': 'Schlaf', 'energie': 'Energie', 'kognition': 'Kognition',
  'immunsystem': 'Immunsystem', 'entzuendung': 'Entzündung', 'blutdruck': 'Blutdruck',
  'blutzucker': 'Blutzucker', 'stress': 'Stress', 'depression': 'Stimmung',
  'herz-kreislauf': 'Herz-Kreislauf', 'gelenke': 'Gelenke', 'haut': 'Haut',
  'muskel': 'Muskel', 'verdauung': 'Verdauung', 'alterung': 'Alterung',
  'oxidativer-stress': 'Oxidativer Stress', 'knochen': 'Knochen', 'augen': 'Augen',
  'leber': 'Leber', 'schilddruese': 'Schilddrüse', 'fertilitat': 'Fertilität',
  'migraene': 'Migräne', 'neuroprotektiv': 'Neuroprotektiv',
};

const label = symptomLabels[id!] || symptomEntity.name;

const safetyLabel: Record<string, string> = {
  'safe': 'Sicher', 'likely-safe': 'Wahrsch. sicher',
  'caution': 'Vorsicht', 'insufficient-data': 'Unklar',
};
const safetyStyle: Record<string, string> = {
  'safe': 'bg-emerald-100 text-emerald-800', 'likely-safe': 'bg-yellow-100 text-yellow-800',
  'caution': 'bg-orange-100 text-orange-800', 'insufficient-data': 'bg-slate-100 text-slate-700',
};

const tierLabel: Record<string, string> = {
  meta_analysis: 'Meta-Analyse', human_rct: 'RCT',
  human_observational: 'Beobachtung', expert_review: 'Review',
};
const tierStyle: Record<string, string> = {
  meta_analysis: 'bg-teal-100 text-teal-800',
  human_rct: 'bg-blue-100 text-blue-800',
  human_observational: 'bg-amber-100 text-amber-800',
  expert_review: 'bg-slate-100 text-slate-600',
};
---

<BaseLayout title={`Forschungsgebiet ${label} — untersuchte Wirkstoffe`} description={`${matched.length} Wirkstoffe, die in Studien auf eine Wirkung im Bereich ${label} untersucht wurden — sortiert nach Forschungsrelevanz.`}>
  <div class="max-w-4xl mx-auto px-4 py-12">

    <nav class="text-sm text-slate-400 mb-6">
      <a href="/wirkstoffe" class="hover:text-teal-600">Wirkstoffe</a>
      <span class="mx-2">›</span>
      <a href="/wirkstoffe" class="hover:text-teal-600">Nach Forschungsgebiet</a>
      <span class="mx-2">›</span>
      <span class="text-slate-600">{label}</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900 mb-2">Forschungsgebiet: {label}</h1>
      <p class="text-slate-600">{matched.length} Wirkstoffe, die in Studien auf eine Wirkung im Bereich {label} untersucht wurden — sortiert nach Forschungsrelevanz.</p>
    </div>

    <div class="space-y-3">
      {matched.map((ing: any) => (
        <a href={`/wirkstoffe/${ing.slug}`} class="group flex items-center justify-between bg-white border border-slate-200 rounded-xl px-5 py-4 hover:border-teal-300 hover:shadow-sm transition-all">
          <div class="flex items-center gap-4">
            <div class="flex flex-col items-center gap-1">
              <EvidenceBadge level={ing.evidenceLevel} />
              {evidenceTierMap.get(ing.slug) && (
                <span class={`text-[10px] font-medium px-1.5 py-0.5 rounded-full whitespace-nowrap ${tierStyle[evidenceTierMap.get(ing.slug)!]}`}>
                  {tierLabel[evidenceTierMap.get(ing.slug)!]}
                  {studyCountMap.get(ing.slug) ? ` (${studyCountMap.get(ing.slug)})` : ''}
                </span>
              )}
            </div>
            <div>
              <h2 class="font-semibold text-slate-900 group-hover:text-teal-700 transition-colors">{ing.title}</h2>
              <p class="text-sm text-slate-500 line-clamp-1">{ing.summary}</p>
            </div>
          </div>
          <div class="flex items-center gap-3 shrink-0 ml-4">
            <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${safetyStyle[ing.safety_rating] || 'bg-slate-100 text-slate-700'}`}>
              {safetyLabel[ing.safety_rating] || ing.safety_rating}
            </span>
            {ing.efsa_health_claims_allowed && (
              <span class="text-xs font-medium bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">EFSA ✓</span>
            )}
          </div>
        </a>
      ))}
    </div>

    {matched.length === 0 && (
      <div class="text-center py-12 text-slate-400">Keine Wirkstoffe für dieses Ziel gefunden.</div>
    )}

  </div>
</BaseLayout>
