---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import { getCollection } from 'astro:content';

const ingredients = await getCollection('ingredients');
---

<BaseLayout title="Wirkstoff-Dossiers" description="Evidenzbasierte Übersicht aller Longevity-Wirkstoffe: NMN, Resveratrol, Spermidine und mehr.">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Wirkstoff-Dossiers</h1>
    <p class="text-slate-600 mb-8">Was sagen die Studien wirklich? Alle Wirkstoffe mit Evidenzstufe, Sicherheitsbewertung und EFSA-Status.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {ingredients.map(ing => (
        <a
          href={`/wirkstoffe/${ing.data.slug}`}
          class="bg-white rounded-xl border border-slate-200 p-6 hover:border-teal-400 hover:shadow-sm transition-all no-underline group"
        >
          <div class="flex justify-between items-start mb-3">
            <h2 class="font-semibold text-slate-800 group-hover:text-teal-700">{ing.data.title}</h2>
            <EvidenceBadge level={ing.data.evidenceLevel} />
          </div>
          <p class="text-sm text-slate-500 mb-4 leading-relaxed">{ing.data.summary}</p>
          <div class="flex gap-2 text-xs">
            <span class:list={[
              'rounded-full px-2 py-0.5 font-medium',
              ing.data.efsa_health_claims_allowed
                ? 'bg-emerald-100 text-emerald-700'
                : 'bg-red-100 text-red-700'
            ]}>
              EFSA Claims: {ing.data.efsa_health_claims_allowed ? 'zugelassen' : 'keine'}
            </span>
            <span class:list={[
              'rounded-full px-2 py-0.5 font-medium',
              ing.data.safety_rating === 'safe' ? 'bg-emerald-100 text-emerald-700' :
              ing.data.safety_rating === 'likely-safe' ? 'bg-yellow-100 text-yellow-700' :
              'bg-red-100 text-red-700'
            ]}>
              {ing.data.safety_rating}
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
