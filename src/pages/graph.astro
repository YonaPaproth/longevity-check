---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Wissensgraph"
  description="Erkunde Verbindungen zwischen Wirkstoffen, Mechanismen, Biomarkern, Symptomen und regulatorischen Einordnungen im MikroScore-Wissensgraph."
  locale="de"
  hreflang={{ de: '/graph', en: '/en/graph' }}
>
  <div class="max-w-7xl mx-auto px-4 py-6">
    <div class="mb-5">
      <h1 class="text-2xl font-bold text-slate-900">Wissensgraph</h1>
      <p class="text-sm text-slate-500 mt-1 max-w-2xl">
        Der MikroScore-Wissensgraph zeigt, wie Wirkstoffe, Mechanismen, Symptome und regulatorische Einordnungen zusammenhängen — basierend auf unseren Dossiers und der aktuellen Studienlage.
      </p>
    </div>

    <details class="mb-5 group">
      <summary class="text-xs font-medium text-teal-700 cursor-pointer hover:text-teal-900 select-none">
        So funktioniert der Graph ↓
      </summary>
      <div class="mt-2 text-xs text-slate-500 leading-relaxed max-w-2xl space-y-1.5 pl-1">
        <p><strong class="text-slate-600">Knoten anklicken</strong> — fokussiert direkte Verbindungen und öffnet Details.</p>
        <p><strong class="text-slate-600">Suche</strong> — filtert den Graphen nach Name oder Alias (z.B. „Omega-3" oder „Curcumin").</p>
        <p><strong class="text-slate-600">Typ-Filter</strong> — blendet einzelne Kategorien ein oder aus.</p>
        <p><strong class="text-slate-600">Studien</strong> — werden mobil als Cluster zusammengefasst und lassen sich bei Bedarf aufklappen.</p>
      </div>
    </details>

    <div class="flex flex-col sm:flex-row gap-3 mb-4">
      <div class="relative flex-1 max-w-xs">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
        </svg>
        <input
          id="ks-search"
          type="search"
          placeholder="Suchen…"
          class="w-full pl-9 pr-3 h-11 text-sm border border-slate-300 rounded-lg bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
        />
      </div>

      <button
        id="ks-fit"
        class="min-h-11 flex items-center justify-center gap-1.5 px-4 text-xs font-medium text-slate-600 border border-slate-300 rounded-lg bg-white hover:bg-slate-50 transition-colors whitespace-nowrap"
        title="Graph einpassen"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/>
        </svg>
        Einpassen
      </button>

      <div class="flex rounded-lg overflow-hidden whitespace-nowrap" role="group" aria-label="Ansicht wählen">
        <button
          id="ks-mode-map"
          title="Organische Graphansicht"
          class="h-11 px-3 text-xs font-medium border-y border-l rounded-l-lg transition-colors"
        >Map</button>
        <button
          id="ks-mode-structured"
          title="Strukturierte Ansicht nach Regulatorik und Typ"
          class="h-11 px-3 text-xs font-medium border rounded-r-lg transition-colors"
        >Strukturiert</button>
      </div>
    </div>

    <div
      id="ks-type-filters"
      class="mb-2 flex gap-2 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 sm:overflow-visible"
      style="scrollbar-width:none;-webkit-overflow-scrolling:touch;"
    ></div>

    <!-- Evidence level filter -->
    <div
      id="ks-evidence-filters"
      class="mb-4 flex gap-1.5 overflow-x-auto pb-1 -mx-4 px-4 sm:mx-0 sm:px-0 sm:overflow-visible"
      style="scrollbar-width:none;-webkit-overflow-scrolling:touch;"
    ></div>

    <p class="text-xs text-slate-400 mb-3">
      <span id="ks-node-count">–</span> Knoten ·
      <span id="ks-edge-count">–</span> Verbindungen
    </p>

    <div class="flex flex-col lg:flex-row gap-4">
      <div
        id="ks-cy-container"
        data-locale="de"
        aria-label="Interaktiver Wissensgraph mit Knoten und Verbindungen. Tippen oder klicken Sie auf einen Knoten, um Zusammenhänge zu erkunden."
        class="relative flex-1 rounded-xl border border-slate-200 bg-white overflow-hidden h-[calc(100vh-260px)] min-h-[350px] sm:h-[calc(100vh-320px)] sm:min-h-[450px]"
      >
        <button
          id="ks-reset-selection"
          type="button"
          class="hidden absolute top-3 right-3 z-30 min-h-11 px-4 text-xs font-medium text-slate-700 border border-slate-200 rounded-full bg-white/95 shadow-sm backdrop-blur hover:bg-white transition-colors"
        >
          Zurück zur Übersicht
        </button>

        <div id="ks-loading" class="absolute inset-0 z-10 flex items-center justify-center text-slate-400 text-sm pointer-events-none">
          <svg class="animate-spin w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
          </svg>
          Graphdaten werden geladen…
        </div>

        <div id="ks-error" class="hidden absolute inset-0 z-10 flex items-center justify-center text-slate-400 text-sm px-6 text-center pointer-events-none">
          Graphdaten konnten nicht geladen werden.
        </div>

        <div id="ks-cy" class="absolute inset-0" style="touch-action:none"></div>
      </div>

      <div
        id="ks-node-detail"
        class="hidden lg:w-64 shrink-0 rounded-xl border border-slate-200 bg-white p-5 self-start"
      >
        <div class="flex items-center gap-2 mb-3">
          <span data-ks="badge" class="px-2 py-0.5 rounded-full text-white text-xs font-semibold"></span>
        </div>
        <h2 data-ks="name" class="font-semibold text-slate-900 text-sm leading-snug mb-3"></h2>
        <p data-ks="type-label" class="text-xs text-slate-500 mb-1">Typ</p>
        <p data-ks="type" class="text-sm text-slate-700 mb-2"></p>
        <p data-ks="connections" class="text-xs text-slate-400 mb-4"></p>
        <a
          data-ks="link"
          href="#"
          class="hidden inline-flex min-h-11 w-full items-center justify-center text-center text-sm font-medium text-white bg-teal-600 hover:bg-teal-700 rounded-lg px-4 py-2 no-underline transition-colors"
        >
          Dossier öffnen →
        </a>
        <p data-ks="no-link" class="hidden text-xs text-slate-400 italic"></p>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-4 text-xs text-slate-500">
      <span class="font-medium text-slate-600">Legende:</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block" style="background:#0d9488"></span>Wirkstoff</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block" style="background:#3b82f6"></span>Mechanismus</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block" style="background:#94a3b8"></span>Symptom</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block" style="background:#1e293b"></span>Kontraindikation</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block" style="background:#f59e0b"></span>Regulatorik</span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full inline-block" style="background:#6366f1"></span>Studie</span>
    </div>
  </div>

  <div id="ks-bottom-sheet" role="dialog" aria-label="Details zum ausgewählten Knoten" class="fixed inset-x-0 bottom-0 z-50 transform translate-y-full transition-transform duration-300 lg:hidden">
    <div class="relative bg-white rounded-t-2xl shadow-2xl border-t border-slate-200 max-h-[60vh] flex flex-col">
      <div class="flex justify-center pt-2 pb-1 cursor-grab" id="ks-sheet-handle">
        <div class="w-10 h-1 bg-slate-300 rounded-full"></div>
      </div>
      <button id="ks-sheet-close" class="absolute top-3 right-3 w-11 h-11 flex items-center justify-center text-slate-400 hover:text-slate-600" aria-label="Panel schließen">✕</button>
      <div class="px-5 pb-5 overflow-y-auto" style="padding-bottom: env(safe-area-inset-bottom, 20px)">
        <span data-ks="sheet-badge" class="inline-block px-2 py-0.5 rounded-full text-white text-xs font-semibold mb-2"></span>
        <h3 data-ks="sheet-name" class="font-semibold text-slate-900 text-base mb-1"></h3>
        <p data-ks="sheet-type" class="text-xs text-slate-500 mb-2"></p>
        <p data-ks="sheet-connections" class="text-xs text-slate-400 mb-3"></p>
        <div data-ks="sheet-related" class="mb-4"></div>
        <a data-ks="sheet-link" href="#" class="hidden inline-flex min-h-11 w-full items-center justify-center text-center text-sm font-medium text-white bg-teal-600 hover:bg-teal-700 rounded-lg px-4 py-2.5 no-underline transition-colors">Dossier öffnen →</a>
      </div>
    </div>
  </div>
  <div id="ks-sheet-backdrop" class="fixed inset-0 bg-black/20 z-40 hidden lg:hidden"></div>

  <script>
    import '../scripts/graph-viewer.ts';
  </script>
</BaseLayout>
