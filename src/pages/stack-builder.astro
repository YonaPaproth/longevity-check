---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const ingredientsCol = await getCollection('ingredients');
const products = await getCollection('products');

// Build ingredient list with display names
const ingredientList = [...ingredientsCol].map(i => {
  return { slug: i.data.slug, name: i.data.title };
}).sort((a, b) => a.name.localeCompare(b.name, 'de'));

// Build products JSON for client-side
const productsData = products.map(p => ({
  slug: p.data.slug,
  title: p.data.title,
  vendor: p.data.vendor,
  ingredient: p.data.ingredient,
  ci: (p.data as any).containedIngredients?.map((c: any) => c.slug) ?? [p.data.ingredient],
  ppd: p.data.pricePerDayEur,
  form: p.data.form,
  r: {
    e: p.data.ratings.evidenceForIngredient.score,
    v: p.data.ratings.valueForMoney.score,
    q: p.data.ratings.productQuality.score,
  },
  summary: p.data.summary,
}));
---

<BaseLayout
  title="Stack Builder | MikroScore"
  description="Finde die wenigsten Produkte, die alle deine Wunsch-Wirkstoffe abdecken. Optimiert nach Preis, Qualität und Evidenz."
  hreflang={{ de: '/stack-builder', en: '/en/stack-builder' }}
>
  <div class="max-w-4xl mx-auto px-4 py-10">
    <nav class="text-xs text-slate-400 mb-6">
      <a href="/" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">Stack Builder</span>
    </nav>

    <div class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-teal-50/40 shadow-sm mb-8">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.07),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(15,23,42,0.04),transparent_28%)]"></div>
      <div class="relative p-6">
        <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-3">Supplement-Optimierer</div>
        <h1 class="text-3xl font-bold text-slate-900 mb-2">Stack Builder</h1>
        <p class="text-slate-600">
          Wähle deine Wirkstoffe. Wir finden Produkte, die mehrere abdecken — damit du weniger Kapseln schluckst und weniger ausgibst.
        </p>
      </div>
    </div>

    <!-- Schritt 1: Wirkstoff-Auswahl -->
    <div id="step-select" class="mb-8">
      <h2 class="text-lg font-semibold text-slate-800 mb-3">1. Wähle deine Wirkstoffe</h2>
      <div class="mb-3">
        <input
          type="text"
          id="ingredient-search"
          placeholder="Wirkstoffe suchen…"
          class="w-full max-w-sm border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-400"
        />
      </div>
      <div id="ingredient-grid" class="flex flex-wrap gap-2">
        {ingredientList.map(i => (
          <button
            class="ingredient-btn rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-600 hover:border-teal-400 hover:text-teal-700 transition-all cursor-pointer select-none"
            data-slug={i.slug}
          >
            {i.name}
          </button>
        ))}
      </div>
      <div class="mt-3 text-xs text-slate-400">
        Ausgewählt: <span id="selected-count" class="font-semibold text-slate-600">0</span>
        <button id="clear-btn" class="ml-3 text-teal-600 hover:text-teal-800 hidden">Alle löschen</button>
      </div>
    </div>

    <!-- Schritt 2: Ergebnisse -->
    <div id="step-results" class="hidden">
      <h2 class="text-lg font-semibold text-slate-800 mb-3">2. Beste Treffer</h2>

      <!-- Optimaler Stack -->
      <div id="optimal-stack" class="mb-6"></div>

      <!-- Alle passenden Produkte -->
      <h3 class="text-sm font-semibold text-slate-600 mb-2 uppercase tracking-wider">Alle passenden Produkte</h3>
      <div id="all-matches" class="space-y-3"></div>
    </div>
  </div>

  <script define:vars={{ productsData, ingredientList }}>
    const selected = new Set();
    const buttons = document.querySelectorAll('.ingredient-btn');
    const searchInput = document.getElementById('ingredient-search');
    const countSpan = document.getElementById('selected-count');
    const clearBtn = document.getElementById('clear-btn');
    const resultsDiv = document.getElementById('step-results');
    const optimalDiv = document.getElementById('optimal-stack');
    const allMatchesDiv = document.getElementById('all-matches');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.slug;
        if (selected.has(slug)) {
          selected.delete(slug);
          btn.classList.remove('bg-teal-100', 'border-teal-400', 'text-teal-800');
          btn.classList.add('bg-white', 'border-slate-200', 'text-slate-600');
        } else {
          selected.add(slug);
          btn.classList.add('bg-teal-100', 'border-teal-400', 'text-teal-800');
          btn.classList.remove('bg-white', 'border-slate-200', 'text-slate-600');
        }
        updateResults();
      });
    });

    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase();
      buttons.forEach(btn => {
        const name = btn.textContent.toLowerCase();
        const slug = btn.dataset.slug;
        btn.style.display = (name.includes(q) || slug.includes(q)) ? '' : 'none';
      });
    });

    clearBtn.addEventListener('click', () => {
      selected.clear();
      buttons.forEach(btn => {
        btn.classList.remove('bg-teal-100', 'border-teal-400', 'text-teal-800');
        btn.classList.add('bg-white', 'border-slate-200', 'text-slate-600');
      });
      updateResults();
    });

    function updateResults() {
      countSpan.textContent = selected.size;
      clearBtn.classList.toggle('hidden', selected.size === 0);

      if (selected.size === 0) {
        resultsDiv.classList.add('hidden');
        return;
      }

      resultsDiv.classList.remove('hidden');
      const wanted = [...selected];

      const scored = productsData
        .map(p => {
          const overlap = p.ci.filter(s => wanted.includes(s));
          return { ...p, overlap, overlapCount: overlap.length };
        })
        .filter(p => p.overlapCount > 0)
        .sort((a, b) => {
          if (b.overlapCount !== a.overlapCount) return b.overlapCount - a.overlapCount;
          if (b.r.e !== a.r.e) return b.r.e - a.r.e;
          return a.ppd - b.ppd;
        });

      // Greedy Set Cover
      const stack = [];
      const uncovered = new Set(wanted);
      const usedProducts = new Set();

      while (uncovered.size > 0) {
        let best = null;
        let bestCover = 0;

        for (const p of scored) {
          if (usedProducts.has(p.slug)) continue;
          const covers = p.ci.filter(s => uncovered.has(s)).length;
          if (covers > bestCover || (covers === bestCover && best && p.r.e > best.r.e)) {
            best = p;
            bestCover = covers;
          }
        }

        if (!best || bestCover === 0) break;

        stack.push({ ...best, covers: best.ci.filter(s => uncovered.has(s)) });
        usedProducts.add(best.slug);
        best.ci.filter(s => uncovered.has(s)).forEach(s => uncovered.delete(s));
      }

      const totalPpd = stack.reduce((sum, p) => sum + p.ppd, 0);
      const coveredSlugs = new Set(stack.flatMap(p => p.covers));
      const missingIngredients = wanted.filter(s => !coveredSlugs.has(s));

      const getName = slug => ingredientList.find(i => i.slug === slug)?.name ?? slug;

      optimalDiv.innerHTML = `
        <div class="rounded-2xl border border-teal-200 bg-teal-50/50 p-5 mb-4">
          <div class="flex items-center justify-between mb-3">
            <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700">Optimierter Stack</div>
            <div class="text-sm font-semibold text-slate-800">
              ${stack.length} Produkt${stack.length !== 1 ? 'e' : ''} · ${totalPpd.toFixed(2)} €/Tag
            </div>
          </div>
          ${stack.map(p => `
            <div class="bg-white rounded-xl border border-slate-200 px-4 py-3 mb-2">
              <div class="flex items-center justify-between">
                <div>
                  <a href="/wirkstoffe/${p.ingredient}/produkte/${p.slug}" class="text-sm font-medium text-slate-800 hover:text-teal-700 no-underline">${p.title}</a>
                  <span class="text-xs text-slate-400 ml-2">${p.vendor}</span>
                </div>
                <div class="text-xs text-slate-500">${p.ppd.toFixed(2)} €/Tag</div>
              </div>
              <div class="flex flex-wrap gap-1 mt-2">
                ${p.covers.map(s => `<span class="rounded-full bg-teal-100 text-teal-800 px-2 py-0.5 text-[10px] font-medium">${getName(s)}</span>`).join('')}
                ${p.ci.filter(s => !wanted.includes(s)).map(s => `<span class="rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-[10px]">+ ${getName(s)}</span>`).join('')}
              </div>
            </div>
          `).join('')}
          ${missingIngredients.length > 0 ? `
            <div class="mt-3 text-xs text-amber-700 bg-amber-50 rounded-lg px-3 py-2 border border-amber-200">
              ⚠️ Keine passenden Produkte gefunden für: ${missingIngredients.map(getName).join(', ')}
              — hier brauchst du ggf. Einzelprodukte.
            </div>
          ` : `
            <div class="mt-3 text-xs text-teal-700 bg-teal-50 rounded-lg px-3 py-2 border border-teal-200">
              ✅ Alle ${wanted.length} Wirkstoffe abgedeckt!
            </div>
          `}
        </div>
      `;

      const multiMatches = scored.filter(p => p.overlapCount >= 2);
      const singleMatches = scored.filter(p => p.overlapCount === 1).slice(0, 20);

      allMatchesDiv.innerHTML = `
        ${multiMatches.length > 0 ? `
          <div class="text-xs font-semibold text-slate-500 mb-2">Kombi-Produkte (${multiMatches.length})</div>
          ${multiMatches.map(p => renderProduct(p, wanted)).join('')}
        ` : ''}
        <div class="text-xs font-semibold text-slate-500 mb-2 mt-4">Einzelprodukte (Top ${singleMatches.length})</div>
        ${singleMatches.map(p => renderProduct(p, wanted)).join('')}
      `;
    }

    function renderProduct(p, wanted) {
      const getName = slug => ingredientList.find(i => i.slug === slug)?.name ?? slug;
      const stars = (n) => '★'.repeat(Math.round(n / 2)) + '☆'.repeat(5 - Math.round(n / 2));
      return `
        <div class="bg-white rounded-xl border border-slate-200 px-4 py-3 hover:border-teal-300 transition-all">
          <div class="flex items-center justify-between">
            <div>
              <a href="/wirkstoffe/${p.ingredient}/produkte/${p.slug}" class="text-sm font-medium text-slate-800 hover:text-teal-700 no-underline">${p.title}</a>
              <span class="text-xs text-slate-400 ml-2">${p.vendor}</span>
            </div>
            <div class="text-right">
              <div class="text-xs font-medium text-slate-700">${p.ppd.toFixed(2)} €/Tag</div>
              <div class="text-[10px] text-amber-500" title="Evidenz: ${p.r.e}/10">${stars(p.r.e)}</div>
            </div>
          </div>
          <div class="flex flex-wrap gap-1 mt-2">
            ${p.overlap.map(s => `<span class="rounded-full bg-teal-100 text-teal-800 px-2 py-0.5 text-[10px] font-medium">${getName(s)}</span>`).join('')}
            ${p.ci.filter(s => !wanted.includes(s)).map(s => `<span class="rounded-full bg-slate-100 text-slate-500 px-2 py-0.5 text-[10px]">+ ${getName(s)}</span>`).join('')}
          </div>
        </div>
      `;
    }
  </script>
</BaseLayout>
