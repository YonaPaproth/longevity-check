---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import { getCollection } from 'astro:content';
import { compositeScore } from '../../utils/scoring';

const allProducts = await getCollection('products');
const allIngredients = await getCollection('ingredients');

const ingredientMap = new Map(allIngredients.map(i => [i.data.slug, i.data]));

const formLabel: Record<string, string> = {
  capsule: 'Kapsel', powder: 'Pulver', liquid: 'Flüssig',
  gummy: 'Gummi', softgel: 'Softgel', tablet: 'Tablette',
};

const categoryLabels: Record<string, string> = {
  'nad-precursors': 'NAD-Vorstufen',
  'senolytics':     'Senolytika',
  'antioxidants':   'Antioxidantien',
  'adaptogens':     'Adaptogene',
  'metabolic':      'Stoffwechsel',
  'other':          'Weitere',
};

// Group products by ingredient slug, sorted best-first within each group
const grouped = new Map<string, typeof allProducts>();
for (const p of allProducts) {
  const key = p.data.ingredient;
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(p);
}

// Build one card per ingredient group
const groups = [...grouped.entries()]
  .map(([ingredientSlug, products]) => {
    const sorted = [...products].sort(
      (a, b) => compositeScore(b.data.ratings) - compositeScore(a.data.ratings)
    );
    const top = sorted[0];
    const ingredient = ingredientMap.get(ingredientSlug);
    return {
      ingredientSlug,
      ingredientTitle: ingredient?.title ?? ingredientSlug,
      category: ingredient?.category ?? 'other',
      evidenceLevel: ingredient?.evidenceLevel,
      top,
      topScore: compositeScore(top.data.ratings),
      count: products.length,
    };
  })
  .sort((a, b) => b.topScore - a.topScore);

// Only show category buttons that have products
const usedCategories = [...new Set(groups.map(g => g.category))];
---

<BaseLayout title="Produktvergleich" description="Longevity-Supplements im Vergleich: NMN, Ashwagandha, Omega-3, Magnesium & mehr – redaktionell bewertet nach Preis, Qualität und Transparenz.">
  <div class="max-w-5xl mx-auto px-4 py-12">

    <section class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-teal-50/40 shadow-sm mb-8">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.08),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(15,23,42,0.05),transparent_28%)]"></div>
      <div class="relative p-6 md:p-8">
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900">Produktvergleich</h1>
        </div>
        <p class="text-slate-600 text-[15px] leading-7 max-w-3xl mb-6">
          Redaktionell eingeordnet nach Evidenzlage des Wirkstoffs, Preis pro Tagesdosis, Produktqualität, Label-Transparenz und Drittanbieter-Tests.
          Pro Wirkstoff zeigen wir aktuell das bestbewertete Produkt — von dort kommst du in den Detailvergleich.
        </p>


      </div>
    </section>

    <!-- Filter bar -->
    <div class="bg-white border border-slate-200 rounded-xl p-4 mb-6 space-y-3">
      <!-- Search -->
      <input
        id="prod-search"
        type="search"
        placeholder="Produkt oder Wirkstoff suchen…"
        class="w-full text-sm border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-teal-400"
      />
      <!-- Category chips -->
      <div class="flex flex-wrap gap-2">
        <button data-filter="category" data-value="all"
          class="filter-chip active text-xs rounded-full px-3 py-1 border font-medium transition-colors border-teal-500 bg-teal-500 text-white">
          Alle Kategorien
        </button>
        {usedCategories.map(cat => (
          <button data-filter="category" data-value={cat}
            class="filter-chip text-xs rounded-full px-3 py-1 border font-medium transition-colors border-slate-300 bg-white text-slate-600 hover:border-teal-400 hover:text-teal-700">
            {categoryLabels[cat] ?? cat}
          </button>
        ))}
      </div>
      <!-- Verdict chips -->
      <div class="flex flex-wrap gap-2">
        <button data-filter="verdict" data-value="all"
          class="filter-chip active text-xs rounded-full px-3 py-1 border font-medium transition-colors border-teal-500 bg-teal-500 text-white">
          Alle Urteile
        </button>
        <button data-filter="verdict" data-value="empfehlenswert"
          class="filter-chip text-xs rounded-full px-3 py-1 border font-medium transition-colors border-slate-300 bg-white text-slate-600 hover:border-teal-400 hover:text-teal-700">
          Empfehlenswert
        </button>
        <button data-filter="verdict" data-value="akzeptabel"
          class="filter-chip text-xs rounded-full px-3 py-1 border font-medium transition-colors border-slate-300 bg-white text-slate-600 hover:border-teal-400 hover:text-teal-700">
          Akzeptabel
        </button>
        <button data-filter="verdict" data-value="nicht-empfehlenswert"
          class="filter-chip text-xs rounded-full px-3 py-1 border font-medium transition-colors border-slate-300 bg-white text-slate-600 hover:border-teal-400 hover:text-teal-700">
          Nicht empfehlenswert
        </button>
      </div>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-4 text-xs text-amber-800 leading-5">
      <strong>Redaktioneller Hinweis:</strong> Die Produktübersicht bewertet vor allem Preis, Deklaration, Transparenz und formale Produktqualität. Die Kurztexte sind keine Health Claims und keine Empfehlung zur Behandlung, Linderung oder Vorbeugung von Krankheiten.
    </div>

    <!-- Results count -->
    <p id="results-count" class="text-xs text-slate-400 mb-4">{groups.length} Wirkstoffe</p>

    <!-- Ingredient groups -->
    <div id="product-grid" class="grid grid-cols-1 gap-5">
      {groups.map(group => {
        const d = group.top.data;
        const packDays = d.servingsPerPack;
        return (
          <article
               data-category={group.category}
               data-verdict={group.top.data.verdict}
               data-title={group.ingredientTitle.toLowerCase()}
               data-vendor={group.top.data.vendor.toLowerCase()}
               class="prod-card group rounded-[24px] border border-slate-200/80 bg-white/95 p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">

            <!-- Ingredient header -->
            <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-[0.12em]">
                    {categoryLabels[group.category] ?? group.category}
                  </span>
                  {group.count > 1 && (
                    <span class="text-xs bg-slate-100 text-slate-500 rounded-full px-2.5 py-1 border border-slate-200">
                      {group.count} Produkte
                    </span>
                  )}
                </div>
                <a href={`/wirkstoffe/${group.ingredientSlug}`}
                   class="text-lg font-semibold text-slate-900 hover:text-teal-600 no-underline tracking-tight">
                  {group.ingredientTitle}
                </a>
              </div>
              <div class="shrink-0">
                {group.evidenceLevel && <EvidenceBadge level={group.evidenceLevel} />}
              </div>
            </div>

            <!-- Top product -->
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-5 items-start">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-xs font-medium bg-slate-100 text-slate-600 rounded-full px-3 py-1.5 border border-slate-200">
                    {d.vendor}
                  </span>
                  <span class="text-xs font-medium bg-slate-50 text-slate-500 rounded-full px-3 py-1.5 border border-slate-200">
                    {formLabel[d.form] ?? d.form}
                  </span>
                  <span class="text-xs font-medium bg-slate-50 text-slate-500 rounded-full px-3 py-1.5 border border-slate-200">
                    {d.doseMg} mg
                  </span>
                </div>
                <p class="font-semibold text-slate-800 text-lg mb-1">{d.title}</p>
                <p class="text-sm text-slate-500 leading-6 max-w-2xl">{d.summary}</p>
              </div>

              <div class="w-full lg:w-[230px] rounded-2xl border border-slate-200 bg-slate-50/80 p-4">
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div>
                    <p class="text-2xl font-bold text-slate-900 leading-none">{d.pricePerDayEur.toFixed(2)} €</p>
                    <p class="text-xs text-slate-500 mt-1">pro Tag</p>
                  </div>
                  <div class="text-right">
                    <p class="text-2xl font-black text-slate-900 leading-none">{group.topScore.toFixed(1)}</p>
                    <p class="text-xs text-slate-400 mt-1">Score</p>
                  </div>
                </div>
                <div class="mb-3">
                  <VerdictBadge verdict={d.verdict} note={d.verdictNote} hideNote={true} />
                </div>
                <div class="text-xs text-slate-500 leading-5">
                  {packDays} Tage / Packung
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap items-center gap-3 mt-5 pt-5 border-t border-slate-100">
              {d.affiliateUrl && (
                <a href={d.affiliateUrl}
                   target="_blank"
                   rel="sponsored noopener noreferrer"
                   class="inline-flex items-center gap-1.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold rounded-xl px-4 py-2 no-underline transition-colors shadow-sm">
                  Zum Shop →
                </a>
              )}
              <a href={`/produkte/${d.slug}`}
                 class="inline-flex items-center gap-1.5 text-sm text-teal-600 hover:text-teal-800 font-medium no-underline">
                Bewertung lesen →
              </a>
              {group.count > 1 && (
                <a href={`/wirkstoffe/${group.ingredientSlug}#produkte`}
                   class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700 font-medium no-underline">
                  Alle {group.count} vergleichen →
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <!-- Affiliate disclosure -->
    <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50/80 p-5 text-xs text-slate-500 leading-6">
      Manche Links auf dieser Seite können Affiliate-Links sein. Für dich entstehen dabei keine Mehrkosten.
      Unsere Bewertungen werden ausschließlich nach inhaltlichen Kriterien erstellt — unabhängig von kommerziellen Beziehungen.
    </div>

  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('prod-search') as HTMLInputElement;
  const grid = document.getElementById('product-grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.prod-card'));
  const countEl = document.getElementById('results-count')!;

  let activeCategory = 'all';
  let activeVerdict = 'all';

  function applyFilters() {
    const q = searchInput.value.trim().toLowerCase();
    let visible = 0;
    cards.forEach(card => {
      const matchCat = activeCategory === 'all' || card.dataset.category === activeCategory;
      const matchVerdict = activeVerdict === 'all' || card.dataset.verdict === activeVerdict;
      const matchQ = !q || (card.dataset.title ?? '').includes(q) || (card.dataset.vendor ?? '').includes(q);
      const show = matchCat && matchVerdict && matchQ;
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    countEl.textContent = `${visible} ${visible === 1 ? 'Wirkstoff' : 'Wirkstoffe'}`;
  }

  document.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      const filterGroup = btn.dataset.filter!;
      const value = btn.dataset.value!;
      document.querySelectorAll<HTMLButtonElement>(`.filter-chip[data-filter="${filterGroup}"]`).forEach(b => {
        b.classList.remove('active', 'border-teal-500', 'bg-teal-500', 'text-white');
        b.classList.add('border-slate-300', 'bg-white', 'text-slate-600');
      });
      btn.classList.add('active', 'border-teal-500', 'bg-teal-500', 'text-white');
      btn.classList.remove('border-slate-300', 'bg-white', 'text-slate-600');
      if (filterGroup === 'category') activeCategory = value;
      if (filterGroup === 'verdict') activeVerdict = value;
      applyFilters();
    });
  });

  searchInput.addEventListener('input', applyFilters);
</script>
