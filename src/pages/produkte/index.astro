---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import { getCollection } from 'astro:content';
import { compositeScore } from '../../utils/scoring';

const allProducts = await getCollection('products');
const allIngredients = await getCollection('ingredients');

const ingredientMap = new Map(allIngredients.map(i => [i.data.slug, i.data]));

const formLabel: Record<string, string> = {
  capsule: 'Kapsel', powder: 'Pulver', liquid: 'Flüssig',
  gummy: 'Gummi', softgel: 'Softgel', tablet: 'Tablette',
};

const categoryLabels: Record<string, string> = {
  'nad-precursors': 'NAD-Vorstufen',
  'senolytics':     'Senolytika',
  'antioxidants':   'Antioxidantien',
  'adaptogens':     'Adaptogene',
  'metabolic':      'Stoffwechsel',
  'other':          'Weitere',
};

// Group products by ingredient slug, sorted best-first within each group
const grouped = new Map<string, typeof allProducts>();
for (const p of allProducts) {
  const key = p.data.ingredient;
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(p);
}

// Build one card per ingredient group
const groups = [...grouped.entries()]
  .map(([ingredientSlug, products]) => {
    const sorted = [...products].sort(
      (a, b) => compositeScore(b.data.ratings) - compositeScore(a.data.ratings)
    );
    const top = sorted[0];
    const ingredient = ingredientMap.get(ingredientSlug);
    return {
      ingredientSlug,
      ingredientTitle: ingredient?.title ?? ingredientSlug,
      category: ingredient?.category ?? 'other',
      evidenceLevel: ingredient?.evidenceLevel,
      top,
      topScore: compositeScore(top.data.ratings),
      count: products.length,
    };
  })
  .sort((a, b) => b.topScore - a.topScore);

// Only show category buttons that have products
const usedCategories = [...new Set(groups.map(g => g.category))];
---

<BaseLayout title="Produktvergleich" description="Longevity-Supplements im Vergleich: NMN, Ashwagandha, Omega-3, Magnesium & mehr – bewertet nach Studien, Preis und Qualität. Kostenlos, ohne Werbung.">
  <div class="max-w-5xl mx-auto px-4 py-12">

    <section class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-teal-50/40 shadow-sm mb-8">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.08),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(15,23,42,0.05),transparent_28%)]"></div>
      <div class="relative p-6 md:p-8">
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900">Produktvergleich</h1>
        </div>
        <p class="text-slate-600 text-[15px] leading-7 max-w-3xl mb-6">
          Bewertet nach Evidenz, Preis pro Tagesdosis, Qualität, Label-Ehrlichkeit und Drittanbieter-Tests.
          Pro Wirkstoff zeigen wir aktuell das beste Produkt — von dort kommst du in den Detailvergleich.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
            <div class="text-2xl font-bold text-slate-900">{groups.length}</div>
            <div class="text-sm text-slate-500 mt-1">Top-Produkte im Vergleich</div>
          </div>
          <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
            <div class="text-2xl font-bold text-slate-900">{usedCategories.length}</div>
            <div class="text-sm text-slate-500 mt-1">Wirkstoff-Kategorien</div>
          </div>
          <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
            <div class="text-2xl font-bold text-slate-900">1</div>
            <div class="text-sm text-slate-500 mt-1">Bestes Produkt pro Wirkstoff</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Category filter -->
    <div id="cat-filter" class="flex flex-wrap gap-3 mb-8">
      <button data-cat="all"
        class="cat-btn px-4 py-2 rounded-full text-sm font-medium border transition-colors shadow-sm bg-teal-600 text-white border-teal-600">
        Alle ({groups.length})
      </button>
      {usedCategories.map(cat => (
        <div class="inline-flex items-center gap-1.5">
          <button data-cat={cat}
            class="cat-btn px-4 py-2 rounded-full text-sm font-medium border transition-colors shadow-sm bg-white text-slate-600 border-slate-300 hover:border-teal-400 hover:text-teal-700">
            {categoryLabels[cat] ?? cat}
          </button>
          <a href={`/produkte/kategorie/${cat}`}
             class="inline-flex items-center justify-center rounded-full border border-transparent px-2 py-1 text-xs font-medium text-slate-400 hover:text-teal-600 hover:border-teal-200 no-underline"
             aria-label={`${categoryLabels[cat] ?? cat} – Kategorie-Seite`}>
            ↗
          </a>
        </div>
      ))}
    </div>

    <!-- Ingredient groups -->
    <div id="product-grid" class="grid grid-cols-1 gap-5">
      {groups.map(group => {
        const d = group.top.data;
        const packDays = d.servingsPerPack;
        return (
          <article data-category={group.category}
               class="group rounded-[24px] border border-slate-200/80 bg-white/95 p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md">

            <!-- Ingredient header -->
            <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-[0.12em]">
                    {categoryLabels[group.category] ?? group.category}
                  </span>
                  {group.count > 1 && (
                    <span class="text-xs bg-slate-100 text-slate-500 rounded-full px-2.5 py-1 border border-slate-200">
                      {group.count} Produkte
                    </span>
                  )}
                </div>
                <a href={`/wirkstoffe/${group.ingredientSlug}`}
                   class="text-lg font-semibold text-slate-900 hover:text-teal-600 no-underline tracking-tight">
                  {group.ingredientTitle}
                </a>
              </div>
              <div class="shrink-0">
                {group.evidenceLevel && <EvidenceBadge level={group.evidenceLevel} />}
              </div>
            </div>

            <!-- Top product -->
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-5 items-start">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="text-xs font-medium bg-slate-100 text-slate-600 rounded-full px-3 py-1.5 border border-slate-200">
                    {d.vendor}
                  </span>
                  <span class="text-xs font-medium bg-slate-50 text-slate-500 rounded-full px-3 py-1.5 border border-slate-200">
                    {formLabel[d.form] ?? d.form}
                  </span>
                  <span class="text-xs font-medium bg-slate-50 text-slate-500 rounded-full px-3 py-1.5 border border-slate-200">
                    {d.doseMg} mg
                  </span>
                </div>
                <p class="font-semibold text-slate-800 text-lg mb-1">{d.title}</p>
                <p class="text-sm text-slate-500 leading-6 max-w-2xl">{d.summary}</p>
              </div>

              <div class="w-full lg:w-[230px] rounded-2xl border border-slate-200 bg-slate-50/80 p-4">
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div>
                    <p class="text-2xl font-bold text-slate-900 leading-none">{d.pricePerDayEur.toFixed(2)} €</p>
                    <p class="text-xs text-slate-500 mt-1">pro Tag</p>
                  </div>
                  <div class="text-right">
                    <p class="text-2xl font-black text-slate-900 leading-none">{group.topScore.toFixed(1)}</p>
                    <p class="text-xs text-slate-400 mt-1">Score</p>
                  </div>
                </div>
                <div class="mb-3">
                  <VerdictBadge verdict={d.verdict} note={d.verdictNote} hideNote={true} />
                </div>
                <div class="text-xs text-slate-500 leading-5">
                  {packDays} Tage / Packung
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-wrap items-center gap-3 mt-5 pt-5 border-t border-slate-100">
              {d.affiliateUrl && (
                <a href={d.affiliateUrl}
                   target="_blank"
                   rel="sponsored noopener noreferrer"
                   class="inline-flex items-center gap-1.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold rounded-xl px-4 py-2 no-underline transition-colors shadow-sm">
                  Zum Shop →
                </a>
              )}
              <a href={`/produkte/${d.slug}`}
                 class="inline-flex items-center gap-1.5 text-sm text-teal-600 hover:text-teal-800 font-medium no-underline">
                Bewertung lesen →
              </a>
              {group.count > 1 && (
                <a href={`/wirkstoffe/${group.ingredientSlug}#produkte`}
                   class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700 font-medium no-underline">
                  Alle {group.count} vergleichen →
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <!-- Affiliate disclosure -->
    <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50/80 p-5 text-xs text-slate-500 leading-6">
      Manche Links auf dieser Seite können Affiliate-Links sein. Für dich entstehen dabei keine Mehrkosten.
      Unsere Bewertungen werden ausschließlich nach inhaltlichen Kriterien erstellt — unabhängig von kommerziellen Beziehungen.
    </div>

  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const cards = document.querySelectorAll<HTMLElement>('#product-grid [data-category]');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat!;

      // Update button styles
      buttons.forEach(b => {
        b.classList.remove('bg-teal-600', 'text-white', 'border-teal-600');
        b.classList.add('bg-white', 'text-slate-600', 'border-slate-300');
      });
      btn.classList.add('bg-teal-600', 'text-white', 'border-teal-600');
      btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-300');

      // Filter cards
      cards.forEach(card => {
        const show = cat === 'all' || card.dataset.category === cat;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
