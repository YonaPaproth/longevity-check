---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingBar from '../../components/RatingBar.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('products');
const filterIngredient = Astro.url.searchParams.get('wirkstoff');
const filtered = filterIngredient
  ? products.filter(p => p.data.ingredient === filterIngredient)
  : products;
---

<BaseLayout title="Produktvergleich" description="Konkrete Longevity-Supplements bewertet: Preis pro Tagesdosis, Zertifizierung, Reinheit.">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Produktvergleich</h1>
    <p class="text-slate-600 mb-8">
      Bewertet nach: Evidenz für den Wirkstoff, Preis/Tagesdosis, Produktqualität, Label-Ehrlichkeit, Drittanbieter-Tests.
    </p>

    <div class="grid grid-cols-1 gap-6">
      {filtered.map(product => {
        const d = product.data;
        const scores = d.ratings;
        const compositeScore = (
          scores.evidenceForIngredient.score * 0.10 +
          scores.valueForMoney.score * 0.30 +
          scores.productQuality.score * 0.25 +
          scores.labelHonesty.score * 0.20 +
          scores.thirdPartyTesting.score * 0.15
        );

        return (
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <div class="flex flex-wrap justify-between items-start gap-4 mb-5">
              <div>
                <h2 class="text-lg font-semibold text-slate-900">{d.title}</h2>
                <p class="text-sm text-slate-500">{d.vendor} · {d.doseMg} mg · {d.pricePerDayEur.toFixed(2)} €/Tag</p>
              </div>
              <div class="flex flex-col items-end gap-2">
                <VerdictBadge verdict={d.verdict} note={d.verdictNote} />
                <span class="text-xs text-slate-400">
                  Consumer Score: <strong class="text-slate-700">{compositeScore.toFixed(1)}/10</strong>
                </span>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 mb-5">
              <RatingBar
                label="Evidenz für Wirkstoff"
                score={scores.evidenceForIngredient.score}
                explanation={scores.evidenceForIngredient.explanation}
                highlight={true}
              />
              <RatingBar
                label="Preis/Leistung"
                score={scores.valueForMoney.score}
                explanation={scores.valueForMoney.explanation}
              />
              <RatingBar
                label="Produktqualität"
                score={scores.productQuality.score}
                explanation={scores.productQuality.explanation}
              />
              <RatingBar
                label="Label-Ehrlichkeit"
                score={scores.labelHonesty.score}
                explanation={scores.labelHonesty.explanation}
              />
              <RatingBar
                label="Drittanbieter-Tests"
                score={scores.thirdPartyTesting.score}
                explanation={scores.thirdPartyTesting.explanation}
              />
            </div>

            {d.certifications.length > 0 && (
              <div class="flex gap-2 flex-wrap mb-4">
                {d.certifications.map(cert => (
                  <span class="text-xs bg-emerald-100 text-emerald-700 rounded-full px-2.5 py-0.5">{cert}</span>
                ))}
              </div>
            )}

            <div class="flex gap-3">
              <a href={`/produkte/${d.slug}`} class="text-sm text-teal-600 hover:text-teal-800 font-medium no-underline">
                Vollständige Bewertung →
              </a>
              {d.affiliateUrl && (
                <a href={d.affiliateUrl} target="_blank" rel="noopener sponsored noreferrer"
                   class="text-sm text-slate-500 hover:text-slate-700 no-underline">
                  Preis prüfen ↗
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</BaseLayout>
