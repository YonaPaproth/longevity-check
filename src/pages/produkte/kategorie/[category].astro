---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EvidenceBadge from '../../../components/EvidenceBadge.astro';
import VerdictBadge from '../../../components/VerdictBadge.astro';
import { getCollection } from 'astro:content';
import { compositeScore } from '../../../utils/scoring';

export async function getStaticPaths() {
  const categories = [
    'nad-precursors',
    'senolytics',
    'antioxidants',
    'adaptogens',
    'metabolic',
    'other',
  ];
  return categories.map(category => ({ params: { category } }));
}

const categoryMeta: Record<string, { title: string; description: string }> = {
  'nad-precursors': {
    title: 'NAD-Vorstufen',
    description: 'Vorstufen wie NMN, NR oder TMG sollen den zellulären NAD+-Spiegel stabil halten. Sie richten sich an Menschen, die Energieproduktion, DNA-Reparatur und metabolische Resilienz im Alter unterstützen möchten.',
  },
  'senolytics': {
    title: 'Senolytika',
    description: 'Senolytische Wirkstoffe sollen alte, dysfunktionale Zellen reduzieren, die Entzündungen schüren. Der Forschungsstand ist heterogen – Humanstudien stehen erst am Anfang.',
  },
  'antioxidants': {
    title: 'Antioxidantien',
    description: 'Antioxidantien fangen freie Radikale ab oder aktivieren körpereigene Schutzsysteme wie Nrf2. Sie sind kein Allheilmittel, können aber oxidativen Stress bei spezifischen Anwendungen abfedern.',
  },
  'adaptogens': {
    title: 'Adaptogene',
    description: 'Adaptogene stammen meist aus der traditionellen Pflanzenmedizin und sollen den Körper widerstandsfähiger gegen Stress machen. Die Evidenz reicht von soliden Studien (Ashwagandha) bis zu frühen Hypothesen.',
  },
  'metabolic': {
    title: 'Metabolismus & Stoffwechsel',
    description: 'Diese Wirkstoffe zielen auf Insulinsensitivität, Blutfette oder Energiestoffwechsel. Sie sind relevant für Menschen mit metabolischen Risikofaktoren oder ambitionierten Fitness-Zielen.',
  },
  other: {
    title: 'Weitere Longevity-Wirkstoffe',
    description: 'Alles, was in keine klare Schublade fällt: von Nährstoffen mit Spezialrolle bis zu neueren Longevity-Kandidaten. Hier findest du spannende, aber oft noch wenig erforschte Substanzen.',
  },
};

const pluralize = (count: number, singular: string, plural: string) =>
  `${count} ${count === 1 ? singular : plural}`;

const { category } = Astro.params;
const categoryInfo = categoryMeta[category] ?? {
  title: category,
  description: 'Diese Kategorie bündelt Wirkstoffe, für die wir bereits Bewertungen und Produkte gelistet haben.',
};

const allIngredients = await getCollection('ingredients');
const allProducts = await getCollection('products');
const ingredientBySlug = new Map(allIngredients.map(entry => [entry.data.slug, entry]));

const ingredientsInCategory = allIngredients
  .filter(entry => entry.data.category === category)
  .map(entry => ({
    entry,
    productCount: allProducts.filter(product => product.data.ingredient === entry.data.slug).length,
  }))
  .sort((a, b) => {
    if (b.productCount !== a.productCount) return b.productCount - a.productCount;
    return a.entry.data.title.localeCompare(b.entry.data.title, 'de');
  });

const ingredientSlugs = new Set(ingredientsInCategory.map(item => item.entry.data.slug));

const productsInCategory = allProducts
  .filter(product => ingredientSlugs.has(product.data.ingredient))
  .map(product => ({
    product,
    ingredient: ingredientBySlug.get(product.data.ingredient),
    score: compositeScore(product.data.ratings),
  }))
  .sort((a, b) => b.score - a.score);

const ingredientCount = ingredientsInCategory.length;
const productCount = productsInCategory.length;

const formLabel: Record<string, string> = {
  capsule: 'Kapsel', powder: 'Pulver', liquid: 'Flüssig',
  gummy: 'Gummi', softgel: 'Softgel', tablet: 'Tablette',
};
---

<BaseLayout
  title={`${categoryInfo.title} – Produkte & Wirkstoffe`}
  description={categoryInfo.description}
>
  <div class="max-w-5xl mx-auto px-4 py-10">

    <nav class="text-xs text-slate-400 mb-6">
      <a href="/" class="hover:text-teal-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/produkte" class="hover:text-teal-600">Produkte</a>
      <span class="mx-2">/</span>
      <span class="text-slate-600">{categoryInfo.title}</span>
    </nav>

    <section class="relative overflow-hidden rounded-[28px] border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-teal-50/40 shadow-sm mb-10">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.08),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(15,23,42,0.05),transparent_28%)]"></div>
      <div class="relative p-6 md:p-8">
        <p class="text-xs font-semibold text-teal-600 uppercase tracking-[0.2em] mb-2">Kategorie</p>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 mb-4">{categoryInfo.title}</h1>
        <p class="text-slate-600 text-[15px] leading-7 max-w-3xl mb-6">{categoryInfo.description}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
            <div class="text-2xl font-bold text-slate-900">{ingredientCount}</div>
            <div class="text-sm text-slate-500 mt-1">{ingredientCount === 1 ? 'Wirkstoff' : 'Wirkstoffe'}</div>
          </div>
          <div class="rounded-2xl border border-white/70 bg-white/80 p-4 shadow-sm backdrop-blur">
            <div class="text-2xl font-bold text-slate-900">{productCount}</div>
            <div class="text-sm text-slate-500 mt-1">{productCount === 1 ? 'Produkt' : 'Produkte'}</div>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <h2 class="text-lg font-semibold text-slate-900">Wirkstoffe in dieser Kategorie</h2>
        <span class="text-sm text-slate-500">{pluralize(ingredientCount, 'Wirkstoff', 'Wirkstoffe')}</span>
      </div>

      {ingredientCount > 0 ? (
        <div class="space-y-3">
          {ingredientsInCategory.map(({ entry, productCount }) => (
            <a href={`/wirkstoffe/${entry.data.slug}`}
               class="group flex flex-wrap items-center gap-4 justify-between rounded-2xl border border-slate-200 bg-white/90 px-5 py-4 shadow-sm no-underline hover:border-teal-400 transition-colors">
              <div class="min-w-0">
                <p class="font-semibold text-slate-900 group-hover:text-teal-700 transition-colors">{entry.data.title}</p>
                <p class="text-sm text-slate-500 leading-6">{entry.data.summary}</p>
              </div>
              <div class="flex items-center gap-4 shrink-0">
                {entry.data.evidenceLevel && <EvidenceBadge level={entry.data.evidenceLevel} />}
                <span class="text-sm font-medium text-slate-500 min-w-[90px] text-right">{pluralize(productCount, 'Produkt', 'Produkte')}</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50/80 p-6 text-sm text-slate-500">
          Für diese Kategorie sind noch keine Wirkstoff-Dossiers veröffentlicht.
        </div>
      )}
    </section>

    <section>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <h2 class="text-lg font-semibold text-slate-900">Alle Produkte in {categoryInfo.title}</h2>
        <span class="text-sm text-slate-500">{pluralize(productCount, 'Produkt', 'Produkte')}</span>
      </div>

      {productCount > 0 ? (
        <div class="space-y-5">
          {productsInCategory.map(({ product, ingredient, score }) => {
            const d = product.data;
            const ingredientTitle = ingredient?.data.title ?? d.ingredient;
            return (
              <article class="rounded-[24px] border border-slate-200 bg-white/95 p-6 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                  <div>
                    <div class="flex flex-wrap items-center gap-2 mb-2 text-xs text-slate-500">
                      <span class="font-medium bg-slate-100 text-slate-600 rounded-full px-3 py-1 border border-slate-200">{d.vendor}</span>
                      <a href={`/wirkstoffe/${ingredient?.data.slug ?? d.ingredient}`}
                         class="font-medium bg-teal-50 text-teal-700 rounded-full px-3 py-1 border border-teal-200 hover:bg-teal-100 no-underline">
                        {ingredientTitle}
                      </a>
                      <span class="font-medium bg-slate-50 text-slate-500 rounded-full px-3 py-1 border border-slate-200">
                        {formLabel[d.form] ?? d.form}
                      </span>
                      <span class="font-medium bg-slate-50 text-slate-500 rounded-full px-3 py-1 border border-slate-200">
                        {d.doseMg} mg
                      </span>
                    </div>
                    <h3 class="text-xl font-semibold text-slate-900 mb-2">{d.title}</h3>
                    <p class="text-sm text-slate-600 leading-6 max-w-3xl">{d.summary}</p>
                  </div>
                  <div class="text-right">
                    <p class="text-4xl font-black text-slate-900 leading-none">{score.toFixed(1)}</p>
                    <p class="text-xs text-slate-400 mt-1">Transparenz-Index</p>
                    <div class="mt-3"><VerdictBadge verdict={d.verdict} note={d.verdictNote} hideNote={true} /></div>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-4 text-sm text-slate-600 mb-4">
                  <span class="font-semibold text-slate-900">{d.pricePerDayEur.toFixed(2)} €</span>
                  <span>pro Tag · {d.servingsPerPack} Tage pro Packung</span>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                  <a href={`/produkte/${d.slug}`}
                     class="inline-flex items-center gap-1.5 text-sm text-teal-600 hover:text-teal-800 font-medium no-underline">
                    Bewertung lesen →
                  </a>
                  {d.affiliateUrl ? (
                    <a href={d.affiliateUrl}
                       target="_blank"
                       rel="sponsored noopener noreferrer"
                       class="inline-flex items-center gap-1.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold rounded-xl px-4 py-2 no-underline shadow-sm">
                      Zum Shop →
                    </a>
                  ) : d.vendorUrl ? (
                    <a href={d.vendorUrl}
                       target="_blank"
                       rel="noopener noreferrer"
                       class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700 font-medium no-underline">
                      Anbieter-Website ↗
                    </a>
                  ) : null}
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50/80 p-6 text-sm text-slate-500">
          Für diese Kategorie sind noch keine Produkte bewertet. Trag dich in den Newsletter ein, um Updates zu erhalten.
        </div>
      )}
    </section>

  </div>
</BaseLayout>
