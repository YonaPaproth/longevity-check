---
import {
  getEntityById,
  getOutgoingRelations,
  getEntityPath,
  getStudyExternalUrl,
  getEntityLabel,
} from '../lib/graph/index.ts';
import type { GraphEntity, GraphLocale, GraphRelation } from '../lib/graph/index.ts';

interface Props {
  claimSlug: string;
  ingredientSlug?: string;
  locale?: GraphLocale;
  studyIds?: string[];
  claimContext?: {
    claimEntityId?: string;
    ingredientEvidenceScore?: number;
    animalEvidence?: 'positiv' | 'gemischt' | 'begrenzt' | 'negativ' | 'keine-daten';
    humanEvidence?: 'stark' | 'moderat' | 'begrenzt' | 'negativ' | 'keine-daten';
    regulatoryStatus?: string;
    relatedMechanisms?: string[];
    relatedSymptoms?: string[];
    relatedIngredients?: string[];
  };
}

const { claimSlug, ingredientSlug, claimContext, studyIds = [], locale = 'de' } = Astro.props;

const copy = {
  de: {
    eyebrow: 'Claim context',
    title: 'Claim im Kontext',
    ingredient: 'Wirkstoff',
    ingredientEvidence: 'Wirkstoff-Evidenz',
    animalEvidence: 'Tierdaten zum Claim',
    humanEvidence: 'Humandaten zum Claim',
    regulatoryStatus: 'EU-Claim-Status',
    mechanisms: 'Mechanistisch verknüpft mit',
    symptoms: 'Zielt thematisch auf',
    relatedIngredients: 'Verwandte Wirkstoffe',
    studies: 'Studienbasis',
    studyLink: 'Studie öffnen',
    noApprovedClaims: 'nicht zugelassen',
    approvedClaims: 'zugelassen',
  },
  en: {
    eyebrow: 'Claim context',
    title: 'Evidence context',
    ingredient: 'Ingredient',
    ingredientEvidence: 'Ingredient evidence score',
    animalEvidence: 'Animal evidence for claim',
    humanEvidence: 'Human evidence for claim',
    regulatoryStatus: 'Regulatory status',
    mechanisms: 'Mechanistically linked to',
    symptoms: 'Targets thematically',
    relatedIngredients: 'Related ingredients',
    studies: 'Study basis',
    studyLink: 'Open study',
    noApprovedClaims: 'not approved',
    approvedClaims: 'approved',
  },
} as const;

const t = copy[locale];

function labelForEvidence(value?: string) {
  switch (value) {
    case 'positiv': return locale === 'en' ? 'positive' : 'positiv';
    case 'gemischt': return locale === 'en' ? 'mixed' : 'gemischt';
    case 'begrenzt': return locale === 'en' ? 'limited' : 'begrenzt';
    case 'negativ': return locale === 'en' ? 'negative' : 'negativ';
    case 'keine-daten': return locale === 'en' ? 'no data' : 'keine Daten';
    case 'stark': return locale === 'en' ? 'strong' : 'stark';
    case 'moderat': return locale === 'en' ? 'moderate' : 'moderat';
    default: return value;
  }
}

function regulatoryLabel(value?: string) {
  if (!value) return undefined;
  if (value === 'efsa-nicht-zugelassen') return t.noApprovedClaims;
  if (value === 'efsa-zugelassen') return t.approvedClaims;
  const entity = getEntityById(value);
  return getEntityLabel(entity, locale) ?? value;
}

function uniqueEntities(entities: Array<GraphEntity | undefined>) {
  const seen = new Set<string>();
  const result: GraphEntity[] = [];
  for (const entity of entities) {
    if (!entity || seen.has(entity.id)) continue;
    seen.add(entity.id);
    result.push(entity);
  }
  return result;
}

function relatedEntitiesFromRelations(relations: GraphRelation[], relationType: string) {
  return uniqueEntities(
    relations
      .filter((r) => r.relation === relationType && r.direction === 'outgoing')
      .map((r) => getEntityById(r.target))
  );
}

function relatedEntitiesFromIds(ids: string[] = []) {
  return uniqueEntities(ids.map((id) => getEntityById(id)));
}

function mergeStudies(
  relationStudies: Array<{ entity: GraphEntity; relation?: GraphRelation }>,
  fallbackStudies: GraphEntity[],
) {
  const seen = new Set<string>();
  const merged: Array<{ entity: GraphEntity; relation?: GraphRelation }> = [];

  for (const item of relationStudies) {
    if (seen.has(item.entity.id)) continue;
    seen.add(item.entity.id);
    merged.push(item);
  }

  for (const entity of fallbackStudies) {
    if (seen.has(entity.id)) continue;
    seen.add(entity.id);
    merged.push({ entity });
  }

  return merged;
}

const claimEntityId = claimContext?.claimEntityId ?? claimSlug;
const claimEntity = getEntityById(claimEntityId);
const relations = getOutgoingRelations(claimEntityId);

const ingredientEntity = getEntityById(ingredientSlug ?? (typeof claimEntity?.ingredient === 'string' ? claimEntity.ingredient : ''));
const ingredientName = getEntityLabel(ingredientEntity, locale) ?? ingredientSlug;
const ingredientPath = ingredientEntity ? getEntityPath(ingredientEntity, locale) : undefined;

const regulatoryRelation = relations.find((r) => r.relation === 'hat_regulatorischen_status');
const linkedMechanisms = relatedEntitiesFromRelations(relations, 'wirkt_ueber');
const linkedSymptoms = relatedEntitiesFromRelations(relations, 'zielt_auf');
const linkedIngredients = relatedEntitiesFromRelations(relations, 'verwandter_wirkstoff');
const linkedStudies = relations
  .filter((r) => r.relation === 'basiert_auf_studie' && r.direction === 'outgoing')
  .map((relation) => ({ entity: getEntityById(relation.target), relation }))
  .filter((item): item is { entity: GraphEntity; relation: GraphRelation } => Boolean(item.entity));

const fallbackMechanisms = relatedEntitiesFromIds(claimContext?.relatedMechanisms ?? []);
const fallbackSymptoms = relatedEntitiesFromIds(claimContext?.relatedSymptoms ?? []);
const fallbackIngredients = relatedEntitiesFromIds(claimContext?.relatedIngredients ?? []);
const fallbackStudies = relatedEntitiesFromIds(studyIds);

const mechanisms = linkedMechanisms.length > 0 ? linkedMechanisms : fallbackMechanisms;
const symptoms = linkedSymptoms.length > 0 ? linkedSymptoms : fallbackSymptoms;
const relatedIngredients = linkedIngredients.length > 0 ? linkedIngredients : fallbackIngredients;
const studies = mergeStudies(linkedStudies, fallbackStudies);

const ingredientEvidenceScore = claimContext?.ingredientEvidenceScore;
const animalEvidence = claimContext?.animalEvidence;
const humanEvidence = claimContext?.humanEvidence;
const regulatoryStatus = claimContext?.regulatoryStatus ?? regulatoryRelation?.target;

const hasContent = ingredientEntity || ingredientEvidenceScore !== undefined || animalEvidence || humanEvidence || regulatoryStatus || mechanisms.length > 0 || symptoms.length > 0 || relatedIngredients.length > 0 || studies.length > 0;
---

{hasContent && (
  <section class="rounded-2xl border border-slate-200 bg-white p-5 md:p-6 shadow-sm mb-8">
    <div class="flex items-start justify-between gap-4 mb-5">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700 mb-2">{t.eyebrow}</p>
        <h2 class="text-xl font-semibold text-slate-900">{t.title}</h2>
      </div>
      <div class="hidden sm:flex h-10 w-10 items-center justify-center rounded-full bg-teal-50 text-teal-700">↗</div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
      {ingredientEntity && (
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">{t.ingredient}</p>
          {ingredientPath ? (
            <a href={ingredientPath} class="font-medium text-slate-900 hover:text-teal-700 no-underline">{ingredientName} →</a>
          ) : (
            <p class="font-medium text-slate-900">{ingredientName}</p>
          )}
        </div>
      )}

      {ingredientEvidenceScore !== undefined && (
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">{t.ingredientEvidence}</p>
          <p class="font-medium text-slate-900">{ingredientEvidenceScore}/10</p>
        </div>
      )}

      {animalEvidence && (
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">{t.animalEvidence}</p>
          <p class="font-medium text-slate-900">{labelForEvidence(animalEvidence)}</p>
        </div>
      )}

      {humanEvidence && (
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">{t.humanEvidence}</p>
          <p class="font-medium text-slate-900">{labelForEvidence(humanEvidence)}</p>
        </div>
      )}

      {regulatoryStatus && (
        <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 sm:col-span-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-1">{t.regulatoryStatus}</p>
          <p class="font-medium text-slate-900">{regulatoryLabel(regulatoryStatus)}</p>
        </div>
      )}
    </div>

    {(mechanisms.length > 0 || symptoms.length > 0 || relatedIngredients.length > 0 || studies.length > 0) && (
      <div class="space-y-4">
        {mechanisms.length > 0 && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">{t.mechanisms}</p>
            <div class="flex flex-wrap gap-2">
              {mechanisms.map((entity) => (
                <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700">{getEntityLabel(entity, locale)}</span>
              ))}
            </div>
          </div>
        )}

        {symptoms.length > 0 && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">{t.symptoms}</p>
            <div class="flex flex-wrap gap-2">
              {symptoms.map((entity) => {
                const path = getEntityPath(entity, locale);
                return path ? (
                  <a href={path} class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700 no-underline hover:border-teal-300 hover:text-teal-700">{getEntityLabel(entity, locale)}</a>
                ) : (
                  <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700">{getEntityLabel(entity, locale)}</span>
                );
              })}
            </div>
          </div>
        )}

        {relatedIngredients.length > 0 && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">{t.relatedIngredients}</p>
            <div class="flex flex-wrap gap-2">
              {relatedIngredients.map((entity) => {
                const path = getEntityPath(entity, locale);
                return path ? (
                  <a href={path} class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700 no-underline hover:border-teal-300 hover:text-teal-700">{getEntityLabel(entity, locale)}</a>
                ) : (
                  <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700">{getEntityLabel(entity, locale)}</span>
                );
              })}
            </div>
          </div>
        )}

        {studies.length > 0 && (
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">{t.studies}</p>
            <div class="space-y-3">
              {studies.map(({ entity, relation }) => {
                const studyUrl = getStudyExternalUrl(entity);
                const studyTitle = getEntityLabel(entity, locale) ?? entity.id;
                const authors = typeof entity.authors === 'string' ? entity.authors : undefined;
                const year = typeof entity.year === 'number' ? entity.year : undefined;
                const summary = typeof relation?.note === 'string' && relation.note.length > 0
                  ? relation.note
                  : typeof entity.summary === 'string'
                    ? entity.summary
                    : undefined;

                return (
                  <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                      <div class="min-w-0">
                        <p class="font-medium text-slate-900 leading-snug">{studyTitle}</p>
                        {(authors || year) && (
                          <p class="text-sm text-slate-600 mt-1">{[authors, year].filter(Boolean).join(' · ')}</p>
                        )}
                      </div>
                      {studyUrl && (
                        <a href={studyUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-teal-700 hover:text-teal-800 no-underline whitespace-nowrap">
                          {t.studyLink} ↗
                        </a>
                      )}
                    </div>
                    {summary && (
                      <p class="text-sm text-slate-700 mt-2 leading-6">{summary}</p>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>
    )}
  </section>
)}
