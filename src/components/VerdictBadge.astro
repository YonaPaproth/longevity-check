---
interface Props {
  verdict: 'empfehlenswert' | 'akzeptabel' | 'nicht-empfehlenswert' | 'belegt' | 'uebertrieben' | 'falsch' | 'zu-frueh';
  note?: string;
}

const { verdict, note } = Astro.props;

const config = {
  'empfehlenswert':       { label: 'Empfehlenswert',        style: 'bg-emerald-100 text-emerald-800 border-emerald-300' },
  'akzeptabel':           { label: 'Akzeptabel',            style: 'bg-yellow-100 text-yellow-800 border-yellow-300' },
  'nicht-empfehlenswert': { label: 'Nicht empfehlenswert',  style: 'bg-red-100 text-red-800 border-red-300' },
  'belegt':               { label: '✓ Belegt',              style: 'bg-emerald-100 text-emerald-800 border-emerald-300' },
  'uebertrieben':         { label: '~ Übertrieben',         style: 'bg-yellow-100 text-yellow-800 border-yellow-300' },
  'falsch':               { label: '✗ Falsch',              style: 'bg-red-100 text-red-800 border-red-300' },
  'zu-frueh':             { label: '? Zu früh',             style: 'bg-slate-100 text-slate-700 border-slate-300' },
} as const;

const { label, style } = config[verdict];
---

<div class="inline-flex flex-col gap-1.5">
  <span class:list={['inline-flex items-center rounded-lg border px-3 py-1.5 text-sm font-semibold', style]}>
    {label}
  </span>
  {note && <span class="text-xs text-slate-500 leading-relaxed">{note}</span>}
</div>
