---
import { de } from '../i18n/de';
import { en } from '../i18n/en';

interface Props {
  verdict: 'empfehlenswert' | 'akzeptabel' | 'nicht-empfehlenswert' | 'belegt' | 'uebertrieben' | 'falsch' | 'zu-frueh';
  note?: string;
  hideNote?: boolean;
}

const { verdict, note, hideNote = false } = Astro.props;
const isEn = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname === '/en';
const dict = isEn ? en : de;

const styles: Record<string, string> = {
  'empfehlenswert':       'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200',
  'akzeptabel':           'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200',
  'nicht-empfehlenswert': 'bg-red-50 text-red-700 ring-1 ring-inset ring-red-200',
  'belegt':               'bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-200',
  'uebertrieben':         'bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-200',
  'falsch':               'bg-red-50 text-red-700 ring-1 ring-inset ring-red-200',
  'zu-frueh':             'bg-slate-50 text-slate-700 ring-1 ring-inset ring-slate-200',
};

const prefixes: Record<string, string> = {
  'belegt': '✓ ',
  'falsch': '✗ ',
};

const label = (prefixes[verdict] ?? '') + ((dict as any).verdict?.[verdict] ?? verdict);
const style = styles[verdict] ?? styles['zu-frueh'];
---

<div class="inline-flex max-w-md flex-col gap-2">
  <span class:list={['inline-flex w-fit items-center rounded-full px-2.5 py-1 text-[11px] font-semibold tracking-normal whitespace-nowrap', style]}>
    {label}
  </span>
  {!hideNote && note && <span class="text-sm text-slate-600 leading-relaxed">{note}</span>}
</div>
