---
// Speech bubble with claim text → magnifying glass → verdict pills
// Used on claims detail page and claims index page
---
<svg viewBox="0 0 640 120" class="w-full h-full" fill="none" aria-hidden="true">

  <!-- === SPEECH BUBBLE / CLAIM (left, x 16–190) === -->
  <!-- Bubble outline -->
  <rect x="16" y="14" width="160" height="74" rx="12" stroke="#1e293b" stroke-width="1.4" opacity="0.14"/>
  <!-- Bubble tail -->
  <path d="M 44 88 L 34 104 L 62 88" fill="white" stroke="#1e293b" stroke-width="1.4" opacity="0.12"/>
  <!-- Quote mark indicator -->
  <text x="28" y="36" font-size="18" fill="#0f766e" opacity="0.18" font-family="Georgia, serif">"</text>
  <!-- Claim text lines -->
  <line x1="48" y1="32" x2="162" y2="32" stroke="#1e293b" stroke-width="1.8" stroke-linecap="round" opacity="0.14"/>
  <line x1="28" y1="46" x2="162" y2="46" stroke="#1e293b" stroke-width="1.3" stroke-linecap="round" opacity="0.1"/>
  <line x1="28" y1="58" x2="150" y2="58" stroke="#1e293b" stroke-width="1.3" stroke-linecap="round" opacity="0.1"/>
  <line x1="28" y1="70" x2="140" y2="70" stroke="#1e293b" stroke-width="1.3" stroke-linecap="round" opacity="0.08"/>
  <!-- End quote -->
  <text x="148" y="82" font-size="18" fill="#0f766e" opacity="0.16" font-family="Georgia, serif">"</text>

  <!-- === ARROW + MAGNIFYING GLASS (center, x 210–420) === -->
  <!-- Flow arrow -->
  <path d="M 198 60 L 226 60" stroke="#0f766e" stroke-width="1.6" stroke-linecap="round" opacity="0.22"/>
  <path d="M 218 54 L 226 60 L 218 66" stroke="#0f766e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.22"/>

  <!-- Magnifying glass circle -->
  <circle cx="286" cy="56" r="30" stroke="#0f766e" stroke-width="1.6" opacity="0.2"/>
  <circle cx="286" cy="56" r="20" stroke="#0f766e" stroke-width="1.2" opacity="0.14"/>
  <!-- Handle -->
  <line x1="308" y1="78" x2="326" y2="96" stroke="#0f766e" stroke-width="3" stroke-linecap="round" opacity="0.22"/>
  <!-- Inner text/evidence lines inside lens -->
  <line x1="270" y1="48" x2="302" y2="48" stroke="#1e293b" stroke-width="1.2" stroke-linecap="round" opacity="0.12"/>
  <line x1="270" y1="56" x2="302" y2="56" stroke="#0f766e" stroke-width="2" stroke-linecap="round" opacity="0.18"/>
  <line x1="270" y1="64" x2="298" y2="64" stroke="#1e293b" stroke-width="1.2" stroke-linecap="round" opacity="0.1"/>
  <!-- Search highlight glow area -->
  <rect x="268" y="52" width="36" height="8" rx="4" fill="#0f766e" opacity="0.06"/>

  <!-- EFSA / Study check circle badge -->
  <circle cx="356" cy="40" r="14" stroke="#14b8a6" stroke-width="1.4" opacity="0.2"/>
  <path d="M 348 40 l 4 4 8-10" stroke="#14b8a6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.3"/>

  <!-- Second arrow -->
  <path d="M 340 60 L 368 60" stroke="#0f766e" stroke-width="1.6" stroke-linecap="round" opacity="0.2"/>
  <path d="M 360 54 L 368 60 L 360 66" stroke="#0f766e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.2"/>

  <!-- === VERDICT PILLS (right, x 390–624) === -->
  <!-- Green / belegt -->
  <rect x="388" y="18" width="110" height="26" rx="13" fill="#dcfce7" stroke="#16a34a" stroke-width="1.2" opacity="0.7"/>
  <circle cx="406" cy="31" r="7" fill="#16a34a" opacity="0.18"/>
  <path d="M 402 31 l 3 3 5-6" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
  <rect x="418" y="25" width="68" height="6" rx="3" fill="#166534" opacity="0.14"/>
  <rect x="418" y="33" width="48" height="4" rx="2" fill="#166534" opacity="0.08"/>

  <!-- Amber / teilweise -->
  <rect x="404" y="52" width="110" height="26" rx="13" fill="#fef3c7" stroke="#d97706" stroke-width="1.2" opacity="0.7"/>
  <circle cx="422" cy="65" r="7" fill="#d97706" opacity="0.18"/>
  <line x1="422" y1="61" x2="422" y2="66" stroke="#92400e" stroke-width="2" stroke-linecap="round" opacity="0.4"/>
  <circle cx="422" cy="69" r="1.5" fill="#92400e" opacity="0.4"/>
  <rect x="434" y="59" width="68" height="6" rx="3" fill="#92400e" opacity="0.12"/>
  <rect x="434" y="67" width="50" height="4" rx="2" fill="#92400e" opacity="0.08"/>

  <!-- Red / nicht belegt -->
  <rect x="420" y="86" width="110" height="26" rx="13" fill="#fee2e2" stroke="#dc2626" stroke-width="1.2" opacity="0.7"/>
  <circle cx="438" cy="99" r="7" fill="#dc2626" opacity="0.16"/>
  <path d="M 434 95 l 8 8 M 442 95 l -8 8" stroke="#991b1b" stroke-width="1.8" stroke-linecap="round" opacity="0.4"/>
  <rect x="450" y="93" width="68" height="6" rx="3" fill="#991b1b" opacity="0.12"/>
  <rect x="450" y="101" width="52" height="4" rx="2" fill="#991b1b" opacity="0.08"/>

  <!-- === SEPARATOR DOTS === -->
  <circle cx="192" cy="60" r="2" fill="#1e293b" opacity="0.08"/>
  <circle cx="192" cy="52" r="2" fill="#1e293b" opacity="0.06"/>
  <circle cx="192" cy="68" r="2" fill="#1e293b" opacity="0.06"/>
</svg>
