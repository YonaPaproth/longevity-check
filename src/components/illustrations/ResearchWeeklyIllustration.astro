---
// Small calendar-page + magnifying glass + sparkle — for research review list entries
---
<svg viewBox="0 0 64 64" class="w-full h-full" fill="none" aria-hidden="true">
  <!-- Calendar page -->
  <rect x="8" y="12" width="36" height="42" rx="5" fill="white" stroke="#0f766e" stroke-width="1.4" opacity="0.25"/>
  <!-- Calendar header bar -->
  <rect x="8" y="12" width="36" height="10" rx="5" fill="#0f766e" opacity="0.12"/>
  <!-- Calendar dots (days) -->
  <circle cx="17" cy="30" r="2" fill="#0f766e" opacity="0.18"/>
  <circle cx="26" cy="30" r="2" fill="#14b8a6" opacity="0.22"/>
  <circle cx="35" cy="30" r="2" fill="#0f766e" opacity="0.14"/>
  <circle cx="17" cy="38" r="2" fill="#1e293b" opacity="0.1"/>
  <circle cx="26" cy="38" r="2.5" fill="#0f766e" opacity="0.3"/>
  <circle cx="35" cy="38" r="2" fill="#1e293b" opacity="0.1"/>
  <circle cx="17" cy="46" r="2" fill="#1e293b" opacity="0.08"/>
  <circle cx="26" cy="46" r="2" fill="#14b8a6" opacity="0.15"/>
  <circle cx="35" cy="46" r="2" fill="#1e293b" opacity="0.08"/>

  <!-- Magnifying glass -->
  <circle cx="48" cy="38" r="10" stroke="#0f766e" stroke-width="1.5" opacity="0.2"/>
  <line x1="55" y1="45" x2="60" y2="52" stroke="#0f766e" stroke-width="2" stroke-linecap="round" opacity="0.2"/>
  <!-- Lens highlight -->
  <path d="M43 34 Q45 31 48 33" stroke="#14b8a6" stroke-width="1" opacity="0.2" fill="none"/>

  <!-- Sparkle top-right -->
  <path d="M54 10 L55 14 L58 12 L55 15 L58 16 L55 16 L54 20 L53 16 L50 16 L53 15 L50 12 L53 14 Z" fill="#14b8a6" opacity="0.2"/>

  <!-- Small bar chart in lens -->
  <rect x="44" y="38" width="2.5" height="5" rx="1" fill="#0f766e" opacity="0.2"/>
  <rect x="47.5" y="35" width="2.5" height="8" rx="1" fill="#14b8a6" opacity="0.25"/>
  <rect x="51" y="37" width="2.5" height="6" rx="1" fill="#0f766e" opacity="0.18"/>
</svg>
