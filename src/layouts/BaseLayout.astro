---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Evidenzbasierte Bewertungen von Longevity-Supplements – kostenlos, auf Deutsch.' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | MikroScore</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={`${title} | MikroScore`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body class="min-h-screen flex flex-col">

  <!-- Header -->
  <header class="border-b border-slate-200 bg-white sticky top-0 z-10">
    <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
      <a href="/" class="font-bold text-lg text-slate-900 no-underline hover:text-teal-700">
        Mikro<span class="text-teal-600">Score</span>
      </a>
      <nav class="flex gap-6 text-sm items-center">
        <a href="/ernaehrungs-check" class="text-slate-600 hover:text-teal-700 no-underline">Ernährungs-Check</a>
        <a href="/wirkstoffe" class="text-slate-600 hover:text-teal-700 no-underline">Wirkstoffe</a>
        <a href="/produkte" class="inline-flex items-center gap-1.5 text-slate-600 hover:text-teal-700 no-underline">
          Produkte
          <span class="text-xs bg-amber-100 text-amber-700 rounded-full px-2 py-0.5 font-medium">im Aufbau</span>
        </a>
        <a href="/methodik" class="text-slate-600 hover:text-teal-700 no-underline">Methodik</a>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200 bg-white mt-16">
    <div class="max-w-5xl mx-auto px-4 py-8 text-sm text-slate-500">
      <div class="flex flex-wrap gap-6 justify-between items-start">
        <div>
          <p class="font-medium text-slate-700 mb-1">MikroScore</p>
          <p>Evidenzbasierte Supplement-Bewertungen. Kostenlos.</p>
        </div>
        <div class="flex gap-6">
          <a href="/methodik" class="hover:text-teal-700">Methodik</a>
          <a href="/impressum" class="hover:text-teal-700">Impressum</a>
          <a href="/datenschutz" class="hover:text-teal-700">Datenschutz</a>
        </div>
      </div>
      <p class="mt-6 text-xs text-slate-400">
        Inhalte ersetzen keine medizinische Beratung.
      </p>
    </div>
  </footer>

</body>
</html>
